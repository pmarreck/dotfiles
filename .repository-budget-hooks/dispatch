#!/usr/bin/env bash
# Per-invocation adapter; retain the selected repository's original hook chain.
set -u
hook=${0##*/}
root=$(cd -P -- "$(dirname "$0")/.." && pwd) || exit 2
delegate=${GIT_REPOSITORY_BUDGET_DELEGATE:?Missing original Git hook directory}
target="$delegate/$hook"
if [[ -e $target && $target -ef $0 ]]; then
	printf 'Repository budget: recursive hook delegation.\n' >&2; exit 2
fi
# Remove only our temporary hook selection, preserving caller-provided -c
# settings. Nested Git commands and tests must see the original configuration.
restored=$("$root/bin/git-repository-budget" --restore-hook-config "$root/.repository-budget-hooks") || exit 2
if [[ -n $restored ]]; then export GIT_CONFIG_PARAMETERS="$restored"; else unset GIT_CONFIG_PARAMETERS; fi
unset GIT_REPOSITORY_BUDGET_DELEGATE
if [[ $hook != reference-transaction ]]; then
	if [[ -x $target && ! -d $target ]]; then exec "$target" "$@"; fi
	exit 0
fi
umask 077
work=$(mktemp -d "${TMPDIR:-/tmp}/git-reference-budget.XXXXXXXX") || exit 2
trap 'command rm -rf -- "$work"' EXIT
cat > "$work/input" || exit 2
"$root/bin/git-repository-budget" --reference "$@" < "$work/input" || exit "$?"
if [[ -x $target && ! -d $target ]]; then GIT_REPOSITORY_BUDGET_CHECKED_PARENT=$$ "$target" "$@" < "$work/input"; exit "$?"; fi
exit 0
