#!/usr/bin/env bash

# Declare an array of strings
declare -a dotfiles=(
    .aliases
    .ansiweatherrc
    .bash_profile
    .bashrc
    .commandpromptconfig
    .direnvrc
    .envconfig
    .envrc
    .esrc
    .gemrc
    .gitconfig
    .gitconfig.old-possibly-useful
    .gitignore
    .inputrc
    .netrc.gpg
    # .npmrc is NOT here on purpose — see renamed_dotfiles below.
    .pathconfig
    .pre-oh-my-bash.bashrc
    .profile
    .secrets.gpg
    .shellenv
    .tool-versions
    .wezterm.lua
)
echo "List of dotfiles to install:"
echo "${dotfiles[@]}"

# Get the directory of this script and cd to it
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
pushd $DIR

declare -a scriptfiles=$(ls -d Scripts/*)
echo "List of script files to install:"
echo "${scriptfiles[@]}"

popd # $DIR

pushd $HOME
# symlink the bin and lib directories
ln -sfv dotfiles/bin # this assumes your dotfiles repo is in $HOME
ln -sfv dotfiles/lib

# symlink the dotfiles
for dotfile in ${dotfiles[@]}; do
    if [[ ! -L $dotfile ]]; then
        if [ -f "$dotfile" ]; then
            echo "$dotfile already exists; renaming to $dotfile.old"
            mv -v "$dotfile" "$dotfile.old"
        fi
    fi
    ln -sfv "dotfiles/$dotfile"
done

# Files that must be installed under a DIFFERENT name than they carry in the
# repo, keyed repo-name -> installed-name.
#
# npm looks for a file named exactly `.npmrc`, walking UP from the current
# directory. A tracked `.npmrc` at the repo root therefore becomes the PROJECT
# config for this very repo, and npm 11 rejects `prefix` in a project config —
# so every npm command run from anywhere inside ~/dotfiles failed with
# "config prefix cannot be changed from project config", while npm worked fine
# one directory up. The symlink-into-$HOME install method is not the problem;
# the collision is that one file was serving as user config and project config
# at once. Keeping the repo-side name dotless makes it invisible to npm while
# still being the source for ~/.npmrc.
declare -A renamed_dotfiles=(
    [npmrc]=.npmrc
)

for renamed_src in "${!renamed_dotfiles[@]}"; do
    renamed_dest="${renamed_dotfiles[$renamed_src]}"
    if [[ ! -L $renamed_dest ]] && [ -f "$renamed_dest" ]; then
        echo "$renamed_dest already exists; renaming to $renamed_dest.old"
        mv -v "$renamed_dest" "$renamed_dest.old"
    fi
    ln -sfv "dotfiles/$renamed_src" "$renamed_dest"
done

# make a Scripts directory if it doesn't exist
mkdir -p ~/Scripts

# symlink the script files
for scriptfile in ${scriptfiles[@]}; do
    if [[ ! -L $scriptfile ]]; then
        if [ -f "$scriptfile" ]; then
            echo "$scriptfile already exists; renaming to $scriptfile.old"
            mv -v "$scriptfile" "$scriptfile.old"
        fi
    fi
    echo "Linking $scriptfile"
    ln -sfv dotfiles/$scriptfile $scriptfile
done

popd # $HOME

echo
echo "note: Library/Application Support and Library/Services are not installed by default"
echo "since they are macOS-only, please install manually."
echo "Don't forget to decrypt the .gpg files using 'decrypt filename.gpg > filename'!"
