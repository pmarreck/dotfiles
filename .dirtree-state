# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
default=closed

depth=3

open=[
	bin
]

close=[
	bin/src
	bin/test
]

hide=[
	.git
	.gitconfig.old-possibly-useful
	.netrc.gpg
	.secrets
	.secrets.gpg
	Library
	of_historical_note
]

annotate=[
	RULES.md = Durable dotfiles policy decisions, including the explicit decision not to add i18n to personal helper commands.
	bin/base85 = LuaJIT base85 encode/decode (Z85/ZeroMQ default, Adobe ASCII85 via -A); stdin only, --encode/--decode/auto-detect alphabet+direction; Z85 arbitrary-length via BLIP-pad wrapper (-p/-P to force/disable)
	bin/checksite = Poll a URL until response stops matching a down-pattern, then alert (tput bel); --once/--input - for offline testing
	bin/choose_editor = Selects VISUAL/EDITOR/nano while preserving each caller argv element, including paths with spaces
	bin/darktide-patch-mods = Reapplies the Darktide bundle loader patch to the dedicated NVMe Steam installation
	bin/darktide-sync-mods = One-way Windows-to-NVMe Darktide mod sync with injectable paths and inspectable resolved destinations
	bin/datetimestamp = Self-contained LuaJIT FFI clock CLI with selectable precision, local/UTC, and exact Unix-nanosecond output
	bin/datetimestamp-bash = Executable preserved Bash datetimestamp implementation retained during migration
	bin/display_image = terminal image display via kitty/sixel; DISPLAY_IMAGE_FORCE_PROTOCOL env override bypasses detection for non-TTY callers (-p still wins)
	bin/erect-agent-stack = Idempotently creates or joins project tmux sessions, launches agent backends, recognizes current Codex readiness and trust gates, and sends backend-correct pings
	bin/erect-recent-agent-stacks = Restores the newest main Claude or Codex conversation per recently active project directory with dry-run, JSON, and bounded concurrency
	bin/exclude = filter OUT stdin lines matching a ripgrep regex (rg --invert-match wrapper, inverse of include)
	bin/executable-name-underscore-allowlist = Exact grandfathered baseline for legacy underscore-named top-level executables.
	bin/fd = Symlink to the multicall rg/find/fd safety guard; dispatches to real fd after distinguishing its pattern from search roots.
	bin/find = Symlink to the multicall rg/find/fd safety guard; dispatches to real find after checking traversal starting points.
	bin/fleet-status = LuaJIT CLI for local Git loss risk plus cached all-tier fleet drift
	bin/fleet-status-network-worker = Isolated per-repository Tier 3-5 provider worker
	bin/fun_intro = login-shell decoration + capability-bucketed cache; image-pick regen forces DISPLAY_IMAGE_FORCE_PROTOCOL so graphics bytes are captured without a TTY to query
	bin/get-all-git-stati = Scan repeatable roots (default ~/Code) and print each Git working tree's status.
	bin/gpuhogs = Cross-platform GPU-process snapshot: NVIDIA pmon, nvtop AMD/Intel fallback, macOS powermetrics, active/resident classification, and JSON.
	bin/gum-demo = Interactive walkthrough of the gum TUI tool's features
	bin/histogram = Command-output histogram renderer using the extracted in-memory distribution classifier
	bin/include = keep only stdin lines matching a ripgrep regex (rg wrapper, inverse of exclude)
	bin/install-fleet-status-timer = Safely link and enable the nightly systemd user timer without overwriting conflicts.
	bin/install-git-hooks = idempotent, self-verifying installer for the repo's git hooks; backs up unmanaged hooks rather than clobbering them
	bin/kill-steam-proton-pids = Kills Steam/Proton/Wine: TERM, grace, re-enumerate, KILL. --dry-run/-n lists without signalling; refuses pid 0/1/self
	bin/md-section = list markdown headings / extract the section under one (fence-aware, level-aware, derives TOC from headings; LuaJIT)
	bin/nas = cross-platform NAS mount helper (macOS/Linux/NixOS); imperative-default + --persist/--unpersist/--dry-run; idempotent automount config
	bin/nas.ps1 = Windows PowerShell counterpart to bin/nas; SMB (default) or NFS via -Protocol; -DriveLetter -Persist -DryRun -NoOpen -Help
	bin/pre-push-gate = pre-push gate: refuses a push unless the suite gives a VALID pass (test-count floor, skip allowlist, positive success evidence)
	bin/randompassdict = Cryptographic dictionary-passphrase generator with fail-closed OS entropy, exact entropy/count reporting, and strict input filtering
	bin/repeat = Repeat argv commands directly or run one isolated Bash command string per iteration after --
	bin/rg = Multicall rg/find/fd safety guard: CLI-specific parsing gates exact /nix/store and whole-home traversal behind sudo, while recognizing piped/redirected rg stdin as a safe stream; bounded roots remain legal.
	bin/rule30 = rule 30 cellular automaton renderer; ASCII state, glyph substituted at output
	bin/run_test_suite = Deterministic bounded-parallel Bash test runner; measured default is 16 workers
	bin/src/code.bash = sourced shell function: 'code <partial> [--edit]' cd's (or edits) the first ~/Code project matching *partial*/ (case-insensitive, dirs-only, code-point-first via glob -i)
	bin/src/edit.bash = Classifies edit targets and forwards path argument vectors unchanged to choose_editor
	bin/src/histogram_classify.bash = Pure frequency-distribution classifier with ordered numeric/text categories, percentile bands, and skew control
	bin/src/rg_guard_env.bash = Exports rg, find, and fd shell functions so agent-bundled PATH entries cannot bypass the ~/bin multicall safety guard.
	bin/src/session.bash = tmux new-or-rejoin function; session . resolves to the quoted logical current-directory basename
	bin/src/show.bash = show/what implementation: file-vs-url routing, language detection, and pretty-printing for definitions
	bin/src/steam_classify.bash = Pure (comm,exe,argv) classifier for Steam/Proton/Wine processes; no env, no I/O — env is inherited so it identifies nothing
	bin/steam-procs = Enumerates Steam/Proton/Wine processes via /proc (ps fallback), newest-first; excludes self+ancestors and kernel threads; --pids/--explain
	bin/test/ALLOWED_SKIPS = skips the pre-push gate tolerates; anything else printing the loud SKIPPED marker blocks the push
	bin/test/MIN_TEST_COUNT = committed floor for the pre-push gate; a count below this means discovery failed
	bin/test/NOT_HERMETIC = Explicitly reviewed tests excluded from the Nix sandbox, with datetimestamp now admitted
	bin/test/block-attribution_test = tests the global PreToolUse hook that blocks AI authorship trailers (hook at ~/.claude/hooks/block-attribution/)
	bin/test/claude_update_alias_test = Regression test ensuring update_claude targets the PATH-winning npm prefix and narrowly allows Anthropic postinstall.
	bin/test/code_test = tests for the 'code' fuzzy-project-jump function (cd, case-insensitivity, dirs-only, no-match, deterministic first-match, --edit routing, usage)
	bin/test/darktide-patch-mods_test = Test suite for bin/darktide-patch-mods: host-guard, action validation, DTKIT_PATCH_BIN override, cache-hit/fresh-download/download-failure paths via mocked curl+fixture tarball
	bin/test/darktide-sync-mods_test = Test suite for bin/darktide-sync-mods: host-guard matrix, real rsync against temp dirs (idempotency, additive vs --delete), CLI surface
	bin/test/datetimestamp_test = Bash CLI contract for FFI clocks, precision modes, timezone rendering, epoch integers, and Bash fallback
	bin/test/display_image_test = tests DISPLAY_IMAGE_FORCE_PROTOCOL env override (forced kitty/sixel emission, -p precedence, loud unknown-protocol failure)
	bin/test/edit_test = Regression coverage for default/directory edit behavior, quoted spaced paths, multi-file argv, and function-name collisions
	bin/test/erect-agent-stack_test = Deterministic isolated-tmux coverage for lifecycle, backend launch, current Codex readiness, trust handling, and bracketed-paste submission
	bin/test/erect-recent-agent-stacks_test = Set-classifier coverage for recent conversation selection, subagent exclusion, backend precedence, missing and spaced paths, alternate tmux names, JSON, and launcher calls
	bin/test/exclude_test = test suite for bin/exclude (semantics + --help regression guards)
	bin/test/executable-names_test = Set-classifier gate preventing new underscore-named top-level executables.
	bin/test/fixtures/erect-agent-stack/codex = Fake Codex trust and readiness TUI for deterministic agent-stack orchestration tests
	bin/test/fleet-status-architecture_test = Hexagonal dependency, purity, facade, and port-substitution contract
	bin/test/fleet-status-collector_test = Real Git fixture classifier for dirty, orphan, branch, and unknown local states
	bin/test/fleet-status-markdown_test = Peter-approved exact Markdown golden-output assertion.
	bin/test/fleet-status-network_test = Offline provider, parser, deadline, cache, and all-tier health contract
	bin/test/fleet-status-nightly_test = Safe/idempotent nightly unit installation and macOS-documentation tests.
	bin/test/fleet-status-persistence_test = Atomic snapshot rotation, default delta, Markdown, and no-save lifecycle tests.
	bin/test/fleet-status-renderers_test = Exact full/delta/truncation/quiet/canonical JSON renderer assertions.
	bin/test/fun_intro_test = tests for capability-bucketed fun_intro cache (image_capable/image_incapable, hardlink invariant)
	bin/test/get-all-git-stati_test = CLI coverage for root scoping, repeated/spaced roots, help, and status output.
	bin/test/gpuhogs_test = Hermetic Linux NVIDIA/nvtop and macOS powermetrics coverage for gpuhogs collectors, classification, errors, and aggregate hogs membership.
	bin/test/histogram_test = Deterministic CLI and paired distribution-classifier regression set with inherited-FD sample streams
	bin/test/include_test = test suite for bin/include (semantics + --help regression guards)
	bin/test/kill-steam-proton-pids_test = Killing layer with injected enumerator+kill cmd: dry-run signals nothing, normal run does, order, escalation, pid guards
	bin/test/nas_ps1_test = static-content validation for bin/nas.ps1 (no pwsh required locally); checks param block, both protocol branches, safety helpers, mojibake hygiene; opportunistic pwsh parse if available
	bin/test/nas_test = TDD coverage for bin/nas: pure helpers (_nas_fstab_line, _nas_nixos_snippet, _nas_auto_nfs_line), platform override, --help, --dry-run for all three OS branches
	bin/test/npmrc_project_config_test = guards that no repo .npmrc sets prefix, and that npmrc still installs as ~/.npmrc
	bin/test/pathconfig_code_bin_denylist_test = tests that denylisted $CODE project bin dirs never reach PATH, by discovery or inheritance
	bin/test/pathconfig_foreign_path_test = regression tests: .pathconfig must preserve FOREIGN PATH injections (nix shell/develop, direnv) across its ORIG_PATH rebuild; set-based classifier with paired specificity case + e2e that forces on-the-fly nix instantiation of a run-unique derivation and asserts it resolves in the new interactive shell
	bin/test/randompassdict_test = CLI security regressions for uniform dictionary passphrases, exact entropy accounting, literal outputs, and fail-closed arguments
	bin/test/repeat_test = Regression suite for argv repetition, isolated shell pipelines, caller-state isolation, and summed failures
	bin/test/rg_test = Regression suite for rg/find/fd root classification, sudo provenance, whole-home/Nix-store refusal, stdin filtering, and shell-function enforcement.
	bin/test/rule30_test = tests for rule30: row width, determinism, and locale-independence
	bin/test/run_test_suite_test = Runner contract tests covering discovery, failure sums, deterministic order, and worker-count invariance
	bin/test/session_test = Pure mocked-tmux regression suite for attach, switch, argument forwarding, and session . cwd shorthand
	bin/test/shell_startup_test = Shell startup-quadrant test with foreground terminal-safe timeout and bounded forced termination
	bin/test/shell_startup_time_test = Single real tmux/login-shell push-gate smoke with explicit multi-sample benchmark controls
	bin/test/show_test = tests for show: completion loading, language detection, and url-vs-local-path routing
	bin/test/steam-procs_test = Enumeration: hermetic fake /proc for exact set equality, plus live-tier cgroup-disjointness control against the agent fleet
	bin/test/steam_classify_test = Classifier over SETS: 20-item sensitivity + 21-item specificity corpora captured live; proves env and agent .exe paths never match
	bin/test/warhammer_quote_test = Deterministic quote-selector endpoint and current random-range contract regression
	bin/warhammer_quote = YueScript quote picker using the random CLI's inclusive single-range syntax
	bin/warhammer_quote.lua = Checked-in generated Lua form of the Warhammer quote picker
	bin/webserver.awk = Tiny awk-based HTTP file server (via socat), kept in awk as a capability demo
	docs/fleet-status.md = Fleet report usage, architecture, schema semantics, cache safety, and nightly setup
	flake.nix = hermetic Nix check (checks.<system>.test) running the suite in a sandbox with patchShebangs and a fixture HOME
	lib/fleet_status.lua = Thin fleet-status composition root preserving the stable public API
	lib/fleet_status/local_collector.lua = Local Git plumbing adapter producing canonical Tier 1-2 snapshots
	lib/fleet_status/lock_parsers.lua = Pure Git remote and dependency-lock parsing functions
	lib/fleet_status/network.lua = Tier 3-5 orchestration over injected runtime, state, parser, and provider ports
	lib/fleet_status/providers.lua = Deadline-bounded external provider command and response-cache adapter
	lib/fleet_status/renderers.lua = Pure one-line and Markdown fleet report renderers
	lib/fleet_status/runtime.lua = Process, filesystem, clock, and environment host adapter for fleet-status
	lib/fleet_status/state.lua = Canonical JSON, atomic snapshot persistence, and state-lock adapter
	npmrc = npm user config (dotless on purpose: a repo-root .npmrc would be npm's PROJECT config)
	systemd/user/fleet-status.service = Nightly cached all-tier fleet-status systemd user service
	systemd/user/fleet-status.timer = Persistent randomized 03:15 systemd user schedule for fleet-status.
]
