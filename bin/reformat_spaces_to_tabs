#!/usr/bin/env luajit

local ffi = require('ffi')

ffi.cdef([[
	int getpid(void);
	int mkstemp(char *template_name);
	int close(int file_descriptor);
	int unlink(const char *path);
]])

local script_path = arg[0]
local script_name = script_path:match('([^/]+)$') or script_path
local script_dir = script_path:match('^(.*)/[^/]+$') or '.'
local backup_root = '/tmp/rstt' .. tonumber(ffi.C.getpid())

local function usage(output)
	output:write(string.format([[
Usage: %s [options] file1 [file2 ...]

Convert consistent leading spaces in files to tabs.

OPTIONS:
	-h, --help      Show this help information
	--test          Run the test suite (silent on success)
	-i, --in-place  Modify files in place instead of writing to stdout
]], script_name))
end

local function shell_quote(value)
	return "'" .. value:gsub("'", "'\\''") .. "'"
end

local function command_status(command)
	local wait_status = os.execute(command)
	if wait_status == nil then
		return 1
	end
	return math.floor(wait_status / 256)
end

local function command_succeeds(command)
	return command_status(command) == 0
end

local function is_regular_file(path)
	return command_succeeds('[ -f ' .. shell_quote(path) .. ' ]')
end

local function path_exists(path)
	return command_succeeds('[ -e ' .. shell_quote(path) .. ' ]')
end

local function is_text_file(path)
	if command_succeeds('[ ! -s ' .. shell_quote(path) .. ' ]') then
		return true
	end

	local command = 'file -b --mime-type -- ' .. shell_quote(path)
		.. " | grep -Eq '^(text/|application/([^/]+[+])?(json|xml)$)'"
	return command_succeeds(command)
end

local function close_file(handle)
	local closed, close_error = handle:close()
	if not closed then
		return nil, close_error
	end
	return true
end

local function write_bytes(handle, bytes)
	local written, write_error = handle:write(bytes)
	if written == nil then
		return nil, write_error
	end
	return true
end

local function copy_file_to_handle(path, output)
	local input, open_error = io.open(path, 'rb')
	if input == nil then
		return nil, open_error
	end

	while true do
		local chunk, read_error = input:read(64 * 1024)
		if chunk == nil then
			if read_error ~= nil then
				input:close()
				return nil, read_error
			end
			break
		end
		local written, write_error = write_bytes(output, chunk)
		if not written then
			input:close()
			return nil, write_error
		end
	end

	return close_file(input)
end

local function create_unique_file(path_template)
	local template = ffi.new('char[?]', #path_template + 1)
	ffi.copy(template, path_template)
	local file_descriptor = ffi.C.mkstemp(template)
	if file_descriptor < 0 then
		return nil, 'could not create a unique temporary file'
	end
	local path = ffi.string(template)
	if ffi.C.close(file_descriptor) ~= 0 then
		ffi.C.unlink(path)
		return nil, 'could not close the unique temporary file'
	end
	return path
end

local function remove_created_file(path)
	if path ~= nil then
		ffi.C.unlink(path)
	end
end

local function open_output(path)
	local handle, open_error = io.open(path, 'wb')
	if handle == nil then
		return nil, open_error
	end
	return handle
end

local function leading_byte_count(record, byte)
	local count = 0
	while record:byte(count + 1) == byte do
		count = count + 1
	end
	return count
end

local function ranked_widths(counts)
	local widths = {}
	for width in pairs(counts) do
		widths[#widths + 1] = width
	end
	table.sort(widths, function(left, right)
		if counts[left] == counts[right] then
			return left < right
		end
		return counts[left] > counts[right]
	end)
	return widths
end

local function is_whitespace_only(record)
	return record:match('^[ \t]*\r?$') ~= nil
end

local function observe_record(sample, record)
	if is_whitespace_only(record) then
		return
	end

	local tab_count = leading_byte_count(record, 9)
	local space_start = tab_count + 1
	local space_count = 0
	while record:byte(space_start + space_count) == 32 do
		space_count = space_count + 1
	end

	if tab_count > 0 then
		sample.tabbed_lines = sample.tabbed_lines + 1
	end
	if space_count > 0 then
		sample.spaced_lines = sample.spaced_lines + 1
		sample.space_indents[space_count] =
			(sample.space_indents[space_count] or 0) + 1
	end
end

local function infer_tab_width(sample)
	if sample.tabbed_lines > sample.spaced_lines then
		return 0
	end

	local widths = ranked_widths(sample.space_indents)
	if #widths == 0 then
		return 0
	end

	for divisor = 8, 2, -1 do
		local divides_all = true
		for index = 1, math.min(3, #widths) do
			if widths[index] % divisor ~= 0 then
				divides_all = false
				break
			end
		end
		if divides_all then
			return divisor
		end
	end

	return 0
end

local function determine_tab_size_in_spaces(path)
	local input, open_error = io.open(path, 'rb')
	if input == nil then
		return nil, open_error
	end

	local sample = {
		space_indents = {},
		spaced_lines = 0,
		tabbed_lines = 0,
	}
	while true do
		local record, read_error = input:read('*l')
		if record == nil then
			if read_error ~= nil then
				input:close()
				return nil, read_error
			end
			break
		end
		observe_record(sample, record)
	end

	local closed, close_error = close_file(input)
	if not closed then
		return nil, close_error
	end
	return infer_tab_width(sample)
end

local function rewrite_record(record, indent_width)
	if is_whitespace_only(record) then
		return record
	end

	local tab_count = leading_byte_count(record, 9)
	local space_start = tab_count + 1
	local space_count = 0
	while record:byte(space_start + space_count) == 32 do
		space_count = space_count + 1
	end

	local replacement_count = math.floor(space_count / indent_width)
	if replacement_count == 0 then
		return record
	end

	local remainder = space_count % indent_width
	local unchanged_start = space_start + space_count
	return string.rep('\t', tab_count + replacement_count)
		.. string.rep(' ', remainder)
		.. record:sub(unchanged_start)
end

local function stream_rewritten_file(path, output, indent_width)
	local input, open_error = io.open(path, 'rb')
	if input == nil then
		return nil, open_error
	end

	while true do
		local record, read_error = input:read('*l')
		if record == nil then
			if read_error ~= nil then
				input:close()
				return nil, read_error
			end
			break
		end
		local written, write_error = write_bytes(
			output,
			rewrite_record(record, indent_width) .. '\n'
		)
		if not written then
			input:close()
			return nil, write_error
		end
	end

	return close_file(input)
end

local function basename(path)
	local without_trailing_slashes = path:gsub('/+$', '')
	return without_trailing_slashes:match('([^/]+)$') or without_trailing_slashes
end

local function dirname(path)
	local directory = path:match('^(.*)/[^/]*$')
	if directory == nil or directory == '' then
		return '.'
	end
	return directory
end

local function resolve_backup_path(path)
	local candidate = backup_root .. '/' .. basename(path) .. '.maybe-no-tabs'
	local suffix = 1
	while path_exists(candidate) do
		candidate = backup_root .. '/' .. basename(path)
			.. '.maybe-no-tabs.' .. suffix
		suffix = suffix + 1
	end
	return candidate
end

local function copy_preserving_metadata(source, destination)
	local command = 'cp -p -- ' .. shell_quote(source) .. ' ' .. shell_quote(destination)
	return command_succeeds(command)
end

local function process_file(path, in_place)
	if not is_text_file(path) then
		io.stderr:write('Warning: Not a text file: ', path, '\n')
		return 1
	end

	local indent_width, read_error = determine_tab_size_in_spaces(path)
	if indent_width == nil then
		io.stderr:write('Error: Could not read ', path, ': ', read_error, '\n')
		return 1
	end

	if indent_width <= 0 then
		if in_place then
			io.stderr:write('No changes needed for: ', path, '\n')
		else
			local copied, copy_error = copy_file_to_handle(path, io.stdout)
			if not copied then
				io.stderr:write('Error: Could not read ', path, ': ', copy_error, '\n')
				return 1
			end
		end
		return 0
	end

	if not in_place then
		local streamed, stream_error =
			stream_rewritten_file(path, io.stdout, indent_width)
		if not streamed then
			io.stderr:write('Error: Could not convert ', path, ': ', stream_error, '\n')
			return 1
		end
		return 0
	end

	if not command_succeeds('mkdir -p ' .. shell_quote(backup_root)) then
		return 1
	end

	local backup_path = resolve_backup_path(path)
	if not command_succeeds('mkdir -p ' .. shell_quote(dirname(backup_path))) then
		return 1
	end
	if not copy_preserving_metadata(path, backup_path) then
		return 1
	end
	io.stderr:write('Backup stored for ', path, ' at ', backup_path, '\n')

	local replacement_path, create_error = create_unique_file(path .. '.tmp.XXXXXX')
	if replacement_path == nil then
		io.stderr:write(
			'Error: Could not prepare replacement for ', path, ': ', create_error, '\n'
		)
		return 1
	end
	if not copy_preserving_metadata(path, replacement_path) then
		remove_created_file(replacement_path)
		return 1
	end

	local replacement, open_error = open_output(replacement_path)
	if replacement == nil then
		remove_created_file(replacement_path)
		io.stderr:write(
			'Error: Could not write ', replacement_path, ': ', open_error, '\n'
		)
		return 1
	end

	local streamed, stream_error =
		stream_rewritten_file(path, replacement, indent_width)
	local closed, close_error = close_file(replacement)
	if not streamed or not closed then
		remove_created_file(replacement_path)
		io.stderr:write(
			'Error: Could not write ', replacement_path, ': ',
			stream_error or close_error, '\n'
		)
		return 1
	end

	local renamed, rename_error = os.rename(replacement_path, path)
	if not renamed then
		remove_created_file(replacement_path)
		io.stderr:write('Error: Could not replace ', path, ': ', rename_error, '\n')
		return 1
	end

	io.stdout:write(
		'Reformatted: ', path, ' (indent size: ', indent_width, ')\n'
	)
	return 0
end

local function run_tests()
	local test_script = script_dir .. '/test/' .. script_name .. '_test'
	if not command_succeeds('[ -x ' .. shell_quote(test_script) .. ' ]') then
		io.stderr:write('Test script not found: ', test_script, '\n')
		return 1
	end

	local command = 'RSTT_RUNNING_SUITE=1 ' .. shell_quote(test_script)
		.. ' >/dev/null'
	return command_status(command)
end

local function reformat_spaces_to_tabs(arguments)
	local in_place = false
	local files = {}
	local index = 1

	while index <= #arguments do
		local argument = arguments[index]
		if argument == '-h' or argument == '--help' then
			usage(io.stdout)
			return 0
		elseif argument == '--test' then
			if index ~= #arguments then
				io.stderr:write(
					'Error: --test does not accept additional arguments\n'
				)
				return 1
			end
			return run_tests()
		elseif argument == '-i' or argument == '--in-place' then
			in_place = true
		elseif argument == '--' then
			for remaining = index + 1, #arguments do
				files[#files + 1] = arguments[remaining]
			end
			break
		elseif argument:sub(1, 1) == '-' then
			io.stderr:write('Error: Unknown option ', argument, '\n')
			usage(io.stderr)
			return 1
		else
			files[#files + 1] = argument
		end
		index = index + 1
	end

	if #files == 0 then
		io.stderr:write(
			'Usage: ', script_name, ' [options] file1 [file2 ...]\n'
		)
		return 1
	end

	for _, path in ipairs(files) do
		if not is_regular_file(path) then
			io.stderr:write('Warning: File not found: ', path, '\n')
		elseif process_file(path, in_place) ~= 0 then
			return 1
		end
	end

	return 0
end

os.exit(reformat_spaces_to_tabs(arg))
