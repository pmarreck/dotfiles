#!/usr/bin/env luajit
-- just_one_taoup: print one random Tao of Unix Programming line under its section header.
local root = (arg[0]:match("^(.*)/[^/]+$") or ".") .. "/.."
package.path = root .. "/lib/?.lua;" .. package.path
os.exit(require("fun_intro.cli").pick_command("just_one_taoup", arg, root))
