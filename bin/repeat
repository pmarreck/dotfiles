#!/usr/bin/env bash

# Repeat argv commands directly; after --, isolate one Bash command string per iteration.
repeat() {
	[ -n "${EDIT}" ] && unset EDIT && edit_function "${FUNCNAME[0]}" "$BASH_SOURCE" && return
	case "${1:-}" in
		-h|--help)
			printf '%s\n' \
				'Usage: repeat <count> <command> [argument ...]' \
				"       repeat <count> -- 'shell command'" >&2
			return 0
			;;
		*)
			;;
	esac

	local count=$1
	if [ $# -lt 2 ]; then
		echo "Usage: repeat <count> [--] <command>" >&2
		return 1
	fi

	shift
	local shell_command=''
	local shell_mode=false
	local cmd=()
	if [ "${1:-}" = "--" ]; then
		shift
		if [ "$#" -ne 1 ]; then
			echo "Usage: repeat <count> -- 'shell command'" >&2
			return 1
		fi
		shell_command="$1"
		shell_mode=true
	else
		cmd=("$@")
	fi
	local retcodes=0

	for ((i = 0; i < count; i++)); do
		if "$shell_mode"; then
			"$BASH" -c "$shell_command" || ((retcodes+=$?))
		else
			"${cmd[@]}" || ((retcodes+=$?))
		fi
	done

	return $retcodes
}

# Run the function if this script is executed directly
if ! (return 0 2>/dev/null); then
	# Check if we are running tests
	if [ "$1" = "--test" ]; then
		# Source-and-run the test file with stdout muted (CLAUDE.md: --test should be silent on success)
		_test_file="$HOME/dotfiles/bin/test/$(basename "${0##\-}")_test"
		if [ -f "$_test_file" ]; then . "$_test_file" > /dev/null; fi
	else
		# If called directly, pass all arguments to the function
		$(basename "${0##\-}") "$@"
	fi
fi
