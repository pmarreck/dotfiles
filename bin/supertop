#!/usr/bin/env bash

supertop() {
	local dep
	for dep in fork htop btop; do
		if ! command -v "$dep" >/dev/null; then
			printf 'supertop: %s is required.\n' "$dep" >&2
			return 1
		fi
	done
	fork --stack horizontal --title top 'exec htop' 'exec btop'
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	supertop "$@"
fi
