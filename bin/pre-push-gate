#!/usr/bin/env bash

# Pushes verify existing Nix and supplemental host evidence for each outgoing
# tip. They never run tests. The historical --check-only spelling remains as a
# compatibility route to the one complete ./test entry point.

set -u

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

help() {
	cat <<'EOF'
Usage: pre-push-gate [--check-only]

Hook mode verifies cached Nix and supplemental host evidence for every changed
tip read from Git's pre-push input. It never runs tests.

Options:
  --check-only   Compatibility spelling for the unified ./test command
  -h, --help     Show this help
EOF
}

case "$#:${1:-}" in
	0:)
		;;
	1:-h | 1:--help)
		help
		exit 0
		;;
	1:--check-only)
		exec "$repo_root/test"
		;;
	*)
		printf 'pre-push-gate: invalid arguments; use --help.\n' >&2
		exit 2
		;;
esac

if [[ -n "${PRE_PUSH_GATE_SKIP:-}" ]]; then
	printf 'pre-push-gate: there is no silent bypass. Run ./test and fix the evidence.\n' >&2
	exit 1
fi

if [[ -t 0 ]]; then
	printf 'pre-push-gate: supply Git ref input, or explicitly run ./test.\n' >&2
	exit 2
fi

updates=$(cat) || exit 1
[[ -n "$updates" ]] || exit 0
printf '%s\n' "$updates" | "$repo_root/bin/git-push-evidence" || exit "$?"
while read -r _local_ref local_sha _remote_ref remote_sha; do
	case "$local_sha" in *[!0]*) ;; *) continue ;; esac
	[[ "$local_sha" != "$remote_sha" ]] || continue
	"$repo_root/bin/dotfiles-host-evidence" --verify "$repo_root" "$local_sha" || exit "$?"
done <<<"$updates"
