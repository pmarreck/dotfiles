#!/usr/bin/env bash

remove_z_library_attrib() {
	# Keep glob settings local to the command; the caller may have globbing disabled.
	(
		set +f
		shopt -s nullglob
		local source name target prior
		local -a sources=() targets=()
		for source in ./*; do
			name=${source#./}
			case "$name" in
				*' (Z-Library).'* ) target=${name/ (Z-Library)./.} ;;
				*' (z-library.sk, 1lib.sk, z-lib.sk).'* ) target=${name/ (z-library.sk, 1lib.sk, z-lib.sk)./.} ;;
				* ) continue ;;
			esac
			if [[ -e "./$target" || -L "./$target" ]]; then
				printf 'Destination already exists: %s\n' "$target" >&2
				return 1
			fi
			for prior in "${targets[@]}"; do
				if [[ "$prior" == "$target" ]]; then
					printf 'Multiple sources target: %s\n' "$target" >&2
					return 1
				fi
			done
			sources+=("$source")
			targets+=("$target")
		done
		local i
		for ((i=0; i<${#sources[@]}; i++)); do
			mv -n -- "${sources[i]}" "./${targets[i]}" || return
		done
	)
}

# Run the function if this script is executed directly
if ! (return 0 2>/dev/null); then
	# Check if we are running tests
	if [ "$1" = "--test" ]; then
		# Run tests from the test file
		_test_file="$HOME/dotfiles/bin/test/$(basename "${0##\-}")_test"
		if [ -f "$_test_file" ]; then . "$_test_file" > /dev/null; fi
	else
		# If called directly, pass all arguments to the function
		$(basename "${0##\-}") "$@"
	fi
fi
