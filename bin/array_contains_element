#!/usr/bin/env bash

array_contains_element() {
	[ -n "${EDIT:-}" ] && unset EDIT && edit_function "${FUNCNAME[0]}" "$BASH_SOURCE" && return
	# Bash 4.2 has no namerefs, so the named array is copied through eval.
	# Validate the name first so eval can never run caller-supplied code, and
	# keep every working variable local: shells source this function, and a
	# call must leave the caller's variables untouched.
	[[ "${1-}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 2
	local -a __ace_items
	local __ace_item
	eval '__ace_items=("${'"$1"'[@]}")'

	for __ace_item in "${__ace_items[@]}"; do
		[[ "$__ace_item" == "${2-}" ]] && return 0
	done
	return 1
}

# Run the function if this script is executed directly
if ! (return 0 2>/dev/null); then
	# Check if we are running tests
	if [ "$1" = "--test" ]; then
		# Run tests from the test file
		_test_file="$HOME/dotfiles/bin/test/$(basename "${0##\-}")_test"
		if [ -f "$_test_file" ]; then . "$_test_file" > /dev/null; fi
	else
		# If called directly, pass all arguments to the function
		$(basename "${0##\-}") "$@"
	fi
fi
