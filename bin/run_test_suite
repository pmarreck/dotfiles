#!/usr/bin/env bash

_run_test_suite_help() {
	cat <<'EOF'
Usage: run_test_suite [OPTIONS]

Discover and directly execute every *_test file in bin/test. Each test runs in
its own process. The exit status is the sum of failing test exit codes, capped
at 255 because process exit statuses are one byte.

Options:
	-h, --help       Show this help message
	--test           Run the runner's associated tests
	--test-dir DIR   Discover tests in DIR instead of bin/test
	-j, --jobs N     Run N test files concurrently (default 16, or
	                 $RUN_TEST_SUITE_JOBS). Use 1 for serial execution.
	                 Results are always reported in discovery order, so
	                 the report does not depend on the job count.

The compatibility command test_dotfiles invokes this same runner.
EOF
}

run_test_suite() {
	local script_dir
	local repo_root
	local test_dir
	local nullglob_was_set=false
	local noglob_was_set=false
	local test_files=()
	local test_file
	local test_name
	local status
	local summed_status=0
	local passed=0
	local failed=0
	local total
	local index=0
	# Tests are isolated per subprocess, so they parallelize. On the 128-thread
	# Thelio, 16 workers measured 32.96s versus 41.05s at 8 workers for 172 tests.
	# Keep the pool explicitly bounded: using every core made a tmux-dependent test
	# race its own session startup. `--jobs 1` restores fully serial execution.
	local jobs="${RUN_TEST_SUITE_JOBS:-16}"
	# `wait -n` is the pool primitive and needs bash 4.3+. Rather than emit subtly
	# wrong results on an older bash, fall back to serial.
	if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3) )); then
		jobs=1
	fi

	script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
	repo_root="$(dirname "$script_dir")"
	test_dir="$script_dir/test"

	while (( $# > 0 )); do
		case "$1" in
			-h | --help)
				_run_test_suite_help
				return 0
				;;
			--test-dir)
				if (( $# < 2 )); then
					printf 'Error: --test-dir requires a directory.\n' >&2
					return 2
				fi
				test_dir="$2"
				shift 2
				;;
			-j | --jobs)
				if (( $# < 2 )); then
					printf 'Error: --jobs requires a positive integer.\n' >&2
					return 2
				fi
				if [[ ! "$2" =~ ^[1-9][0-9]*$ ]]; then
					printf 'Error: --jobs requires a positive integer, got: %s\n' "$2" >&2
					return 2
				fi
				jobs="$2"
				shift 2
				;;
			*)
				printf 'Error: unknown option: %s\n' "$1" >&2
				_run_test_suite_help >&2
				return 2
				;;
		esac
	done

	if [[ ! -d "$test_dir" ]]; then
		printf 'Error: test directory not found: %s\n' "$test_dir" >&2
		return 2
	fi
	test_dir="$(cd "$test_dir" && pwd -P)"

	shopt -q nullglob && nullglob_was_set=true
	[[ "$-" == *f* ]] && noglob_was_set=true
	set +f
	shopt -s nullglob
	test_files=("$test_dir"/*_test)
	"$nullglob_was_set" || shopt -u nullglob
	"$noglob_was_set" && set -f

	total=${#test_files[@]}
	if (( total == 0 )); then
		printf 'Error: No test files found in %s.\n' "$test_dir" >&2
		return 2
	fi

	printf 'Running %s test files from %s (jobs: %s)\n' "$total" "$test_dir" "$jobs"

	# Execute concurrently into per-test scratch files, then report strictly in
	# discovery order. Letting output interleave by completion order would make the
	# report vary run to run, which is useless for review and for diffing CI logs.
	local work_dir
	work_dir="$(mktemp -d --tmpdir run_test_suite.XXXXXX)" || return 2
	# shellcheck disable=SC2064  # expand now: this must survive the function returning
	trap "rm -rf '$work_dir'" EXIT

	local running=0 slot
	for (( slot = 0; slot < total; slot++ )); do
		while (( running >= jobs )); do
			wait -n 2>/dev/null || :
			(( running-- ))
		done
		(
			local_file="${test_files[$slot]}"
			if [[ ! -x "$local_file" ]]; then
				printf '126' >"$work_dir/$slot.status"
				: >"$work_dir/$slot.out"
			else
				(cd "$repo_root" && "$local_file") >"$work_dir/$slot.out" 2>&1
				printf '%s' "$?" >"$work_dir/$slot.status"
			fi
		) &
		(( running++ ))
	done
	wait

	for (( slot = 0; slot < total; slot++ )); do
		test_file="${test_files[$slot]}"
		(( index++ ))
		test_name="${test_file##*/}"
		printf '\n[%s/%s] %s\n' "$index" "$total" "$test_name"

		status="$(cat "$work_dir/$slot.status" 2>/dev/null)"
		# A missing status file means the worker itself died; treat that as a
		# failure rather than silently counting it as a pass.
		[[ "$status" =~ ^[0-9]+$ ]] || status=125
		cat "$work_dir/$slot.out" 2>/dev/null
		# Several tests end their output without a trailing newline (a bare ANSI
		# reset, typically). Without this the following PASS/FAIL line is glued to
		# that output — `[0mPASS calc_test` — so `grep '^PASS '` silently
		# undercounts, which is precisely the kind of miscount a suite gate keys on.
		if [[ -s "$work_dir/$slot.out" && -n "$(tail -c1 "$work_dir/$slot.out")" ]]; then
			printf '\n'
		fi

		if [[ ! -x "$test_file" ]]; then
			printf 'FAIL %s: test file is not executable (exit %s)\n' "$test_name" "$status" >&2
		fi

		if (( status == 0 )); then
			(( passed++ ))
			printf 'PASS %s\n' "$test_name"
		else
			(( failed++ ))
			(( summed_status += status ))
			if [[ -x "$test_file" ]]; then
				printf 'FAIL %s (exit %s)\n' "$test_name" "$status" >&2
			fi
		fi
	done

	if (( failed == 0 )); then
		printf '\nAll %s test files passed.\n' "$total"
		return 0
	fi

	printf '\n%s of %s test files failed; %s passed; summed exit status: %s.\n' \
		"$failed" "$total" "$passed" "$summed_status" >&2
	if (( summed_status > 255 )); then
		return 255
	fi
	return "$summed_status"
}

if ! (return 0 2>/dev/null); then
	if [[ "${1:-}" == '--test' ]]; then
		if (( $# != 1 )); then
			printf 'Error: --test does not accept arguments.\n' >&2
			exit 2
		fi
		test_file="$(dirname "${BASH_SOURCE[0]}")/test/run_test_suite_test"
		if [[ ! -x "$test_file" ]]; then
			printf 'Error: test file is missing or not executable: %s\n' "$test_file" >&2
			exit 1
		fi
		"$test_file" >/dev/null
		exit $?
	fi
	run_test_suite "$@"
	exit $?
fi
