#!/usr/bin/env bash

# Refresh aliases and environment in the current shell. This file must be
# sourced by shell startup because a child process cannot mutate its parent.
rehash() {
	local had_skip=${SKIP_DOTFILE_TESTS+x}
	local old_skip=${SKIP_DOTFILE_TESTS-}
	local had_test_verbose=${TEST_VERBOSE+x}
	local old_test_verbose=${TEST_VERBOSE-}
	local had_glob_verbose=${GLOB_TEST_VERBOSE+x}
	local old_glob_verbose=${GLOB_TEST_VERBOSE-}
	local had_last_run=${LAST_DOTFILE_RUN+x}
	local old_last_run=${LAST_DOTFILE_RUN-}
	local status=0

	export SKIP_DOTFILE_TESTS=true
	export TEST_VERBOSE=false
	export GLOB_TEST_VERBOSE=false
	unset _SOURCED_FILES

	if [[ -f "$HOME/.pathconfig" ]]; then
		# shellcheck disable=SC1091
		. "$HOME/.pathconfig" || status=$?
	fi
	if [[ $status -eq 0 && -f "$HOME/.envconfig" ]]; then
		# shellcheck disable=SC1091
		. "$HOME/.envconfig" || status=$?
	fi
	if [[ $status -eq 0 && -f "$HOME/.aliases" ]]; then
		# shellcheck disable=SC1091
		. "$HOME/.aliases" || status=$?
	fi

	if [[ -n "$had_skip" ]]; then export SKIP_DOTFILE_TESTS="$old_skip"; else unset SKIP_DOTFILE_TESTS; fi
	if [[ -n "$had_test_verbose" ]]; then export TEST_VERBOSE="$old_test_verbose"; else unset TEST_VERBOSE; fi
	if [[ -n "$had_glob_verbose" ]]; then export GLOB_TEST_VERBOSE="$old_glob_verbose"; else unset GLOB_TEST_VERBOSE; fi
	if [[ -n "$had_last_run" ]]; then export LAST_DOTFILE_RUN="$old_last_run"; else unset LAST_DOTFILE_RUN; fi

	if [[ $status -ne 0 ]]; then
		printf 'rehash: shell refresh failed with status %d\n' "$status" >&2
		return "$status"
	fi
	printf 'Shell environment refreshed without running tests.\n'
}

if ! (return 0 2>/dev/null); then
	case "${1:-}" in
		--test)
			exec "$HOME/dotfiles/bin/test/rehash_test"
			;;
		-h|--help)
			printf 'Usage: source ~/.bashrc; rehash\nRefresh aliases and environment in the current shell.\n'
			exit 0
			;;
		*)
			printf 'rehash: direct execution cannot refresh its parent shell; source ~/.bashrc once, then run rehash\n' >&2
			exit 2
			;;
	esac
fi
