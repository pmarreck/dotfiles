#!/usr/bin/env bash

# install-git-hooks — select this repository's tracked hooks, idempotently.
#
# A hook that silently fails to install is a gate that does not exist, so this
# verifies its own work afterwards and reports failure rather than assuming the
# write succeeded.
#
# This is deliberately NOT part of bin/apply-hooks. That script manages *shell
# prompt* lifecycle — PROMPT_COMMAND, precmd_functions, starship, mcfly, wezterm
# OSC — and shares only the word "hooks". Folding git-lifecycle installation into
# it would merge two unrelated subsystems into the file whose fragility already
# caused mcfly to be silently dropped on every re-source. One installer for git
# hooks is the anti-proliferation rule; putting it in that file is not.
#
# Usage: install-git-hooks [REPO_ROOT]   (defaults to this repository)

set -u

self_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
target="${1:-$self_root}"

case "${1:-}" in
	-h|--help)
		cat <<'EOF'
Usage: install-git-hooks [REPO_ROOT]

Configures REPO_ROOT to use its tracked .githooks directory. Idempotent: safe
to run repeatedly. Verifies the local Git configuration and executable hook.

An existing unmanaged .git/hooks/pre-push is never silently bypassed.
EOF
		exit 0
		;;
esac

if [ ! -d "$target" ]; then
	echo "install-git-hooks: no such directory: $target" >&2
	exit 1
fi

git_dir="$(git -C "$target" rev-parse --git-dir 2>/dev/null)" || {
	echo "install-git-hooks: not a git repository: $target" >&2
	exit 1
}
case "$git_dir" in
	/*) ;;
	*) git_dir="$target/$git_dir" ;;
esac

hooks_dir="$git_dir/hooks"
legacy_hook="$hooks_dir/pre-push"
hook_path="$target/.githooks/pre-push"
marker="# managed-by: dotfiles/bin/install-git-hooks"

if [ ! -f "$hook_path" ] || [ ! -x "$hook_path" ]; then
	echo "install-git-hooks: tracked hook is missing or not executable: $hook_path" >&2
	exit 1
fi
if ! grep -qF 'pre-push-gate' "$hook_path" 2>/dev/null; then
	echo "install-git-hooks: tracked hook does not invoke pre-push-gate: $hook_path" >&2
	exit 1
fi

if [ -e "$legacy_hook" ] && ! grep -qF "$marker" "$legacy_hook" 2>/dev/null; then
	echo "install-git-hooks: refusing to bypass unmanaged legacy hook: $legacy_hook" >&2
	exit 1
fi

configured="$(git -C "$target" config --local --get core.hooksPath 2>/dev/null)"
if [ -n "$configured" ] && [ "$configured" != .githooks ]; then
	echo "install-git-hooks: refusing to replace existing core.hooksPath: $configured" >&2
	exit 1
fi

if ! git -C "$target" config --local core.hooksPath .githooks; then
	echo "install-git-hooks: could not set core.hooksPath for $target" >&2
	exit 1
fi

configured="$(git -C "$target" config --local --get core.hooksPath 2>/dev/null)"
if [ "$configured" != .githooks ]; then
	echo "install-git-hooks: verification failed; core.hooksPath is [$configured]" >&2
	exit 1
fi

echo "install-git-hooks: tracked pre-push gate selected at $hook_path"
exit 0
