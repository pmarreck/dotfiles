#!/usr/bin/env bash
# Inspect complete staged text blobs, not the possibly different working tree.
set -u
if [[ ${ALLOW_GIT_CONFLICT_MARKERS:-} == 1 ]]; then
	printf 'WARNING: conflict-marker gate bypassed by ALLOW_GIT_CONFLICT_MARKERS=1.\n' >&2
	exit 0
fi
root=$(git rev-parse --show-toplevel) || exit 2
cd "$root" || exit 2
# This runs on every commit and `rm` may move files to the Trash, so Git's output is read
# through process substitution, not temporary files. Each producer ends with an empty record
# followed by its exit status; Git never prints an empty path, so the sentinel is unambiguous.
pattern='^((<{7,}|>{7,}|\|{7,})([[:space:]].*)?|={7,}[[:space:]]*)$'
found=0
scan() {
	# Git supplies NUL-framed paths and line numbers; newlines in paths stay safe.
	# Classify ordered marker triples per file, so headings and fragments pass.
	local path line marker previous='' state=0 status=''
	local opening_line='' opening_text='' separator_line='' separator_text=''
	local opening='^<{7,}([[:space:]].*)?$'
	local separator='^={7,}[[:space:]]*$'
	local closing='^>{7,}([[:space:]].*)?$'
	while IFS= read -r -d '' path && IFS= read -r -d '' line && IFS= read -r marker; do
		if [[ -z $path ]]; then status=$marker; break; fi
		if [[ "$path" != "$previous" ]]; then state=0; previous=$path; fi
		if [[ "$marker" =~ $opening ]]; then
			state=1; opening_line=$line; opening_text=$marker
		elif [[ "$marker" =~ $separator ]]; then
			if (( state == 1 )); then
				state=2; separator_line=$line; separator_text=$marker
			fi
		elif [[ "$marker" =~ $closing ]]; then
			if (( state == 2 )); then
				printf '%s:%s:%s\n' "$path" "$opening_line" "$opening_text" \
					"$path" "$separator_line" "$separator_text" "$path" "$line" "$marker" >&2
				found=1
			fi
			state=0
		fi
	done < <(git --literal-pathspecs -c color.grep=false grep --cached -I -n -z -E -e "$pattern" -- "$@"; printf '\0\0%s\n' "$?")
	case $status in
		0 | 1) ;;
		*) printf 'ERROR: could not inspect staged files; commit refused.\n' >&2; exit 2 ;;
	esac
}
# git grep reports "no match" for a staged blob it cannot read (a damaged or incomplete
# object store), which would pass text nobody inspected. Every staged blob must exist.
# A submodule entry (mode 160000) names a commit in another repository and is skipped.
check_blobs() {
	local record mode rest reply listed='' checked=''
	local -a objects=()
	while IFS= read -r -d '' record; do
		if [[ -z $record ]]; then IFS= read -r -d '' listed; break; fi
		mode=${record%% *} rest=${record#* }
		[[ $mode == 160000 ]] || objects+=("${rest%% *}")
	done < <(git --literal-pathspecs ls-files --stage -z -- "$@"; printf '\0%s\0' "$?")
	[[ $listed == 0 ]] || { printf 'ERROR: could not list staged blobs; commit refused.\n' >&2; exit 2; }
	(( ${#objects[@]} )) || return 0
	while IFS= read -r reply; do
		if [[ -z $reply ]]; then IFS= read -r checked; break; fi
		if [[ $reply == *' missing' ]]; then
			printf 'ERROR: staged blob %s cannot be read; commit refused.\n' "${reply%% *}" >&2
			exit 2
		fi
	done < <(printf '%s\n' "${objects[@]}" | git cat-file --batch-check; printf '\n%s\n' "$?")
	[[ $checked == 0 ]] || { printf 'ERROR: could not check staged blobs; commit refused.\n' >&2; exit 2; }
}
batch=() listed=''
while IFS= read -r -d '' path; do
	if [[ -z $path ]]; then IFS= read -r -d '' listed; break; fi
	batch+=("$path")
	if (( ${#batch[@]} == 100 )); then check_blobs "${batch[@]}"; scan "${batch[@]}"; batch=(); fi
done < <(git diff --cached --name-only --diff-filter=ACMRT -z --; printf '\0%s\0' "$?")
[[ $listed == 0 ]] || { printf 'ERROR: could not list staged files; commit refused.\n' >&2; exit 2; }
if (( ${#batch[@]} )); then check_blobs "${batch[@]}"; scan "${batch[@]}"; fi
if (( found )); then
	printf '\nERROR: staged text contains complete Git merge-conflict blocks (file:line above).\nResolve them and stage the fix. For intentional fixtures only, explicitly use:\n  ALLOW_GIT_CONFLICT_MARKERS=1 git commit ...\n' >&2
	exit 1
fi
