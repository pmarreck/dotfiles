#!/usr/bin/env bash
# Interactive startup must not fork helper scripts whose work the current shell
# or its one LuaJIT engine run can answer. Each forked dual-mode helper costs
# roughly 10 ms: an `env bash` PATH walk, a Bash startup, a `basename` exec,
# and a second PATH walk inside the helper.
#
# Oracle: logging stubs placed in a foreign PATH entry. .pathconfig keeps
# foreign entries ahead of its own additions, so any startup code that executes
# one of these names reaches the stub first and leaves a log line. A sourced
# function shadows the stub and logs nothing. Each probe also executes every
# stub once through `command`, which bypasses functions, so a stub that is not
# reachable fails the positive control instead of passing silently.

set -u

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
bash_bin="${BASH:-$(command -v bash)}"
real_uname="$(command -v uname)"
work=$(mktemp -d "${TMPDIR:-/tmp}/shell_startup_exec_budget_test.XXXXXX") || exit 1
trap 'command rm -rf -- "$work"' EXIT
stub_dir="$work/stub-bin"
log="$work/exec.log"
mkdir -p "$stub_dir" || exit 1

# Helpers startup must define in-process as shell functions.
functions=(needs array_contains_element)
# Executions allowed per interactive startup, by name. The macOS and Windows
# branches of .bashrc still read distribution facts through the helpers, and
# macOS also reads `uname -m` for ARCHFLAGS, so those budgets are Linux-only.
declare -A budget=([needs]=0 [array_contains_element]=0 [is_nix_darwin]=0 [distro]=0)
# Terminal graphics facts come from the startup engine, so the Bash probes and
# the tools they ran (infocmp, and ps for one terminal) stay idle.
budget+=([check_sixel_support]=0 [check_kitty_support]=0 [infocmp]=0 [ps]=0)
# GNU tool paths come from the engine's version cache; the old helper piped
# every candidate's --version through head.
budget+=([head]=0)
# exclude_path filters in Bash and TMPDIR comes from the engine. (tty is not
# budgeted: NixOS's own /etc/bashrc runs it for GPG_TTY; the dotfiles take
# the terminal's name from the engine, checked in ghostty_vt_test.)
budget+=([which]=0 [realpath]=0)
if [[ "$("$real_uname" -s)" == Linux ]]; then
	budget[distro_pretty]=0
	budget[distro_version]=0
	budget[check-system-mutations]=0 # a nix-darwin drift check
	budget[uname]=3 # one kernel classification: uname -s, -m, -r
fi

stub() { # <name> <real executable>
	{
		printf '#!/bin/sh\n'
		printf 'printf "%%s\\n" "%s $*" >> %q\n' "$1" "$log"
		printf 'exec %q "$@"\n' "$2"
	} >"$stub_dir/$1"
	chmod +x "$stub_dir/$1"
}
for name in "${!budget[@]}"; do
	if [[ "$name" == uname ]]; then
		stub uname "$real_uname"
	elif [[ -x "$repo_root/bin/$name" ]]; then
		stub "$name" "$repo_root/bin/$name"
	elif system_tool=$(command -v "$name"); then
		stub "$name" "$system_tool"
	else
		printf 'FAIL: helper %s is missing from %s/bin\n' "$name" "$repo_root" >&2
		exit 1
	fi
done

# Prompt hook tools present on this host. A warm startup evaluates their
# cached init scripts (lib/shell_startup/hook_init.lua) instead of running
# `direnv hook bash`, `mcfly init bash`, or `starship init bash`. Starship's
# init script itself runs `starship time` and `starship prompt`, so only init
# runs are counted for these.
hook_tools=()
for name in direnv mcfly starship; do
	if system_tool=$(command -v "$name"); then
		stub "$name" "$system_tool"
		hook_tools+=("$name")
	else
		printf 'NOTE: %s is not installed here; its init cache is not exercised\n' "$name"
	fi
done

# An SSH-like pristine base. ORIG_PATH is pinned to the base so the stub
# directory classifies as a foreign injection and stays at the front.
base_path="/run/current-system/sw/bin:/usr/bin:/bin"
[[ -d /run/current-system/sw/bin ]] || base_path="/usr/bin:/bin:/usr/sbin:/sbin"
me="$(id -un)"

# The probe runs after startup. It first marks the log, so startup executions
# can be told apart from its own (the distro helpers run uname themselves),
# reports function kinds, then executes each stub once through `command` as
# the positive control.
probe_marker='--- probe ---'
# shellcheck disable=SC2016 # The child shell expands the probe.
probe='printf "%s\n" "$BUDGET_PROBE_MARKER" >> "$BUDGET_LOG"
printf "kinds=%s,%s\n" "$(type -t needs)" "$(type -t array_contains_element)"'
for name in "${!budget[@]}" "${hook_tools[@]}"; do
	probe+="; command $name probe-control >/dev/null 2>&1"
done
# Where a host binary shadows a hook stub (macOS login shells put
# /usr/local/bin first), report what the shell runs, what the engine's cache
# entry names, and whether PATH is still the one the engine searched.
for name in "${hook_tools[@]}"; do
	probe+="; printf 'hook-$name=%s|%s|%s\\n' \"\$(type -P $name)\" \"\${SHELL_STARTUP_HOOK_${name^^}_BIN-}\" \"\$([[ \$PATH == \${SHELL_STARTUP_HOOK_PATH-} ]] && echo same)\""
done

tests=0
fails=0
pass() { printf 'PASS: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1" >&2; ((fails++)) || :; }

run_quadrant() {
	local label=$1 out name count startup_log="$work/startup.log" probe_log="$work/probe.log"
	shift
	: >"$log"
	# --foreground keeps interactive Bash in the terminal's process group
	# under a concurrent runner; the deadline bounds a hung regression.
	# NixOS /etc/profile and nix-darwin /etc/bashrc replace PATH unless the session environment is
	# already applied, as it is for a shell started inside a desktop session.
	out=$(timeout --foreground --kill-after=5 20 env -i \
		HOME="$HOME" USER="$me" LOGNAME="$me" TERM=xterm SHELL="$bash_bin" XDG_CACHE_HOME="$work/cache" \
		PATH="$stub_dir:$base_path" ORIG_PATH="$base_path" \
		__NIXOS_SET_ENVIRONMENT_DONE=1 __NIX_DARWIN_SET_ENVIRONMENT_DONE=1 SHELL_STARTUP_BENCHMARK=1 \
		BUDGET_LOG="$log" BUDGET_PROBE_MARKER="$probe_marker" \
		"$bash_bin" "$@" -c "$probe" 2>/dev/null)
	sed "/^$probe_marker\$/,\$d" "$log" >"$startup_log"
	sed -n "/^$probe_marker\$/,\$p" "$log" >"$probe_log"

	((tests++))
	if [[ -s "$probe_log" && "$out" == *"kinds=function,function"* ]]; then
		pass "$label: ${functions[*]} are shell functions"
	else
		fail "$label: expected shell functions, probe said: ${out:-<no output>}"
	fi

	for name in "${!budget[@]}"; do
		((tests++))
		if ! grep -qx "$name probe-control" "$probe_log"; then
			fail "$label: positive control did not reach the $name stub; the oracle is blind"
			continue
		fi
		count=$(grep -c "^$name " "$startup_log")
		if ((count <= budget[$name])); then
			pass "$label: startup executed $name $count time(s) (budget ${budget[$name]})"
		else
			fail "$label: startup executed $name $count time(s); budget is ${budget[$name]}:"
			grep "^$name " "$startup_log" | sed 's/^/    /' >&2
		fi
	done

	for name in "${hook_tools[@]}"; do
		((tests++))
		if ! grep -qx "$name probe-control" "$probe_log"; then
			local seen
			seen=$(sed -n "s/^hook-$name=//p" <<<"$out")
			IFS='|' read -r resolved named same <<<"$seen"
			if [[ -n "$resolved" && "$resolved" != "$stub_dir/$name" && "$resolved" == "$named" && "$same" == same ]]; then
				pass "$label: $name is $resolved here, ahead of the stub; the engine's cache entry names that binary and PATH is unchanged"
			else
				fail "$label: positive control did not reach the $name stub; the oracle is blind (shell runs '${resolved:-?}', cache names '${named:-?}', PATH ${same:-changed})"
			fi
			continue
		fi
		count=$(grep -c -E "^$name (hook|init) " "$startup_log")
		if ((count == 0)); then
			pass "$label: startup evaluated the cached $name init script without running $name for it"
		else
			fail "$label: startup ran $name for its init script $count time(s):"
			grep -E "^$name (hook|init) " "$startup_log" | sed 's/^/    /' >&2
		fi
	done
}

# One startup fills the hook init cache, as the first shell after an upgrade
# does; the quadrants below then measure warm startups.
timeout --foreground --kill-after=5 20 env -i \
	HOME="$HOME" USER="$me" LOGNAME="$me" TERM=xterm SHELL="$bash_bin" XDG_CACHE_HOME="$work/cache" \
	PATH="$stub_dir:$base_path" ORIG_PATH="$base_path" \
	__NIXOS_SET_ENVIRONMENT_DONE=1 __NIX_DARWIN_SET_ENVIRONMENT_DONE=1 SHELL_STARTUP_BENCHMARK=1 \
	BUDGET_LOG="$log" "$bash_bin" -i -c : >/dev/null 2>&1
if ((${#hook_tools[@]} > 0)); then
	((tests++))
	if grep -q -E "^(${hook_tools[0]}) (hook|init) " "$log"; then
		pass "the first startup ran ${hook_tools[0]} to fill the cache (the counting below is not blind)"
	else
		fail "the first startup never ran ${hook_tools[0]} for its init script; the hook counts below prove nothing"
	fi
fi

run_quadrant 'non-login interactive' -i
run_quadrant 'login interactive' -l -i

# The LLM-assistant check in .bashrc reads the parent's name from the engine.
# A parent named claude must turn complex setup off; any other must not.
# shellcheck disable=SC2016 # Expanded by the parent shell.
parent_script='"$1" -i -c "$2"; :'
# shellcheck disable=SC2016 # Expanded by the started shell.
llm_probe='printf "skip=%s\n" "${SKIP_COMPLEX_SHELL_SETUP:-unset}"'
for parent in claude parentshell; do
	ln -sf "$bash_bin" "$work/$parent"
	: >"$log"
	out=$(timeout --foreground --kill-after=5 20 env -i \
		HOME="$HOME" USER="$me" LOGNAME="$me" TERM=xterm SHELL="$bash_bin" XDG_CACHE_HOME="$work/cache" \
		PATH="$stub_dir:$base_path" ORIG_PATH="$base_path" \
		__NIXOS_SET_ENVIRONMENT_DONE=1 __NIX_DARWIN_SET_ENVIRONMENT_DONE=1 SHELL_STARTUP_BENCHMARK=1 \
		BUDGET_LOG="$log" "$work/$parent" -c "$parent_script" "$parent" "$bash_bin" "$llm_probe" 2>/dev/null)
	want='unset'
	[[ $parent == claude ]] && want=true
	((tests++))
	if [[ "$out" == *"skip=$want"* ]] && ! grep -q '^ps ' "$log"; then
		pass "a parent named $parent leaves SKIP_COMPLEX_SHELL_SETUP $want, without running ps"
	else
		fail "a parent named $parent: wanted skip=$want with no ps; got: ${out:-nothing}; log: $(tr '\n' ';' <"$log")"
	fi
done

if ((fails == 0)); then
	printf 'All %s startup exec-budget checks passed.\n' "$tests"
else
	printf '%s of %s startup exec-budget checks failed.\n' "$fails" "$tests" >&2
fi
exit "$fails"
