#!/usr/bin/env luajit
-- The real interactive startup in a headless Ghostty: login and non-login Bash
-- with this account's startup files, from a clean environment like a new tab,
-- every byte through libghostty-vt. Checks what a person would see: the intro
-- (one forced pick at a time) appears before a prompt that accepts commands,
-- the character after it survives, and no image bytes leak as text. Also
-- that the prompt hooks' cached init scripts leave the shell as running the
-- tools did.
--
-- Host-only (bin/test/NOT_HERMETIC): it runs the account's real startup chain,
-- whose prompt and hook tools are absent from the Nix sandbox.
local function shell_output(command)
	local pipe = assert(io.popen(command))
	local out = pipe:read("*a")
	pipe:close()
	return (out:gsub("%s+$", ""))
end

local here = arg[0]:match("^(.*)/[^/]+$") or "."
local root = shell_output("cd '" .. here .. "/../..' && pwd -P")
package.path = root .. "/lib/?.lua;" .. package.path
local loaded, why = require("ghostty_vt.library").ensure(root)
if not loaded then io.stderr:write("FAIL: ", why, "\n") os.exit(1) end
local session = require("ghostty_vt.session")
local picks = require("fun_intro.picks")

local tests, fails = 0, 0
local function check(label, ok, detail)
	tests = tests + 1
	if ok then
		print("PASS: " .. label)
	else
		fails = fails + 1
		io.stderr:write("FAIL: " .. label .. (detail and ("\n" .. detail) or "") .. "\n")
	end
end

local home = os.getenv("HOME")
local work = shell_output("mktemp -d \"${TMPDIR:-/tmp}/ghostty_live_shell_test.XXXXXX\"")
assert(work ~= "", "mktemp failed")
local bash = shell_output("command -v bash")
local luajit = shell_output("command -v luajit")
local user = shell_output("id -un")

-- SHELL_STARTUP_LUAJIT pins the LuaJIT startup runs. This stand-in runs the
-- real one and forces the intro's pick, so every pick is covered on every run.
local stand_in = work .. "/luajit"
local file = assert(io.open(stand_in, "w"))
file:write([[#!/bin/sh
case "$1" in
	*/bin/fun_intro) printf '%s\n' "$INTRO_PICK" >> "$INTRO_LOG"; exec "$REAL_LUAJIT" "$@" --pick="$INTRO_PICK" ;;
	*) exec "$REAL_LUAJIT" "$@" ;;
esac
]])
file:close()
os.execute("chmod +x '" .. stand_in .. "'")

-- An SSH-like pristine base, as the exec-budget test uses.
local base = "/run/current-system/sw/bin:/usr/bin:/bin"
if not io.open("/run/current-system/sw/bin/bash", "rb") then base = "/usr/bin:/bin:/usr/sbin:/sbin" end

local function garbage(text)
	if text:find("_Ga=", 1, true) or text:find("_Gm=", 1, true) or text:find("iVBORw0KGgo", 1, true)
		or text:match('"1;1;%d+;%d+') then
		return true
	end
	for run in text:gmatch("[%w+/]+") do
		if #run >= 200 and run:find("%l") and run:find("%u") and run:find("[%d+/]") then return true end
	end
	return false
end

-- Each run of the intro is recorded, so a check can prove startup ran it.
local invocations = work .. "/intro-invocations"

local function startup(mode, pick)
	os.remove(invocations)
	local argv = { bash, "-i" }
	if mode == "login" then argv = { bash, "--login", "-i" } end
	local s = session.start({ argv = argv, cols = 100, rows = 50, env = {
		"HOME=" .. home, "USER=" .. user, "LOGNAME=" .. user, "SHELL=" .. bash, "LANG=en_US.UTF-8",
		"TERM=xterm-ghostty", "TERM_PROGRAM=ghostty", "PATH=" .. base, "ORIG_PATH=" .. base,
		"__NIXOS_SET_ENVIRONMENT_DONE=1", "__NIX_DARWIN_SET_ENVIRONMENT_DONE=1",
		"XDG_CACHE_HOME=" .. work .. "/cache", "SHELL_STARTUP_LUAJIT=" .. stand_in,
		"REAL_LUAJIT=" .. luajit, "INTRO_PICK=" .. pick, "INTRO_LOG=" .. invocations,
	} })
	-- Typed at once; the terminal holds it until the shell reads its first
	-- line. The marker is printed in halves so the echoed line never matches.
	s:type("printf '%s%s\\n' R 'EADY-1'\n")
	local ready = s:wait_for(function(x) return x:text():find("\nREADY%-1\n") end, 60)
	s:type("echo $((6*7))\n")
	local usable = ready and s:wait_for(function(x) return x:text():find("\n42\n", 1, true) end, 20)
	local text = s:text()
	local placements = s:placements()
	s:close()
	local log = io.open(invocations, "rb")
	local ran = log and log:read("*a") or ""
	if log then log:close() end
	return ready, usable, text, placements, ran == pick .. "\n"
end

local function intro_text(text)
	local before = text:match("^(.-)\nREADY%-1\n") or ""
	return (before:gsub("[^\n]*R' 'EADY%-1'[^\n]*", ""))
end

for _, mode in ipairs({ "non-login", "login" }) do
	local mode_picks = mode == "login" and { "asciidragon", "inthebeginning" } or {}
	if mode == "non-login" then
		for _, pick in ipairs(picks.TEXT) do mode_picks[#mode_picks + 1] = pick end
		for _, pick in ipairs(picks.IMAGE) do mode_picks[#mode_picks + 1] = pick end
	end
	for _, pick in ipairs(mode_picks) do
		local ready, usable, text, placements, ran = startup(mode, pick)
		local intro = intro_text(text)
		local shown
		if picks.known(pick) and pick == "inthebeginning" then
			shown = #placements == 1 and placements[1].width == 600
		else
			shown = intro:gsub("%s", "") ~= "" and #placements == 0
		end
		check(mode .. ", " .. pick .. ": the intro appears before a prompt that accepts commands",
			ready and usable and ran and shown and not garbage(text), text:sub(-800))
	end
end

-- The prompt hooks' cached init scripts (lib/shell_startup/hook_init.lua)
-- must leave the shell as running the tools did. One startup gets an
-- unwritable cache, so apply-hooks runs direnv, mcfly, and starship; a second
-- startup fills a fresh cache and a third evaluates it. All dump their
-- functions and prompt variables, which must match (session keys excluded).
local function read_all(path)
	local f = io.open(path, "rb")
	if not f then return nil end
	local text = f:read("*a")
	f:close()
	return text
end
local function hook_state(cache_home, tag)
	local state, hooks = work .. "/state-" .. tag, work .. "/hooks-" .. tag
	local s = session.start({ argv = { bash, "-i" }, cols = 100, rows = 50, env = {
		"HOME=" .. home, "USER=" .. user, "LOGNAME=" .. user, "SHELL=" .. bash, "LANG=en_US.UTF-8",
		"TERM=xterm-ghostty", "TERM_PROGRAM=ghostty", "PATH=" .. base, "ORIG_PATH=" .. base,
		"__NIXOS_SET_ENVIRONMENT_DONE=1", "__NIX_DARWIN_SET_ENVIRONMENT_DONE=1",
		"XDG_CACHE_HOME=" .. cache_home, "SHELL_STARTUP_LUAJIT=" .. stand_in,
		"REAL_LUAJIT=" .. luajit, "INTRO_PICK=fortune", "INTRO_LOG=" .. invocations,
	} })
	s:type("{ declare -f; declare -p PS0 PS1 PS2 PROMPT_COMMAND precmd_functions preexec_functions; } >'" .. state
		.. "' 2>&1; { declare -p PATH; for v in ${!SHELL_STARTUP_HOOK_*}; do printf '%s=%s\\n' \"$v\" \"${!v}\"; done; } >'"
		.. hooks .. "'; printf '%s%s\\n' D 'UMPED'\n")
	local done = s:wait_for(function(x) return x:text():find("\nDUMPED\n", 1, true) end, 60)
	s:close()
	return done, read_all(state) or "", read_all(hooks) or ""
end
local unwritable = work .. "/not-a-directory"
assert(io.open(unwritable, "w")):close()
local cold_ok, cold_state, cold_hooks = hook_state(unwritable, "cold")
hook_state(work .. "/hook-cache", "fill")
local warm_ok, warm_state, warm_hooks = hook_state(work .. "/hook-cache", "warm")
local cached_count = select(2, warm_hooks:gsub("\nSHELL_STARTUP_HOOK_%u+_INIT=", ""))
check("hook init: a warm startup has the cached scripts and an unwritable cache has none",
	cold_ok and warm_ok and cached_count > 0 and not cold_hooks:find("SHELL_STARTUP_HOOK_", 1, true),
	"cold: " .. cold_hooks .. "\nwarm: " .. warm_hooks)
local first_difference
do
	local a, b = {}, {}
	for line in cold_state:gmatch("[^\n]*") do a[#a + 1] = line end
	for line in warm_state:gmatch("[^\n]*") do b[#b + 1] = line end
	for n = 1, math.max(#a, #b) do
		if a[n] ~= b[n] then first_difference = string.format("line %d:\n  tools: %s\n  cache: %s", n, tostring(a[n]), tostring(b[n])) break end
	end
end
check("hook init: cached scripts leave the same functions and prompt variables as running the tools",
	(cold_state:find("_direnv_hook", 1, true) or cold_state:find("mcfly_prompt_command", 1, true)
		or cold_state:find("starship_precmd", 1, true)) and first_difference == nil,
	first_difference or "the startups defined no hook functions, so the comparison proves nothing")
-- Each cached script is byte-identical to what the tool prints now, run by
-- name on the shell's PATH (for starship, the full init its stub evaluates).
local path_value = warm_hooks:match('declare %-x PATH="([^"]*)"') or ""
local differing = {}
for var, file in warm_hooks:gmatch("SHELL_STARTUP_HOOK_(%u+)_INIT=([^\n]+)") do
	local command = ({ DIRENV = "direnv hook bash", MCFLY = "mcfly init bash",
		STARSHIP = "starship init bash --print-full-init" })[var]
	local pipe = io.popen("PATH='" .. path_value:gsub("'", "'\\''") .. "' " .. command .. " 2>/dev/null")
	local live = pipe:read("*a")
	pipe:close()
	if not command or live ~= read_all(file) then differing[#differing + 1] = var end
end
check("hook init: each cached script matches its tool's live output", path_value ~= "" and #differing == 0,
	"differing: " .. table.concat(differing, ", "))

os.execute("rm -rf '" .. work .. "'")
if fails == 0 then
	print(string.format("All %d live Ghostty startup checks passed.", tests))
else
	io.stderr:write(string.format("%d of %d live Ghostty startup checks failed.\n", fails, tests))
end
os.exit(fails)
