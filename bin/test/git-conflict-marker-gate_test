#!/usr/bin/env bash
# Real index/commit tests: never inspect the working copy as a stand-in for Git.
set -u
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
gate="$root/bin/git-conflict-marker-gate"
hooks="$root/.global-githooks"
bash_path=$(command -v bash)
work=$(mktemp -d "${TMPDIR:-/tmp}/conflict-gate-test.XXXXXXXX") || exit 1
trap 'command rm -rf -- "$work"' EXIT
export GIT_CONFIG_GLOBAL="$work/global-config" GIT_CONFIG_NOSYSTEM=1
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE ALLOW_GIT_CONFLICT_MARKERS
tests=0 failures=0
check() {
	tests=$((tests+1))
	if "$@"; then return; fi
	printf 'FAIL: %s\n' "$*" >&2
	failures=$((failures+1))
}
repo="$work/repo"
git init -q "$repo" || exit 1
cd "$repo" || exit 1
git config user.name 'Gate test'
git config user.email 'gate@example.invalid'
git config commit.gpgsign false
git config core.hooksPath "$hooks"
run_gate() { output=$("$gate" 2>&1); rc=$?; }
stage() { printf '%s\n' "$1" > sample; git add -- sample; }

conflict=$'<<<<<<< HEAD\nours\n=======\ntheirs\n>>>>>>> topic'
# Reject complete ordered blocks, including empty sides, diff3, and CRLF.
for value in "$conflict" \
	$'<<<<<<<\n=======\n>>>>>>>' \
	$'<<<<<<< HEAD\nours\n||||||| base\noriginal\n=======\ntheirs\n>>>>>>> topic' \
	$'<<<<<<<<<< HEAD\nours\n==========\ntheirs\n>>>>>>>>>> topic' \
	$'<<<<<<< HEAD\r\nours\r\n=======\r\ntheirs\r\n>>>>>>> topic\r' \
	$'Copyright\n=========\n'"$conflict"; do
	stage "$value"
	run_gate
	check test "$rc" -eq 1
done
for value in 'ordinary text' 'x <<<<<<< HEAD' '====== comparison' '======='"not-a-marker" '<<<<<<<<operator' '>>>>>> six' '' \
	'<<<<<<< HEAD' '=======' '>>>>>>> topic' '||||||| base' '<<<<<<<<<< HEAD' $'=======\r' \
	$'Copyright\n=========\n\nLicensed upstream content' \
	$'<<<<<<< HEAD\nours\n=======' \
	$'=======\ntheirs\n>>>>>>> topic' \
	$'<<<<<<< HEAD\nours\n>>>>>>> topic' \
	$'>>>>>>> topic\n=======\n<<<<<<< HEAD'; do
	stage "$value"
	run_gate
	check test "$rc" -eq 0
done

# A final closing marker without an EOF newline still completes the block.
printf '%s' "$conflict" > sample
git add sample
run_gate
check test "$rc" -eq 1
check test "${output#*sample:1:}" != "$output"
check test "${output#*sample:3:}" != "$output"
check test "${output#*sample:5:}" != "$output"
stage 'clean'

# Marker fragments in separate files cannot form a block together.
printf '<<<<<<< HEAD\n=======\n' > fragment-start
printf '>>>>>>> topic\n' > fragment-end
git add fragment-start fragment-end
run_gate
check test "$rc" -eq 0
git rm -q -f --cached fragment-start fragment-end

# All changed paths, including whitespace, colon, leading dash and newline.
for name in 'with space' ':literal' '-option' $'line\nbreak'; do
	printf '%s\n' "$conflict" > "$name"
	git --literal-pathspecs add -- "$name"
	run_gate
	check test "$rc" -eq 1
	git --literal-pathspecs rm -q -f --cached -- "$name"
done

stage "$conflict"
printf 'clean working copy\n' > sample
run_gate
check test "$rc" -eq 1
stage 'clean index'
printf '%s\n' "$conflict" > sample
run_gate
check test "$rc" -eq 0

# Bypass is narrow, exact and loud.
stage "$conflict"
output=$(ALLOW_GIT_CONFLICT_MARKERS=0 "$gate" 2>&1); rc=$?
check test "$rc" -eq 1
output=$(ALLOW_GIT_CONFLICT_MARKERS=1 "$gate" 2>&1); rc=$?
check test "$rc" -eq 0
check test -n "$output"

# A real commit proves the dispatcher is installed and blocks before local hooks.
printf '#!%s\nprintf "ran\\n" >> local-hook-log\n' "$bash_path" > .git/hooks/pre-commit
chmod +x .git/hooks/pre-commit
output=$(git commit -qm blocked 2>&1); rc=$?
check test "$rc" -ne 0
check test ! -e local-hook-log
stage 'clean'
output=$(git commit -qm clean 2>&1); rc=$?
check test "$rc" -eq 0
check test "$(wc -l 2>/dev/null < <(cat local-hook-log 2>/dev/null))" -eq 1

# Existing marker elsewhere in the changed blob must not evade a diff-only check.
stage "$conflict"
output=$(ALLOW_GIT_CONFLICT_MARKERS=1 git commit -qm fixture 2>&1); rc=$?
check test "$rc" -eq 0
printf '\nanother line\n' >> sample
git add sample
run_gate
check test "$rc" -eq 1

# Binary blobs and symlink targets are not scanned as text.
git rm -q -f sample
printf '\000\n%s\n' "$conflict" > binary
ln -s "$conflict" link
git add binary link
run_gate
check test "$rc" -eq 0

# The bypass cannot bypass repository checks.
printf '#!%s\nexit 23\n' "$bash_path" > .git/hooks/pre-commit
output=$(ALLOW_GIT_CONFLICT_MARKERS=1 git commit -qm local-reject 2>&1); rc=$?
check test "$rc" -ne 0

# Non-commit hook stdin/argv and exit status survive global hook selection.
printf '#!%s\nprintf "%%s\\n" "$@" > received-args\ncat > received-input\nexit 17\n' "$bash_path" > .git/hooks/pre-push
chmod +x .git/hooks/pre-push
push_payload='(delete) 0000000000000000000000000000000000000000 refs/heads/obsolete 1111111111111111111111111111111111111111'
printf '%s\n' "$push_payload" > "$work/push-input"
output=$(git hook run --to-stdin="$work/push-input" pre-push -- origin 'ssh://example.invalid/repo' 2>&1); rc=$?
check test "$rc" -eq 17
check test "$(cat received-input 2>/dev/null)" = "$push_payload"
check test "$(head -n 1 received-args 2>/dev/null)" = origin

# Empty staging and missing repository are distinct.
output=$(git -c core.hooksPath=/dev/null commit -qm cleanup 2>&1)
run_gate
check test "$rc" -eq 0
output=$(git hook run pre-merge-commit 2>&1); rc=$?
check test "$rc" -eq 23

# Custom tracked hook directories retain their behavior after migration.
mkdir -p custom-hooks
printf '#!%s\nexit 29\n' "$bash_path" > custom-hooks/pre-commit
chmod +x custom-hooks/pre-commit
git config conflictMarkerGate.delegateHooksPath custom-hooks
output=$(git hook run pre-commit 2>&1); rc=$?
check test "$rc" -eq 29
git config --unset conflictMarkerGate.delegateHooksPath

# Linked worktrees must use their own index and the shared repository hooks.
output=$(git -c core.hooksPath=/dev/null worktree add -qb linked "$work/linked" 2>&1); rc=$?
check test "$rc" -eq 0
cd "$work/linked" || exit 1
stage "$conflict"
output=$(git commit -qm blocked-linked 2>&1); rc=$?
check test "$rc" -ne 0
stage 'clean linked'
output=$(git commit -qm local-reject-linked 2>&1); rc=$?
check test "$rc" -ne 0
check test "$output" = ''

# A custom hook pointing back at the dispatcher must fail, not loop forever.
cd "$repo" || exit 1
git config conflictMarkerGate.delegateHooksPath "$hooks"
output=$(git hook run pre-commit 2>&1); rc=$?
check test "$rc" -eq 2
check test "${output#*recursive Git hook}" != "$output"
git config --unset conflictMarkerGate.delegateHooksPath

# Inspection failures must never look like a clean index.
printf 'not a git index\n' > "$work/broken-index"
output=$(GIT_INDEX_FILE="$work/broken-index" "$gate" 2>&1); rc=$?
check test "$rc" -eq 2
cd "$work" || exit 1
run_gate
check test "$rc" -gt 1

# A global hook also runs while git init is still creating HEAD/config.
git config --file "$GIT_CONFIG_GLOBAL" core.hooksPath "$hooks"
output=$(git init -q "$work/global-init" 2>&1); rc=$?
check test "$rc" -eq 0
check test -z "$output"
output=$(git init --bare -q "$work/global-bare" 2>&1); rc=$?
check test "$rc" -eq 0
check test -z "$output"
# The gate runs on every commit, and `rm` may move files to the Trash, so it uses no temporary files.
cd "$repo" || exit 1
mkdir -p "$work/rm-bin" "$work/gate-tmp"
printf '#!%s\nprintf "%%s\\n" "$*" >> %q\n' "$bash_path" "$work/rm-calls" > "$work/rm-bin/rm"
chmod +x "$work/rm-bin/rm"
: > "$work/rm-calls"
stage "$conflict"
output=$(PATH="$work/rm-bin:$PATH" TMPDIR="$work/gate-tmp" "$gate" 2>&1); rc=$?
check test "$rc" -eq 1
check test "${output#*sample:1:}" != "$output"
stage clean
output=$(PATH="$work/rm-bin:$PATH" TMPDIR="$work/gate-tmp" "$gate" 2>&1); rc=$?
check test "$rc" -eq 0
check test "$(cat "$work/rm-calls")" = ''
check test "$(ls -A "$work/gate-tmp")" = ''
# A staged blob Git cannot read makes git grep report "no match", so the gate must check
# that every staged blob exists before trusting the scan.
stage "$conflict"
missing_blob=$(git rev-parse :sample)
mv -- ".git/objects/${missing_blob:0:2}/${missing_blob:2}" "$work/missing-blob"
run_gate
check test "$rc" -eq 2
check test "${output#*"staged blob $missing_blob cannot be read; commit refused"}" != "$output"
mv -- "$work/missing-blob" ".git/objects/${missing_blob:0:2}/${missing_blob:2}"
# A submodule entry names a commit in another repository; it is not a missing blob.
stage clean
git update-index --add --cacheinfo "160000,$(printf '%040d' 1),vendored-submodule"
run_gate
check test "$rc" -eq 0
git rm -q --cached vendored-submodule

printf '%s checks, %s failures\n' "$tests" "$failures"
test "$failures" -eq 0
