#!/usr/bin/env bash

# Persistence and default-delta contract for fleet-status.

set -u

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
fleet="$repo_root/bin/fleet-status"
scratch="$(mktemp -d "${TMPDIR:-/tmp}/fleet-status-persistence.XXXXXX")" || exit 1
trap 'rm -rf "$scratch"' EXIT
scan_root="$scratch/root with spaces"
repo="$scan_root/solo"
state="$scratch/state"
mkdir -p "$repo"
git -C "$repo" init -q -b main
printf 'initial\n' >"$repo/tracked"
git -C "$repo" add tracked
git -C "$repo" -c user.name=FleetTest -c user.email=fleet@example.invalid commit -q -m initial

fails=0
tests=0
expect_eq() {
	local label="$1" expected="$2" actual="$3"
	((tests++))
	if [[ "$expected" == "$actual" ]]; then
		return 0
	fi
	printf 'FAIL %s\nexpected: %s\nactual:   %s\n' "$label" "$expected" "$actual" >&2
	((fails++))
}

first=$("$fleet" --tier 1 --root "$scan_root" --state-dir "$state" 2>"$scratch/first.err")
expect_eq "first run emits full state" "1 no-remote (solo)" "$first"
expect_eq "first run stderr is clean" "" "$(cat "$scratch/first.err")"
expect_eq "first run persists current JSON" "true" \
	"$(test -f "$state/current.json" && jq -e '.schema_version == 1' "$state/current.json" >/dev/null 2>&1 && printf true || printf false)"
expect_eq "first run persists rendered Markdown" "true" \
	"$(test -f "$state/report.md" && rg -q '^# Fleet status$' "$state/report.md" && printf true || printf false)"
expect_eq "first run has no synthetic previous snapshot" "false" \
	"$(test -e "$state/previous.json" && printf true || printf false)"

printf 'modified\n' >>"$repo/tracked"
second=$("$fleet" --tier 1 --root "$scan_root" --state-dir "$state" 2>"$scratch/second.err")
expect_eq "second run emits only the new risk" "new: 1 modified (solo)" "$second"
expect_eq "second run stderr is clean" "" "$(cat "$scratch/second.err")"
expect_eq "previous snapshot preserves the clean run" "0" \
	"$(jq -r '.repos[] | select(.name == "solo") | .dirty.modified' "$state/previous.json" 2>/dev/null)"
expect_eq "current snapshot contains the dirty run" "1" \
	"$(jq -r '.repos[] | select(.name == "solo") | .dirty.modified' "$state/current.json" 2>/dev/null)"
expect_eq "saved Markdown includes the run's delta" "true" \
	"$(rg -q '^new: 1 modified \(solo\)$' "$state/report.md" && printf true || printf false)"

third=$("$fleet" --tier 1 --root "$scan_root" --state-dir "$state" 2>"$scratch/third.err")
expect_eq "unchanged third run is quiet and explicit" "No fleet status changes." "$third"
expect_eq "third run stderr is clean" "" "$(cat "$scratch/third.err")"

full=$("$fleet" --tier 1 --root "$scan_root" --state-dir "$state" --full 2>"$scratch/full.err")
expect_eq "full mode bypasses the delta" "1 no-remote (solo) · 1 modified (solo)" "$full"
expect_eq "full mode stderr is clean" "" "$(cat "$scratch/full.err")"

before_hash="$(git hash-object "$state/current.json")"
"$fleet" --tier 1 --root "$scan_root" --state-dir "$state" --format json --no-save >"$scratch/no-save.json" 2>"$scratch/no-save.err"
expect_eq "--no-save leaves current snapshot byte-for-byte unchanged" "$before_hash" \
	"$(git hash-object "$state/current.json")"
expect_eq "--no-save JSON remains parseable" "true" \
	"$(jq -e '.repos | length == 1' "$scratch/no-save.json" >/dev/null 2>&1 && printf true || printf false)"
expect_eq "--no-save stderr is clean" "" "$(cat "$scratch/no-save.err")"

"$fleet" --tier 1 --root "$scan_root" --state-dir "$state" --format markdown --no-save >"$scratch/markdown" 2>"$scratch/markdown.err"
expect_eq "Markdown format exposes the approved renderer" "true" \
	"$(rg -q '^## Immediate action$' "$scratch/markdown" && printf true || printf false)"
expect_eq "Markdown format stderr is clean" "" "$(cat "$scratch/markdown.err")"
expect_eq "Markdown --no-save still leaves state unchanged" "$before_hash" \
	"$(git hash-object "$state/current.json")"

lock_probe="$(luajit -e "
	package.path = '$repo_root/lib/?.lua;' .. package.path
	local fleet = require('fleet_status')
	local first = assert(fleet.acquire_state_lock('$scratch/lock-state'))
	local second, second_error = fleet.acquire_state_lock('$scratch/lock-state')
	assert(fleet.release_state_lock(first))
	local third = assert(fleet.acquire_state_lock('$scratch/lock-state'))
	assert(fleet.release_state_lock(third))
	io.write(tostring(second), '|', tostring(second_error), '|reacquired')
" 2>"$scratch/lock.err")"
expect_eq "state publication lock excludes a concurrent writer and is reusable" \
	"nil|fleet-status state is locked by another run|reacquired" "$lock_probe"
expect_eq "state lock probe stderr is clean" "" "$(cat "$scratch/lock.err")"

printf '{broken\n' >"$state/current.json"
"$fleet" --tier 1 --root "$scan_root" --state-dir "$state" --format json --no-save \
	>"$scratch/rescue.json" 2>"$scratch/rescue.err"
expect_eq "read-only JSON collection ignores malformed prior rendering state" "0" "$?"
expect_eq "read-only JSON rescue output remains parseable" "true" \
	"$(jq -e '.repos | length == 1' "$scratch/rescue.json" >/dev/null 2>&1 && printf true || printf false)"
expect_eq "read-only JSON rescue stderr is clean" "" "$(cat "$scratch/rescue.err")"

if (( fails == 0 )); then
	printf 'All %d fleet-status persistence tests passed\n' "$tests"
fi
exit "$fails"
