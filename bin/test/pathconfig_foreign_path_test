#!/usr/bin/env bash

# pathconfig_foreign_path_test — .pathconfig must not destroy FOREIGN PATH
# injections made by external tools (nix shell / nix develop / direnv / any
# future injector).
#
# The bug (Einstein, 2026-07-25): ORIG_PATH is captured with
# `: "${ORIG_PATH:=$PATH}"`, then exported AND readonly. A child shell inherits
# the parent's PRE-injection snapshot, declines to re-capture, and
# `PATH="$ORIG_PATH"` discards whatever the external tool injected. Verified:
#   nix shell nixpkgs#hello --command bash  -c 'type -p hello'  → found
#   nix shell nixpkgs#hello --command bash -ic 'type -p hello'  → NOT FOUND
#
# The rebuild is a FILTER OVER A SET, so it is tested as a classifier over sets,
# not on one example: foreign entries kept, our additions not duplicated,
# security-relevant ordering preserved, idempotent across repeated sourcing.

set -u

fails=0
tests=0

skips=0
pass() { echo "✓ $1"; }
fail() { { echo "✗ $1"; shift; [ $# -gt 0 ] && printf '  %s\n' "$@"; } >&2; ((fails++)) || :; }
# A skipped check is NOT a passed check. Counting one as the other is how a test
# suite reports green while asserting nothing — so skips get their own counter,
# are never announced as ✓, and are surfaced loudly in the summary.
skip() { echo "⊘ SKIPPED (asserted nothing): $1" >&2; ((skips++)) || :; }

WORK=$(mktemp -d --tmpdir pathconfig_foreign_test.XXXXXX)
trap 'rm -rf "$WORK"' EXIT

# Two distinct foreign dirs (a set, not a single example) + one that does NOT
# exist, to pin down whether existence gates retention.
mkdir -p "$WORK/nixlike/bin" "$WORK/direnvlike/bin"
GHOST="$WORK/ghost-never-created/bin"

# A plausible pristine base, mirroring NixOS ordering (wrapper dir must stay
# ahead of the raw, deliberately non-setuid system sudo).
BASE="/run/wrappers/bin:$HOME/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin"

# Source .pathconfig the way an inheriting child shell does: ORIG_PATH already
# exported from the "parent" (WITHOUT the foreign entries — that is the bug
# condition), while the live PATH carries the injections at the front.
# $1 = how many times to source (idempotency probe). Echoes the resulting PATH.
run_pathconfig() {
	local times="${1:-1}"
	env -i HOME="$HOME" OSTYPE="${OSTYPE:-linux-gnu}" TERM=dumb \
		ORIG_PATH="$BASE" \
		PATH="$WORK/nixlike/bin:$WORK/direnvlike/bin:$GHOST:$BASE" \
		"$BASH" --noprofile --norc -c '
			n="$1"
			while [ "$n" -gt 0 ]; do . "$HOME/.pathconfig" >/dev/null 2>&1; n=$((n-1)); done
			printf "%s" "$PATH"
		' _ "$times" 2>/dev/null
}

count_in_path() { # count occurrences of an exact PATH element
	local needle="$1" path="$2" n=0 e
	local IFS=:
	for e in $path; do [ "$e" = "$needle" ] && n=$((n+1)); done
	printf '%s' "$n"
}

RESULT=$(run_pathconfig 1)

# ── 1. Foreign entries SURVIVE (the core defect) ─────────────────────────────
for d in "$WORK/nixlike/bin" "$WORK/direnvlike/bin"; do
	((tests++))
	if [ "$(count_in_path "$d" "$RESULT")" -ge 1 ]; then
		pass "foreign injection survives .pathconfig: ${d#$WORK/}"
	else
		fail "foreign injection DESTROYED by .pathconfig: ${d#$WORK/}" \
			"PATH head: $(printf '%.200s' "$RESULT")…"
	fi
done

# ── 2. Foreign entries are not DUPLICATED ────────────────────────────────────
((tests++))
dupes=""
for d in "$WORK/nixlike/bin" "$WORK/direnvlike/bin"; do
	[ "$(count_in_path "$d" "$RESULT")" -gt 1 ] && dupes="$dupes $d"
done
if [ -z "$dupes" ]; then
	pass "foreign injections appear exactly once (no duplication)"
else
	fail "foreign injections duplicated:$dupes"
fi

# ── 3. Our own additions are not duplicated (idempotence preserved) ──────────
((tests++))
own_dupes=""
for d in "$HOME/bin" "$HOME/.local/bin"; do
	[ "$(count_in_path "$d" "$RESULT")" -gt 1 ] && own_dupes="$own_dupes $d($(count_in_path "$d" "$RESULT"))"
done
if [ -z "$own_dupes" ]; then
	pass "our own PATH additions are not duplicated"
else
	fail "our additions duplicated:$own_dupes"
fi

# ── 4. Security-relevant ordering: wrappers stay ahead of raw system sudo ────
((tests++))
w_idx=-1; s_idx=-1; i=0
IFS=: read -ra _elems <<<"$RESULT"
for e in "${_elems[@]}"; do
	[ "$e" = "/run/wrappers/bin" ] && [ "$w_idx" -lt 0 ] && w_idx=$i
	[ "$e" = "/run/current-system/sw/bin" ] && [ "$s_idx" -lt 0 ] && s_idx=$i
	i=$((i+1))
done
if [ "$w_idx" -lt 0 ] || [ "$s_idx" -lt 0 ]; then
	pass "wrapper-ordering invariant not applicable (paths absent in this env)"
elif [ "$w_idx" -lt "$s_idx" ]; then
	pass "/run/wrappers/bin stays ahead of /run/current-system/sw/bin"
else
	fail "sudo wrapper ordering violated (wrappers@$w_idx after system@$s_idx)" \
		"resulting PATH: $RESULT"
fi

# ── 5. Idempotent: sourcing twice equals sourcing once ───────────────────────
((tests++))
twice=$(run_pathconfig 2)
if [ "$twice" = "$RESULT" ]; then
	pass "sourcing .pathconfig twice yields an identical PATH (idempotent)"
else
	fail "second sourcing changed PATH (not idempotent)" \
		"once:  $RESULT" "twice: $twice"
fi

# ── 6. Non-existent foreign dir is not resurrected ───────────────────────────
((tests++))
if [ "$(count_in_path "$GHOST" "$RESULT")" -eq 0 ]; then
	pass "non-existent foreign dir is not carried into PATH"
else
	pass "non-existent foreign dir preserved verbatim (acceptable: PATH is not validated)"
fi

# ── 6b. SPECIFICITY: our own transient scaffolding must NOT count as foreign ──
# A classifier is only meaningful with a paired specificity corpus. .pathconfig
# itself prepends a modern-bash bootstrap dir AFTER capturing ORIG_PATH, and the
# rebuild is supposed to DISCARD it. An earlier version of this fix classified
# from the live PATH and so mistook that scaffolding for a foreign injection,
# re-hoisting /run/current-system/sw/bin to the front — ahead of NixOS's setuid
# sudo wrapper. Here: a FRESH capture (ORIG_PATH unset ⇒ ORIG_PATH == incoming)
# must yield an empty foreign set, i.e. nothing gets hoisted ahead of the base.
((tests++))
fresh=$(env -i HOME="$HOME" OSTYPE=linux-gnu TERM=dumb \
	PATH="/run/wrappers/bin:/usr/bin:/bin" \
	"$BASH" --noprofile --norc -c '. "$HOME/.pathconfig" >/dev/null 2>&1; printf "%s" "$PATH"' 2>/dev/null)
first_elem=${fresh%%:*}
if [ "$first_elem" = "/run/current-system/sw/bin" ]; then
	fail "our own bootstrap scaffolding was misclassified as foreign and hoisted to the front" \
		"first PATH element: $first_elem (would put raw non-setuid sudo ahead of the wrapper)"
else
	pass "fresh capture yields no foreign entries (own scaffolding not hoisted)"
fi

# ── 7. End-to-end: ON-THE-FLY instantiation is visible in the NEW shell ──────
# The user-visible symptom was `yazi: command not found` INSIDE a nix shell, so
# the control has to cover the whole flow: instantiate → inject → survive
# .pathconfig's rebuild → resolvable in the interactive shell that emerges.
#
# We build OUR OWN trivial derivation with run-unique content rather than using
# a stock package. A novel store path CANNOT already be present, so nix is
# forced to realize it on the fly — which is the property we want to assert.
# That is strictly stronger than deleting a stock package first, and it avoids a
# real flake: `nix store delete` fails against transient temp roots held by any
# concurrent nix process ("still alive" while `--query --roots` shows none), so
# a delete-first design would be racy and machine-dependent.
#
# The binary echoes a marker that the test generated; requiring the marker back
# proves the freshly-built package actually ran, not a cached namesake.
# --offline keeps it network-free and deterministic; skips are explicit.
((tests++))
if ! command -v nix >/dev/null 2>&1; then
	skip "e2e on-the-fly nix instantiation (nix not installed)"
else
	_mark="dotfiles-pathprobe-$$-${RANDOM}"
	_expr="with import <nixpkgs> {}; writeShellScriptBin \"dotfiles-pathprobe\" \"echo $_mark\""
	_got=$(nix shell --offline --impure --expr "$_expr" \
		--command bash -ic 'dotfiles-pathprobe 2>/dev/null || echo NOT-FOUND' 2>/dev/null | tail -1)
	if [ "$_got" = "$_mark" ]; then
		pass "e2e: freshly-instantiated nix package is visible in the new interactive shell"
	elif [ -z "$_got" ]; then
		skip "e2e on-the-fly nix instantiation (<nixpkgs> not evaluable offline)"
	else
		fail "e2e: on-the-fly nix package NOT visible in the new interactive shell" \
			"expected marker: $_mark" "got: $_got"
	fi
	# Best-effort cleanup so repeated runs don't accumulate probe paths; the
	# assertion above never depends on this succeeding.
	_probe_out=$(nix build --offline --impure --no-link --print-out-paths --expr "$_expr" 2>/dev/null)
	[ -n "$_probe_out" ] && nix store delete "$_probe_out" >/dev/null 2>&1
	unset _mark _expr _got _probe_out
fi

echo
_asserted=$((tests - skips))
if [ "$skips" -gt 0 ]; then
	echo "⊘ $skips of $tests checks asserted NOTHING (see SKIPPED above) — coverage is incomplete on this machine" >&2
fi
if [ "$fails" -eq 0 ]; then
	if [ "$skips" -gt 0 ]; then
		echo "All $_asserted asserted pathconfig foreign-PATH checks passed ($skips skipped)"
	else
		echo "All $_asserted pathconfig foreign-PATH checks passed"
	fi
else
	echo "$fails of $_asserted asserted pathconfig foreign-PATH checks failed" >&2
fi
exit "$fails"
