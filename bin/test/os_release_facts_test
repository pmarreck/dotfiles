#!/usr/bin/env luajit

-- Differential oracle for lib/shell_startup/os_release.lua: for every corpus
-- file, the engine's DISTRO, DISTRO_PRETTY, and DISTRO_VERSION must equal what
-- Bash captures from bin/distro, bin/distro_pretty, and bin/distro_version.

local script_dir = arg[0]:match("^(.*)/[^/]*$") or "."
local repo = script_dir .. "/../.."
package.path = repo .. "/lib/shell_startup/?.lua;" .. package.path

local fails, tests = 0, 0
local function check(label, cond, detail)
	tests = tests + 1
	if cond then return end
	fails = fails + 1
	io.stderr:write("FAIL ", label, detail and ("\n  " .. detail) or "", "\n")
end

local ok, os_release = pcall(require, "os_release")
check("os_release module loads", ok, tostring(os_release))
if not ok then os.exit(1) end

local function quote(s) return "'" .. (s:gsub("'", "'\\''")) .. "'" end

local corpus = {
	-- Real-world files, abbreviated to the keys that matter plus neighbors.
	'ANSI_COLOR="1;34"\nBUG_REPORT_URL="https://github.com/NixOS/nixpkgs/issues"\nBUILD_ID="26.11"\nID=nixos\nNAME=NixOS\nPRETTY_NAME="NixOS 26.11 (Zokor)"\nVERSION="26.11 (Zokor)"\nVERSION_ID="26.11"\n',
	'PRETTY_NAME="Ubuntu 24.04.1 LTS"\nNAME="Ubuntu"\nVERSION_ID="24.04"\nVERSION="24.04.1 LTS (Noble Numbat)"\nID=ubuntu\nID_LIKE=debian\n',
	'PRETTY_NAME="Debian GNU/Linux 12 (bookworm)"\nNAME="Debian GNU/Linux"\nVERSION_ID="12"\nVERSION="12 (bookworm)"\nID=debian\n',
	'NAME="Fedora Linux"\nVERSION="41 (Workstation Edition)"\nID=fedora\nVERSION_ID=41\nPRETTY_NAME="Fedora Linux 41 (Workstation Edition)"\n',
	'NAME="Void"\nPRETTY_NAME="Void Linux"\nID="void"\nBUILD_ID="rolling"\n',
	'NAME="Alpine Linux"\nID=alpine\nVERSION_ID=3.20.3\nPRETTY_NAME="Alpine Linux v3.20"\n',
	'NAME="openSUSE Tumbleweed"\nID="opensuse-tumbleweed"\nVERSION_ID="20241120"\nPRETTY_NAME="openSUSE Tumbleweed"\n',
	"NAME='Single Quoted'\nPRETTY_NAME='It''s single'\nVERSION_ID='1.0'\n",
	-- Adversarial structure.
	'NAME="CRLF Linux"\r\nPRETTY_NAME="CRLF Linux 1"\r\nVERSION_ID="1"\r\n',
	'NAME="a=b=c"\nPRETTY_NAME=x=y\nVERSION_ID="1=2"\n',
	'NAME=First\nNAME=Second\nPRETTY_NAME=\nPRETTY_NAME="Later"\nVERSION_ID=1\nVERSION_ID=\n',
	'NAME=\nPRETTY_NAME=""\nVERSION_ID=""\n',
	'VERSION_ID="\nNAME="\nPRETTY_NAME="""\n',
	'VERSION_ID\nNAME\nPRETTY_NAME\n',
	'  NAME=Indented\n#NAME=Comment\nXNAME=Prefixed\nPRETTY_NAME_EXTRA=no\nVERSION_ID_EXTRA=no\n',
	'NAME=NoTrailingNewline',
	'',
	'\n\n\n',
	'NAME="Caf\195\169 OS"\nPRETTY_NAME="\226\156\147 Ready"\nVERSION_ID="\255"\n',
	'NAME="nul\0inside"\nVERSION_ID="1\0"\n',
	'NAME="trailing space " \nVERSION_ID= 2 \n',
	'VERSION_ID="a"b"\nNAME=a"b"c\n',
}
local seed = 7
local function random(n)
	seed = (seed * 1103515245 + 12345) % 2147483648
	return seed % n + 1
end
local keys = { "NAME", "PRETTY_NAME", "VERSION_ID", "ID", "XNAME", " NAME", "VERSION" }
local pieces = { '"', "'", "=", "a", "Z", " ", "1.0", "\r", "Linux", "\195\169", "" }
for _ = 1, 200 do
	local lines = {}
	for i = 1, random(6) - 1 do
		local value = {}
		for j = 1, random(6) - 1 do value[j] = pieces[random(#pieces)] end
		lines[i] = keys[random(#keys)] .. (random(5) == 1 and "" or "=") .. table.concat(value)
	end
	corpus[#corpus + 1] = table.concat(lines, "\n") .. (random(3) == 1 and "" or "\n")
end

local work = assert(io.popen("mktemp -d \"${TMPDIR:-/tmp}/os_release_facts_test.XXXXXX\"")):read("*l")
assert(work and work ~= "", "mktemp failed")
for i, text in ipairs(corpus) do
	local file = assert(io.open(string.format("%s/%04d", work, i), "wb"))
	file:write(text)
	file:close()
end

-- One Bash process sources the real commands as functions, pins a Linux
-- kernel name and gawk, and captures each command exactly as .bashrc did.
local program = [[
	uname() { printf 'Linux\n'; }
	AWK=$(command -v gawk || command -v awk)
	. "$1/bin/distro"; . "$1/bin/distro_pretty"; . "$1/bin/distro_version"
	for ((i = 1; i <= $3; i++)); do
		f=$(printf '%s/%04d' "$2" "$i")
		printf '%s\0%s\0%s\0' "$(distro "$f")" "$(distro_pretty "$f")" "$(distro_version "$f")"
	done
]]
local pipe = assert(io.popen(string.format("bash --noprofile --norc -c %s _ %s %s %d 2>/dev/null",
	quote(program), quote(repo), quote(work), #corpus), "r"))
local output = pipe:read("*a")
pipe:close()

local expected = {}
for value in output:gmatch("([^%z]*)%z") do expected[#expected + 1] = value end
check("the oracle produced three values per corpus file", #expected == 3 * #corpus,
	string.format("got %d values for %d files", #expected, #corpus))

local mismatches = 0
for i, text in ipairs(corpus) do
	local facts = os_release.facts(text)
	for k, name in ipairs({ "DISTRO", "DISTRO_PRETTY", "DISTRO_VERSION" }) do
		local want = expected[3 * (i - 1) + k]
		if want ~= nil and facts[name] ~= want then
			mismatches = mismatches + 1
			if mismatches <= 5 then
				io.stderr:write(string.format("  file %d %s: oracle %q, engine %q\n  text %q\n", i, name, want, facts[name], text))
			end
		end
	end
end
check(string.format("engine facts equal the commands for all %d corpus files", #corpus), mismatches == 0,
	mismatches .. " mismatched value(s)")

os.execute("rm -rf -- " .. quote(work))
if fails == 0 then
	print(string.format("All %d os-release fact checks passed.", tests))
	os.exit(0)
end
io.stderr:write(string.format("%d of %d os-release fact checks failed.\n", fails, tests))
os.exit(1)
