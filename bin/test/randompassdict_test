#!/usr/bin/env bash

# Deterministic CLI and pure-core contract for the LuaJIT randompassdict port.

set -u

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
cli="$repo_root/bin/randompassdict"
legacy="$repo_root/bin/randompassdict.bash"
core_module="$repo_root/bin/src/randompassdict_core.lua"
scratch="$(mktemp -d "${TMPDIR:-/tmp}/randompassdict-test.XXXXXX")" || exit 1
cleanup_rm=''
while IFS= read -r candidate; do
	case "$candidate" in
		*rm_safe*) ;;
		*) cleanup_rm="$candidate"; break ;;
	esac
done < <(type -aP rm)
trap '"$cleanup_rm" -rf "$scratch"' EXIT

# shellcheck source=/dev/null
source "$repo_root/bin/src/capture.bash"

fails=0
tests=0
out=''
err=''
rc=0

expect_eq() {
	local label="$1" expected="$2" actual="$3"
	((tests++))
	if [[ "$expected" == "$actual" ]]; then return 0; fi
	printf 'FAIL %s\nexpected: %q\nactual:   %q\n' \
		"$label" "$expected" "$actual" >&2
	((fails++))
}

expect_match() {
	local label="$1" pattern="$2" actual="$3"
	((tests++))
	if [[ "$actual" =~ $pattern ]]; then return 0; fi
	printf 'FAIL %s\npattern: %s\nactual:  %q\n' \
		"$label" "$pattern" "$actual" >&2
	((fails++))
}

expect_true() {
	local label="$1"
	shift
	((tests++))
	if "$@"; then return 0; fi
	printf 'FAIL %s\n' "$label" >&2
	((fails++))
}

expect_false() {
	local label="$1"
	shift
	((tests++))
	if ! "$@"; then return 0; fi
	printf 'FAIL %s\n' "$label" >&2
	((fails++))
}

# shellcheck disable=SC2329 # invoked indirectly through expect_true/expect_false
file_has_line() {
	local wanted="$1" file="$2" line
	while IFS= read -r line || [[ -n "$line" ]]; do
		if [[ "$line" == "$wanted" ]]; then return 0; fi
	done <"$file"
	return 1
}

expect_match 'active executable uses a LuaJIT shebang' \
	'^#!(/usr/bin/env luajit|.*/luajit)$' "$(head -n 1 "$cli")"
expect_true 'Bash predecessor remains executable' test -x "$legacy"
if [[ -e "$legacy" ]]; then
	expect_match 'Bash predecessor retains a Bash shebang' \
		'^#!(/usr/bin/env bash|.*/bash)$' "$(head -n 1 "$legacy")"
	expect_eq 'Bash predecessor body is byte-for-byte preserved' \
		'9f6e20f5b4e4c1b5e8f77f9dec9e5a2570239e097e3e4ec4b16570297e3e2d3b' \
		"$(tail -n +2 "$legacy" | sha256sum | awk '{print $1}')"
	# shellcheck disable=SC2016 # $1 belongs to the inner Bash process
	capture bash -c 'source "$1"; randompassdict --help' _ "$legacy"
	expect_eq 'preserved Bash function remains sourceable' '0' "$rc"
	expect_match 'preserved Bash function retains its help' \
		'^Usage: randompassdict' "$out"
	expect_eq 'preserved Bash help keeps stderr clean' '' "$err"
fi

capture "$cli"
expect_eq 'missing word count is a usage error' '2' "$rc"
expect_eq 'missing word count emits no stdout' '' "$out"
expect_match 'missing word count prints usage on stderr' \
	'^Usage: randompassdict' "$err"

capture "$cli" --help
expect_eq '--help succeeds' '0' "$rc"
expect_match '--help documents both inclusive range spellings' \
	'M-N.*M\.\.N' "$(tr '\n' ' ' <<<"$out")"
expect_match '--help documents proper-noun filtering' \
	'--no-proper-nouns' "$out"
expect_match '--help documents spelling-corpus overrides' \
	'--american.*--british' "$(tr '\n' ' ' <<<"$out")"
expect_match '--help names the fixed secure source' '/dev/urandom' "$out"
expect_eq '--help keeps stderr clean' '' "$err"

capture "$cli" --about
expect_eq '--about succeeds' '0' "$rc"
expect_match '--about reports the breaking-interface version and platform' \
	'^randompassdict 2\.0\.0 - .+ \(.+/.+\)$' "$out"
expect_eq '--about is exactly one line' '1' \
	"$(printf '%s\n' "$out" | wc -l | tr -d ' ')"
expect_eq '--about keeps stderr clean' '' "$err"

range_dict="$scratch/ranges.txt"
printf 'aa\ncat\nfour\nfives\nsixsix\n' >"$range_dict"

capture env WORDLIST_FILEPATH="$range_dict" JUST_OUTPUT_DICTIONARY=1 \
	"$cli" 1 4
expect_eq 'an exact length selects exactly that boundary' 'four' "$out"
expect_eq 'exact-length dictionary inspection succeeds' '0' "$rc"
expect_eq 'exact-length dictionary inspection keeps stderr clean' '' "$err"

capture env WORDLIST_FILEPATH="$range_dict" JUST_OUTPUT_DICTIONARY=1 \
	"$cli" 1 3-5
expect_eq 'M-N includes both boundaries' $'cat\nfour\nfives' "$out"
expect_eq 'M-N dictionary inspection succeeds' '0' "$rc"

capture env WORDLIST_FILEPATH="$range_dict" JUST_OUTPUT_DICTIONARY=1 \
	"$cli" 1 3..5
expect_eq 'M..N has the same inclusive classifier as M-N' \
	$'cat\nfour\nfives' "$out"
expect_eq 'M..N dictionary inspection succeeds' '0' "$rc"

capture env WORDLIST_FILEPATH="$range_dict" JUST_OUTPUT_DICTIONARY=1 \
	"$cli" --british 1 3-5 --no-proper-nouns
expect_eq 'options parse before and after positional arguments' \
	$'cat\nfour\nfives' "$out"
expect_eq 'mixed option order succeeds' '0' "$rc"

capture env WORDLIST_FILEPATH="$range_dict" JUST_OUTPUT_DICTIONARY=1 \
	"$cli" --british -- 1 3-5
expect_eq '-- terminates option parsing without changing positionals' \
	$'cat\nfour\nfives' "$out"
expect_eq '-- terminator succeeds' '0' "$rc"

proper_dict="$scratch/proper-nouns.txt"
printf 'Apple\nMcDonald\nNASA\nA\niPhone\nlower\n' >"$proper_dict"
capture env WORDLIST_FILEPATH="$proper_dict" JUST_OUTPUT_DICTIONARY=1 \
	"$cli" --no-proper-nouns 1 1-20
expect_eq '--no-proper-nouns classifies the complete mixed-case set' \
	$'NASA\nA\niPhone\nlower' "$out"
expect_eq 'proper-noun filtering succeeds' '0' "$rc"
expect_eq 'proper-noun filtering keeps stderr clean' '' "$err"

dirty_dict="$scratch/dirty.txt"
printf 'alpha\nalpha\ntwo words\nbravo' >"$dirty_dict"
capture env WORDLIST_FILEPATH="$dirty_dict" JUST_OUTPUT_DICTIONARY=1 \
	"$cli" 1 1-20
expect_eq 'dictionary records are deduplicated and whitespace records rejected' \
	$'alpha\nbravo' "$out"
expect_eq 'an unterminated final dictionary record is retained' '0' "$rc"

utf8_dict="$scratch/utf8.txt"
printf 'éé\nbbb\n' >"$utf8_dict"
capture env WORDLIST_FILEPATH="$utf8_dict" JUST_OUTPUT_DICTIONARY=1 \
	"$cli" 1 2
expect_eq 'dictionary length is measured in UTF-8 code points' 'éé' "$out"
expect_eq 'UTF-8 dictionary inspection succeeds' '0' "$rc"

invalid_cases=(
	'0'
	'words'
	'1 0'
	'1 6-3'
	'1 3..'
	'1 3...5'
	'1 3-5 extra'
	'1 3 5'
	'1 --unknown'
)
invalid_failures=0
for invalid_case in "${invalid_cases[@]}"; do
	# shellcheck disable=SC2086 # each fixture intentionally expands to argv
	capture env WORDLIST_FILEPATH="$range_dict" "$cli" $invalid_case
	if [[ "$rc" != 2 || -n "$out" || ! "$err" =~ [Ee]rror ]]; then
		printf 'FAIL invalid argument fixture %q: rc=%s out=%q err=%q\n' \
			"$invalid_case" "$rc" "$out" "$err" >&2
		((invalid_failures++))
	fi
done
((tests++))
if ((invalid_failures > 0)); then
	printf 'FAIL invalid argument classifier: %d of %d fixtures failed\n' \
		"$invalid_failures" "${#invalid_cases[@]}" >&2
	((fails++))
fi

capture env RANDOMPASSDICT_CORE="$core_module" luajit -e '
	local core = dofile(os.getenv("RANDOMPASSDICT_CORE"))
	local fixtures = {
		{nil, "british"}, {"C", "british"}, {"POSIX", "british"},
		{"C.UTF-8", "british"}, {"en_US.UTF-8", "american"},
		{"en-US", "american"}, {"de_US.UTF-8", "american"},
		{"English_United States.1252", "american"},
		{"en_GB.UTF-8", "british"}, {"fr_FR.UTF-8", "british"}
	}
	for _, fixture in ipairs(fixtures) do
		local got = core.variant_for_locale(fixture[1])
		if got ~= fixture[2] then
			error(string.format("%s => %s, wanted %s",
			tostring(fixture[1]), got, fixture[2]))
		end
	end
	local parsed, parse_error = core.parse_args({
		"--american", "2", "3..7", "--british", "--no-proper-nouns"
	})
	assert(parsed, parse_error)
	io.write(parsed.variant, " ", parsed.minimum, " ", parsed.maximum,
		" ", tostring(parsed.no_proper_nouns))
'
expect_eq 'pure locale and option classifiers cover the complete fixture sets' \
	'british 3 7 true' "$out"
expect_eq 'pure classifier fixture succeeds' '0' "$rc"
expect_eq 'pure classifier fixture keeps stderr clean' '' "$err"

# The bundled corpora form an external oracle for the variant switch. These
# checks classify both spellings in both modes, so mere presence of one token
# cannot make a broken union of both dictionaries pass.
env -u WORDLIST_FILEPATH JUST_OUTPUT_DICTIONARY=1 \
	"$cli" --american 1 5-6 >"$scratch/american.out" 2>"$scratch/american.err"
american_rc=$?
expect_eq 'American corpus inspection succeeds' '0' "$american_rc"
expect_eq 'American corpus inspection keeps stderr clean' '' \
	"$(cat "$scratch/american.err")"
expect_true 'American corpus contains color' file_has_line color "$scratch/american.out"
expect_true 'American corpus contains center' file_has_line center "$scratch/american.out"
expect_false 'American corpus excludes colour' file_has_line colour "$scratch/american.out"
expect_false 'American corpus excludes centre' file_has_line centre "$scratch/american.out"

env -u WORDLIST_FILEPATH JUST_OUTPUT_DICTIONARY=1 \
	"$cli" --british 1 5-6 >"$scratch/british.out" 2>"$scratch/british.err"
british_rc=$?
expect_eq 'British corpus inspection succeeds' '0' "$british_rc"
expect_eq 'British corpus inspection keeps stderr clean' '' \
	"$(cat "$scratch/british.err")"
expect_true 'British corpus contains colour' file_has_line colour "$scratch/british.out"
expect_true 'British corpus contains centre' file_has_line centre "$scratch/british.out"
expect_false 'British corpus excludes color' file_has_line color "$scratch/british.out"
expect_false 'British corpus excludes center' file_has_line center "$scratch/british.out"

env -u WORDLIST_FILEPATH LC_ALL=C JUST_OUTPUT_DICTIONARY=1 \
	"$cli" 1 5-6 >"$scratch/locale-default.out" 2>"$scratch/locale-default.err"
locale_default_rc=$?
expect_eq 'C locale default corpus inspection succeeds' '0' "$locale_default_rc"
expect_eq 'C locale default corpus inspection keeps stderr clean' '' \
	"$(cat "$scratch/locale-default.err")"
expect_true 'C locale defaults to the British corpus' \
	file_has_line colour "$scratch/locale-default.out"
expect_false 'C locale default does not merge the American corpus' \
	file_has_line color "$scratch/locale-default.out"

printf 'alpha\nbravo\n' >"$scratch/two-words.txt"
capture env WORDLIST_FILEPATH="$scratch/two-words.txt" "$cli" 200 5
expect_eq 'large passphrase generation succeeds' '0' "$rc"
expect_eq 'sampling with replacement emits the requested word count' '200' \
	"$(wc -w <<<"$out" | tr -d ' ')"
unexpected_word=''
for sampled_word in $out; do
	case "$sampled_word" in
		alpha | bravo) ;;
		*) unexpected_word="$sampled_word"; break ;;
	esac
done
expect_eq 'every sampled word belongs to the filtered pool' '' "$unexpected_word"
plain_large_err="$(tr -d ',' <<<"$err")"
expect_match 'combination count remains exact beyond machine integers' \
	'1606938044258990275541962092341162602522202993782792835301376 possible combinations' \
	"$plain_large_err"
expect_match 'entropy is reported directly in bits' \
	'200\.000 bits of entropy' "$plain_large_err"

capture env WORDLIST_FILEPATH="$scratch/two-words.txt" RANDOM_SOURCE=/dev/null \
	"$cli" 1 5
expect_eq 'ambient RANDOM_SOURCE cannot replace /dev/urandom' '0' "$rc"
expect_match 'ambient override still yields one pool member' \
	'^(alpha|bravo)$' "$out"

capture env WORDLIST_FILEPATH="$scratch/missing-dictionary" "$cli" 1 5
expect_eq 'a missing custom dictionary fails closed' '1' "$rc"
expect_eq 'a missing dictionary emits no passphrase' '' "$out"
expect_match 'a missing dictionary diagnostic names its path' \
	'missing-dictionary' "$err"

printf 'Apple\n' >"$scratch/only-proper.txt"
capture env WORDLIST_FILEPATH="$scratch/only-proper.txt" "$cli" \
	--no-proper-nouns 1 1-20
expect_eq 'an empty filtered pool fails closed' '1' "$rc"
expect_eq 'an empty filtered pool emits no passphrase' '' "$out"
expect_match 'an empty pool has a specific diagnostic' \
	'no usable words' "$err"

if ((fails == 0)); then
	printf 'All %d randompassdict tests passed\n' "$tests"
fi
exit "$fails"
