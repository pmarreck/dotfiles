#!/usr/bin/env bash

test_run_test_suite() {
	local fails=0
	local tests=0
	local actual
	local output
	local compatibility_runner
	local bash_bin
	local top_level_runner
	local runner
	local tmpdir

	runner="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/run_test_suite"
	bash_bin="$(type -P bash)"
	compatibility_runner="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/test_dotfiles"
	top_level_runner="$(dirname "$(dirname "$runner")")/test"
	tmpdir=$(mktemp -d --tmpdir run_test_suite_test.XXXXXX)
	trap 'rm -rf "$tmpdir"' EXIT

	mkdir -p "$tmpdir/mixed" "$tmpdir/passing" "$tmpdir/structured" "$tmpdir/empty" "$tmpdir/nonexec" "$tmpdir/capped" "$tmpdir/selection" "$tmpdir/home"
	printf '%s\n' "#!$bash_bin" 'printf "fixture pass\\n"' 'exit 0' >"$tmpdir/mixed/a_pass_test"
	printf '%s\n' "#!$bash_bin" 'printf "fixture failure two\\n" >&2' 'exit 2' >"$tmpdir/mixed/b_fail_test"
	printf '%s\n' "#!$bash_bin" 'printf "fixture failure three\\n" >&2' 'exit 3' >"$tmpdir/mixed/c_fail_test"
	printf '%s\n' "#!$bash_bin" 'exit 99' >"$tmpdir/mixed/not-a-test"
	chmod +x "$tmpdir/mixed/a_pass_test" "$tmpdir/mixed/b_fail_test" "$tmpdir/mixed/c_fail_test" "$tmpdir/mixed/not-a-test"

	printf '%s\n' "#!$bash_bin" 'exit 0' >"$tmpdir/passing/pass_test"
	chmod +x "$tmpdir/passing/pass_test"
	# shellcheck disable=SC2016 # Generated fixture expands this at runtime.
	printf '%s\n' "#!$bash_bin" \
		'printf "PASS misleading child assertion\\n"' \
		'[[ -z "${RUN_TEST_SUITE_RESULT_FILE:-}" ]] || printf "forged\\n" >"$RUN_TEST_SUITE_RESULT_FILE"' \
		'exit 0' >"$tmpdir/structured/misleading_test"
	chmod +x "$tmpdir/structured/misleading_test"
	printf '%s\n' "#!$bash_bin" 'exit 0' >"$tmpdir/nonexec/cannot_run_test"
	printf '%s\n' "#!$bash_bin" 'exit 100' >"$tmpdir/capped/a_hundred_test"
	printf '%s\n' "#!$bash_bin" 'exit 200' >"$tmpdir/capped/two_hundred_test"
	chmod +x "$tmpdir/capped/a_hundred_test" "$tmpdir/capped/two_hundred_test"
	for name in a_host_test b_sandbox_test c_host_test; do
		printf '%s\n' "#!$bash_bin" "printf '%s\\n' '$name'" 'exit 0' >"$tmpdir/selection/$name"
		chmod +x "$tmpdir/selection/$name"
	done
	printf '# host-only set\na_host_test\nc_host_test # inline reason\n' >"$tmpdir/host.manifest"
	printf 'a_host_test\na_host_test\n' >"$tmpdir/duplicate.manifest"
	printf 'missing_test\n' >"$tmpdir/stale.manifest"
	printf '../a_host_test\n' >"$tmpdir/escaping.manifest"

	(( tests++ ))
	output=$(HOME="$tmpdir/home" "$runner" --test-dir "$tmpdir/mixed" 2>&1)
	actual=$?
	if [[ "$actual" == 5 && "$output" == *'3 test files'* && "$output" == *'2 of 3 test files failed'* && "$output" != *'not-a-test'* ]]; then
		printf '✓ run_test_suite discovers *_test files and sums failures\n'
	else
		printf '✗ run_test_suite should discover *_test files and return the summed status\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	output=$(HOME="$tmpdir/home" "$runner" --test-dir "$tmpdir/passing" 2>&1)
	actual=$?
	if [[ "$actual" == 0 && "$output" == *'All 1 test files passed'* ]]; then
		printf '✓ run_test_suite reports an all-green suite\n'
	else
		printf '✗ run_test_suite should report an all-green suite\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	result_file="$tmpdir/runner-result"
	output=$(HOME="$tmpdir/home" RUN_TEST_SUITE_RESULT_FILE="$result_file" \
		"$runner" --test-dir "$tmpdir/structured" 2>&1)
	actual=$?
	expected_result=$'run-test-suite-result-v1\nstatus=valid-pass\ntotal=1\npassed=1\nfailed=0\nsummed_status=0'
	if [[ "$actual" == 0 && "$(<"$result_file")" == "$expected_result" \
		&& "$output" == *'PASS misleading child assertion'* ]]; then
		printf '✓ machine result cannot be inflated or forged by child output\n'
	else
		printf '✗ runner must own an exact structured result\nStatus: %s\nOutput: %q\nResult: %q\n' \
			"$actual" "$output" "$(<"$result_file")" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	output=$(HOME="$tmpdir/home" RUN_TEST_SUITE_RESULT_FILE="$result_file" \
		"$runner" --test-dir "$tmpdir/mixed" 2>&1)
	actual=$?
	expected_result=$'run-test-suite-result-v1\nstatus=failed\ntotal=3\npassed=1\nfailed=2\nsummed_status=5'
	if [[ "$actual" == 5 && "$(<"$result_file")" == "$expected_result" ]]; then
		printf '✓ machine result records exact failing-suite totals\n'
	else
		printf '✗ failing suite must write its exact structured result\nStatus: %s\nOutput: %q\nResult: %q\n' \
			"$actual" "$output" "$(<"$result_file")" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	report="$tmpdir/progress-report"
	progress="$tmpdir/progress-live"
	HOME="$tmpdir/home" RUN_TEST_SUITE_PROGRESS_FD=3 "$runner" \
		--test-dir "$tmpdir/passing" >"$report" 2>&1 3>"$progress"
	actual=$?
	if [[ "$actual" == 0 ]] \
		&& grep -q '^started \[1/1\]: pass_test$' "$progress" \
		&& grep -q '^completed \[1/1\]: pass_test (exit 0)$' "$progress" \
		&& ! grep -qE '^(started|completed) ' "$report"; then
		printf '✓ run_test_suite exposes live progress separately from its report\n'
	else
		printf '✗ live progress must use its dedicated fd\nStatus: %s\nReport: %q\nProgress: %q\n' \
			"$actual" "$(<"$report")" "$(<"$progress")" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	output=$(env -u RUN_TEST_SUITE_JOBS HOME="$tmpdir/home" "$runner" --test-dir "$tmpdir/passing" 2>&1)
	actual=$?
	if [[ "$actual" == 0 && "$output" == *'(jobs: 16)'* ]]; then
		printf '✓ run_test_suite uses the measured 16-worker default\n'
	else
		printf '✗ default run should report 16 workers\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	output=$(HOME="$tmpdir/home" "$runner" --test-dir "$tmpdir/empty" 2>&1)
	actual=$?
	if [[ "$actual" == 2 && "$output" == *'No test files found'* ]]; then
		printf '✓ run_test_suite rejects an empty suite\n'
	else
		printf '✗ run_test_suite should reject an empty suite\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	output=$(HOME="$tmpdir/home" "$runner" --test-dir "$tmpdir/nonexec" 2>&1)
	actual=$?
	if [[ "$actual" == 126 && "$output" == *'not executable'* ]]; then
		printf '✓ run_test_suite rejects non-executable test files\n'
	else
		printf '✗ run_test_suite should reject non-executable test files\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	output=$(HOME="$tmpdir/home" "$runner" --test-dir "$tmpdir/capped" 2>&1)
	actual=$?
	if [[ "$actual" == 255 && "$output" == *'summed exit status: 300'* ]]; then
		printf '✓ run_test_suite caps overflowing process exit statuses\n'
	else
		printf '✗ run_test_suite should report the exact sum and cap its process status\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	output=$(HOME="$tmpdir/home" "$runner" --help 2>&1)
	actual=$?
	if [[ "$actual" == 0 && "$output" == *'Usage: run_test_suite'* && "$output" == *'--test'* ]]; then
		printf '✓ run_test_suite documents its CLI\n'
	else
		printf '✗ run_test_suite should document its CLI\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	output=$(HOME="$tmpdir/home" "$compatibility_runner" --test-dir "$tmpdir/passing" 2>&1)
	actual=$?
	if [[ "$actual" == 0 && "$output" == *'All 1 test files passed'* ]]; then
		printf '✓ test_dotfiles forwards to run_test_suite\n'
	else
		printf '✗ test_dotfiles should forward to run_test_suite\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	output=$(HOME="$tmpdir/home" "$top_level_runner" --test-dir "$tmpdir/passing" 2>&1)
	actual=$?
	if [[ "$actual" == 0 && "$output" == *'All 1 test files passed'* ]]; then
		printf '✓ ./test runs the complete-suite runner\n'
	else
		printf '✗ ./test should forward to run_test_suite\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	# ── Parallel execution must not weaken any of the guarantees above ──────────
	# Running tests concurrently is only safe if it changes wall-clock time and
	# nothing else: the same files must be discovered, the exit status must still
	# be the exact sum capped at 255, and the report must not reorder itself run
	# to run (a report whose order depends on which test happened to finish first
	# is unreviewable in a diff).

	(( tests++ ))
	output=$(HOME="$tmpdir/home" "$runner" --jobs 4 --test-dir "$tmpdir/capped" 2>&1)
	actual=$?
	if [[ "$actual" == 255 && "$output" == *'summed exit status: 300'* ]]; then
		printf '✓ run_test_suite preserves the capped exit sum when parallel\n'
	else
		printf '✗ parallel run must report sum 300 and exit 255\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	serial_report=$(HOME="$tmpdir/home" "$runner" --jobs 1 --test-dir "$tmpdir/mixed" 2>&1 | grep -E '^(PASS|FAIL) ')
	par_report=$(HOME="$tmpdir/home" "$runner" --jobs 4 --test-dir "$tmpdir/mixed" 2>&1 | grep -E '^(PASS|FAIL) ')
	if [[ -n "$serial_report" && "$serial_report" == "$par_report" ]]; then
		printf '✓ run_test_suite reports identically regardless of job count\n'
	else
		printf '✗ parallel report differs from serial\nSerial: %q\nParallel: %q\n' "$serial_report" "$par_report" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	par_a=$(HOME="$tmpdir/home" "$runner" --jobs 4 --test-dir "$tmpdir/mixed" 2>&1 | grep -E '^(PASS|FAIL) ')
	par_b=$(HOME="$tmpdir/home" "$runner" --jobs 4 --test-dir "$tmpdir/mixed" 2>&1 | grep -E '^(PASS|FAIL) ')
	if [[ "$par_a" == "$par_b" ]]; then
		printf '✓ parallel report ordering is deterministic across runs\n'
	else
		printf '✗ parallel report ordering varies between runs\nRun A: %q\nRun B: %q\n' "$par_a" "$par_b" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	output=$(HOME="$tmpdir/home" "$runner" --jobs 0 --test-dir "$tmpdir/passing" 2>&1)
	actual=$?
	if (( actual != 0 )) && [[ "$output" == *'--jobs'* ]]; then
		printf '✓ run_test_suite rejects a nonsensical job count\n'
	else
		printf '✗ --jobs 0 should be rejected\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	output=$(HOME="$tmpdir/home" "$runner" --test-dir "$tmpdir/selection" --manifest "$tmpdir/host.manifest" 2>&1)
	actual=$?
	if [[ "$actual" == 0 && "$output" == *'All 2 test files passed'* && "$output" == *'PASS a_host_test'* && "$output" == *'PASS c_host_test'* && "$output" != *'PASS b_sandbox_test'* ]]; then
		printf '✓ manifest mode runs exactly the declared test set\n'
	else
		printf '✗ manifest mode selected the wrong test set\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	(( tests++ ))
	output=$(HOME="$tmpdir/home" "$runner" --test-dir "$tmpdir/selection" --exclude-manifest "$tmpdir/host.manifest" 2>&1)
	actual=$?
	if [[ "$actual" == 0 && "$output" == *'All 1 test files passed'* && "$output" == *'PASS b_sandbox_test'* && "$output" != *'PASS a_host_test'* && "$output" != *'PASS c_host_test'* ]]; then
		printf '✓ exclusion mode runs the exact complement of the same manifest\n'
	else
		printf '✗ exclusion mode did not select the manifest complement\nStatus: %s\nOutput: %q\n' "$actual" "$output" >&2
		(( fails++ ))
	fi

	for bad_manifest in duplicate stale escaping; do
		(( tests++ ))
		output=$(HOME="$tmpdir/home" "$runner" --test-dir "$tmpdir/selection" --manifest "$tmpdir/$bad_manifest.manifest" 2>&1)
		actual=$?
		case "$bad_manifest" in
			duplicate) expected_diagnostic='duplicate manifest entry' ;;
			stale) expected_diagnostic='stale manifest entry' ;;
			escaping) expected_diagnostic='invalid manifest entry' ;;
		esac
		if (( actual != 0 )) && [[ "$output" == *"$expected_diagnostic"* ]]; then
			printf '✓ %s manifest is rejected\n' "$bad_manifest"
		else
			printf '✗ %s manifest should fail closed\nStatus: %s\nOutput: %q\n' "$bad_manifest" "$actual" "$output" >&2
			(( fails++ ))
		fi
	done

	if (( fails > 0 )); then
		printf '%s of %s run_test_suite tests failed!\n' "$fails" "$tests" >&2
	else
		printf 'All %s run_test_suite tests passed!\n' "$tests"
	fi
	return "$fails"
}

test_run_test_suite
