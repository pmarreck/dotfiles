#!/usr/bin/env bash
# Tests for the get-all-git-stati command and get_all_git_stati function.
# Exit code == number of failing tests.

make_repo_with_remote() {
	local dir="$1" remote="$2"
	mkdir -p "$dir"
	git init -q --bare "$remote"
	(
		cd "$dir" && \
		git init -q -b main && \
		echo hello > a && \
		git add a && \
		git -c user.email=t@t -c user.name=t commit -q -m init && \
		git remote add origin "$remote" && \
		git push -q origin main
	)
}

GAGS="$HOME/dotfiles/bin/get-all-git-stati"

FIXT=$(mktemp -d "${TMPDIR:-/tmp}/getallgitstati_test.XXXXXX")
REMOTES=$(mktemp -d "${TMPDIR:-/tmp}/getallgitstati_remotes.XXXXXX")
DIRTY=$(mktemp -d "${TMPDIR:-/tmp}/getallgitstati_dirty.XXXXXX")
EMPTY=$(mktemp -d "${TMPDIR:-/tmp}/getallgitstati_empty.XXXXXX")
DEFAULT_HOME=$(mktemp -d "${TMPDIR:-/tmp}/getallgitstati_home.XXXXXX")
SECOND_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/get all git stati second.XXXXXX")
trap 'rm -rf "$FIXT" "$REMOTES" "$DIRTY" "$EMPTY" "$DEFAULT_HOME" "$SECOND_ROOT"' EXIT

make_repo_with_remote "$FIXT/alpha" "$REMOTES/alpha.git" >/dev/null 2>&1
make_repo_with_remote "$FIXT/beta"  "$REMOTES/beta.git"  >/dev/null 2>&1
make_repo_with_remote "$DIRTY/gamma" "$REMOTES/gamma.git" >/dev/null 2>&1
make_repo_with_remote "$DEFAULT_HOME/Code/defaulted" "$REMOTES/defaulted.git" >/dev/null 2>&1
make_repo_with_remote "$DEFAULT_HOME/not-code/excluded" "$REMOTES/excluded.git" >/dev/null 2>&1
make_repo_with_remote "$SECOND_ROOT/path with spaces" "$REMOTES/spaces.git" >/dev/null 2>&1
echo "modified content" > "$DIRTY/gamma/a"

fails=0
tests=0

# Test 1: output contains each repo path
((tests++))
echo "Testing: finds and prints each repo path under start_dir..."
out=$("$GAGS" --root "$FIXT" 2>/dev/null)
if [[ "$out" == *"$FIXT/alpha"* ]] && [[ "$out" == *"$FIXT/beta"* ]]; then
	echo "✓ Test passed: both repos appear in output"
else
	echo "✗ Test failed: expected both repo paths in output" >&2
	echo "  Output: $out" >&2
	((fails++))
fi

# Test 2: no fetch-upstream warnings when remotes are valid
((tests++))
echo "Testing: no 'Failed to fetch upstream' warning with valid local remotes..."
out=$("$GAGS" --root "$FIXT" 2>&1)
if [[ "$out" != *"Failed to fetch upstream"* ]]; then
	echo "✓ Test passed: no fetch warning"
else
	echo "✗ Test failed: unexpected fetch warning" >&2
	echo "  Output: $out" >&2
	((fails++))
fi

# Test 3: dirty worktree shows shortstat brackets in output
((tests++))
echo "Testing: uncommitted changes produce a shortstat annotation..."
out=$("$GAGS" --root "$DIRTY" 2>/dev/null)
if [[ "$out" == *"$DIRTY/gamma"* ]] && \
   { [[ "$out" == *"insertion"* ]] || [[ "$out" == *"file changed"* ]] || [[ "$out" == *"deletion"* ]]; }; then
	echo "✓ Test passed: shortstat present for dirty repo"
else
	echo "✗ Test failed: no shortstat in output" >&2
	echo "  Output: $out" >&2
	((fails++))
fi

# Test 4: empty dir produces no stdout
((tests++))
echo "Testing: empty start_dir produces no output..."
out=$("$GAGS" --root "$EMPTY" 2>/dev/null)
if [[ -z "$out" ]]; then
	echo "✓ Test passed: empty dir produces no output"
else
	echo "✗ Test failed: expected empty output, got: $out" >&2
	((fails++))
fi

# Test 5: no roots defaults to ~/Code, never bare $HOME
((tests++))
echo "Testing: default root is HOME/Code only..."
out=$(HOME="$DEFAULT_HOME" "$GAGS" 2>/dev/null)
if [[ "$out" == *"$DEFAULT_HOME/Code/defaulted"* ]] && [[ "$out" != *"$DEFAULT_HOME/not-code/excluded"* ]]; then
	echo "✓ Test passed: default scan is scoped to HOME/Code"
else
	echo "✗ Test failed: default scan escaped HOME/Code or missed its repo" >&2
	echo "  Output: $out" >&2
	((fails++))
fi

# Test 6: --root is repeatable and preserves spaces
((tests++))
echo "Testing: repeatable --root preserves path boundaries..."
out=$("$GAGS" --root "$FIXT" --root "$SECOND_ROOT" 2>/dev/null)
if [[ "$out" == *"$FIXT/alpha"* ]] && [[ "$out" == *"$SECOND_ROOT/path with spaces"* ]]; then
	echo "✓ Test passed: both roots and spaced paths appear"
else
	echo "✗ Test failed: repeatable roots were not scanned independently" >&2
	echo "  Output: $out" >&2
	((fails++))
fi

# Test 7: help documents the actual option
((tests++))
echo "Testing: --help documents repeatable --root..."
out=$("$GAGS" --help 2>&1)
if [[ "$out" == *"--root ROOT"* ]] && [[ "$out" == *"repeatable"* ]]; then
	echo "✓ Test passed: help documents --root"
else
	echo "✗ Test failed: --help is missing the --root contract" >&2
	((fails++))
fi

# Test 8: about is a one-line description
((tests++))
echo "Testing: --about is one line..."
out=$("$GAGS" --about 2>&1)
if [[ -n "$out" && "$out" != *$'\n'* ]]; then
	echo "✓ Test passed: --about is one line"
else
	echo "✗ Test failed: --about is empty or multiline" >&2
	((fails++))
fi

# Summary
if [[ $fails -eq 0 ]]; then
	echo "All $tests tests passed"
else
	echo "$fails of $tests tests failed" >&2
fi
exit $fails
