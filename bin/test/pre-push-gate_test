#!/usr/bin/env bash
# pre-push-gate_test — pushes verify evidence and never launch tests.
# The explicit legacy check route delegates to the unified ./test entry point.

set -u
# shellcheck disable=SC2016 # Generated adapters expand fixture variables at runtime.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
SOURCE_GATE="$repo_root/bin/pre-push-gate"

tests=0
fails=0
ok()   { echo "✓ $1"; }
bad()  { { echo "✗ $1"; shift; [ $# -gt 0 ] && printf '  %s\n' "$@"; } >&2; ((fails++)) || :; }

WORK=$(mktemp -d --tmpdir pre_push_gate_test.XXXXXX)
trap 'rm -rf "$WORK"' EXIT

hook_root="$WORK/hook-root"
mkdir -p "$hook_root/bin"
cp "$SOURCE_GATE" "$hook_root/bin/pre-push-gate"
GATE="$hook_root/bin/pre-push-gate"
push_log="$WORK/push-evidence-input"
host_log="$WORK/host-evidence-argv"
{
	printf '#!%s\n' "$BASH"
	# shellcheck disable=SC2016 # Generated adapter expands this at runtime.
	printf 'cat > "$PUSH_EVIDENCE_LOG"\n'
	# shellcheck disable=SC2016 # Generated adapter expands this at runtime.
	printf 'exit "${PUSH_EVIDENCE_STATUS:-0}"\n'
} >"$hook_root/bin/git-push-evidence"
{
	printf '#!%s\n' "$BASH"
	# shellcheck disable=SC2016 # Generated adapter expands this at runtime.
	printf 'printf "%%s\\n" "$*" >> "$HOST_EVIDENCE_LOG"\n'
	# shellcheck disable=SC2016 # Generated adapter expands this at runtime.
	printf 'exit "${HOST_EVIDENCE_STATUS:-0}"\n'
} >"$hook_root/bin/dotfiles-host-evidence"
chmod +x "$hook_root/bin/pre-push-gate" "$hook_root/bin/git-push-evidence" \
	"$hook_root/bin/dotfiles-host-evidence"

# ── "Nothing to push" must not run the suite ──────────────────────────────────
# Running 160 tests to push zero commits is not just slow, it is a meaningless
# gate: there is no new code to validate. Git contacts the remote BEFORE calling
# pre-push and feeds the hook "<local ref> <local sha> <remote ref> <remote sha>"
# on stdin, where remote sha is the freshly negotiated remote state — so this
# decision needs no fetch of our own.
# Tested in BOTH directions: a gate that always skipped would pass the first
# assertion and is caught by the second.
_marker="$WORK/runner_ran"
forbidden_runner="$hook_root/test"
printf '#!%s\nprintf "ran\\n" >%q\nexit 99\n' "$BASH" "$_marker" >"$forbidden_runner"
chmod +x "$forbidden_runner"
_hook_gate() { # $1=local sha $2=remote sha ; echoes exit code
	printf 'refs/heads/master %s refs/heads/master %s\n' "$1" "$2" \
		| PUSH_EVIDENCE_LOG="$push_log" HOST_EVIDENCE_LOG="$host_log" \
		"$GATE" origin https://example.invalid/repository.git >/dev/null 2>&1
	printf '%s' "$?"
}
_same=1111111111111111111111111111111111111111
_diff=2222222222222222222222222222222222222222

((tests++))
rm -f "$_marker"
rm -f "$push_log" "$host_log"
rc=$(_hook_gate "$_same" "$_same")
if [ "$rc" = 0 ] && [ ! -e "$_marker" ] && [ -s "$push_log" ] && [ ! -e "$host_log" ]; then
	ok "nothing to push → suite skipped entirely"
else
	bad "an up-to-date ref must skip the suite and pass" \
		"exit=$rc  runner_invoked=$([ -e "$_marker" ] && echo yes || echo no)"
fi

((tests++))
rm -f "$_marker"
rm -f "$push_log" "$host_log"
rc=$(PUSH_EVIDENCE_STATUS=19 _hook_gate "$_diff" "$_same")
if [ ! -e "$_marker" ] && [ "$rc" = 19 ] && [ -s "$push_log" ] && [ ! -e "$host_log" ]; then
	ok "commits without evidence are refused without running the suite"
else
	bad "push must verify cached evidence, never launch the suite" "exit=$rc"
fi

((tests++))
rm -f "$_marker" "$push_log" "$host_log"
rc=$(_hook_gate "$_diff" "$_same")
expected_update="refs/heads/master $_diff refs/heads/master $_same"
expected_host="--verify $hook_root $_diff"
if [ "$rc" = 0 ] && [ ! -e "$_marker" ] \
	&& [ "$(cat "$push_log")" = "$expected_update" ] \
	&& [ "$(cat "$host_log")" = "$expected_host" ]; then
	ok "changed tips verify both cached evidence classes without running tests"
else
	bad "changed tips did not verify the exact cached evidence set" "exit=$rc"
fi

# ── Legacy explicit-check mode delegates to the one complete entry point ─────
# Exercise a disposable copy so compatibility cannot run the live suite.
default_root="$WORK/default-runner-repo"
mkdir -p "$default_root/bin"
cp "$GATE" "$default_root/bin/pre-push-gate"
entry_log="$WORK/test-entry-argv"
# shellcheck disable=SC2016 # Generated fixture expands these at runtime.
{
	printf '#!%s\n' "$BASH"
	printf ': > "$TEST_ENTRY_LOG"\n'
	printf 'for argument in "$@"; do printf "%%s\\n" "$argument" >> "$TEST_ENTRY_LOG"; done\n'
	printf 'exit "${TEST_ENTRY_STATUS:-0}"\n'
} > "$default_root/test"
chmod +x "$default_root/bin/pre-push-gate" "$default_root/test"

((tests++))
TEST_ENTRY_LOG="$entry_log" "$default_root/bin/pre-push-gate" --check-only >/dev/null 2>&1
rc=$?
if [ "$rc" = 0 ] && [ -f "$entry_log" ] && [ ! -s "$entry_log" ]; then
	ok "--check-only delegates to the unified ./test entry point"
else
	bad "--check-only bypassed the unified ./test entry point" "exit=$rc"
fi

((tests++))
TEST_ENTRY_LOG="$entry_log" TEST_ENTRY_STATUS=23 \
	"$default_root/bin/pre-push-gate" --check-only >/dev/null 2>&1
rc=$?
if [ "$rc" = 23 ]; then
	ok "--check-only preserves the unified entry point failure"
else
	bad "--check-only lost the unified entry point status" "exit=$rc"
fi

echo
if [ "$fails" -eq 0 ]; then
	echo "All $tests pre-push-gate tests passed"
else
	echo "$fails of $tests pre-push-gate tests failed" >&2
fi
exit "$fails"
