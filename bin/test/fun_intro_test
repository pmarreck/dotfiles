#!/usr/bin/env bash
# check() evaluates its condition string, so single-quoted expansions and
# variables read only there are intended.
# shellcheck disable=SC2016,SC2034
# fun_intro_test: the LuaJIT intro's command line, pick registry, pools, and
# mandelbash memo. Picks themselves are checked against their Bash
# originals in fun_intro_text_test, fun_intro_image_test, and
# fun_intro_terminal_test.
set -u

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
work=$(mktemp -d "${TMPDIR:-/tmp}/fun_intro_test.XXXXXX") || exit 1
trap 'command rm -rf -- "$work"' EXIT
luajit_bin=$(command -v luajit) || { printf 'FAIL: luajit is not on PATH\n' >&2; exit 1; }
drive() { LUA_PATH="$root/lib/?.lua;;" "$luajit_bin" "$root/bin/test/fixtures/fun_intro/drive.lua" "$@"; }

tests=0
fails=0
pass() { ((tests++)) || :; printf 'PASS: %s\n' "$1"; }
fail() { ((tests++)) || :; ((fails++)) || :; printf 'FAIL: %s\n' "$1" >&2; }
check() { if eval "$2"; then pass "$1"; else fail "$1"; fi; }

# A private cache and a stub fortune: fortune is not part of the suite's tools.
mkdir -p "$work/stub" "$work/cache"
printf '#!/bin/sh\nprintf "FORTUNE-STUB\\n"\n' >"$work/stub/fortune"
chmod +x "$work/stub/fortune"
intro() { env XDG_CACHE_HOME="$work/cache" PATH="$work/stub:$PATH" "$root/bin/fun_intro" "$@"; }

# The pools, frozen from the Bash version's lists.
text_pool='fortune warhammer_quote bashorg_quote chuck mandelbash asciidragon just_one_taoup times_older_than_samson'
image_pool='inthebeginning'

# --- Command line ---
result=$(intro --help 2>&1)
check '--help prints usage' '[[ $? == 0 && "$result" == *"--pick=NAME"* ]]'
result=$(intro --bogus 2>&1)
status=$?
check 'an unknown argument exits 2' '[[ $status == 2 && "$result" == *"unknown arg: --bogus"* ]]'
result=$(intro --pick=nope 2>&1)
status=$?
check 'an unknown pick exits 127' '[[ $status == 127 && "$result" == *"unknown pick"* ]]'

# --- Every pick runs by name ---
for name in $text_pool $image_pool; do
	result=$(DISPLAY_IMAGE_FORCE_PROTOCOL=kitty intro --pick="$name" 2>"$work/err")
	status=$?
	check "--pick=$name prints its pick" '[[ $status == 0 && -n "$result" && ! -s "$work/err" ]]'
done
result=$(intro --pick=fortune)
check '--pick=fortune runs the fortune on PATH' '[[ "$result" == FORTUNE-STUB ]]'
result=$(env PATH="$work/empty" "$luajit_bin" "$root/bin/fun_intro" --pick=fortune 2>&1)
status=$?
check 'a missing fortune is reported, not hidden' \
	'[[ $status == 1 && "$result" == *"Tried to call '"'"'fortune'"'"', but it was not defined"* ]]'

# --- The registry matches the pools and the standalone commands ---
registry=$(LUA_PATH="$root/lib/?.lua;;" "$luajit_bin" -e 'local p = require("fun_intro.picks")
	print(table.concat(p.TEXT, " ")); print(table.concat(p.IMAGE, " "))' /dev/null)
check 'the registry pools match the Bash version' '[[ "$registry" == "$text_pool"$'"'"'\n'"'"'"$image_pool" ]]'
missing=''
for name in $text_pool $image_pool; do
	case $name in fortune | mandelbash) continue ;; esac
	grep -q "pick_command(\"$name\"" "$root/bin/$name" 2>/dev/null || missing+=" $name"
done
check 'each LuaJIT pick has a standalone command of the same name' '[[ -z "$missing" ]]' ||
	printf '  missing:%s\n' "$missing" >&2
strays=''
while IFS= read -r command_file; do
	name=$(sed -n 's/.*pick_command("\([^"]*\)".*/\1/p' "$command_file")
	[[ " $text_pool $image_pool " == *" $name "* && "$(basename "$command_file")" == "$name" ]] || strays+=" $command_file"
done < <(grep -l -s 'fun_intro.cli").pick_command(' "$root"/bin/*)
check 'every standalone pick command names a registered pick' '[[ -z "$strays" ]]'

# --- Random choice draws from the right pool ---
pool_names() { grep -o "^Running '[a-z_]*' from fun_intro" | sed "s/^Running '\([a-z_]*\)'.*/\1/" | tr '\n' ' '; }
read -ra text_names <<<"$text_pool"
result=$(drive choose false "$root" "${#text_names[@]}" | pool_names)
check 'without image support, the random source chooses among the text picks only' '[[ "$result" == "$text_pool " ]]'
result=$(drive choose true "$root" "$((${#text_names[@]} + 1))" | pool_names)
check 'with image support, the image picks join the pool' '[[ "$result" == "$text_pool $image_pool " ]]'
escapes=0
for ((run = 0; run < 12; run++)); do
	result=$(env -u IMAGE_CAPABLE XDG_CACHE_HOME="$work/cache" PATH="$work/stub:$PATH" "$root/bin/fun_intro") || ((escapes++))
	[[ -n "$result" && "$result" != *$'\033_G'* && "$result" != *$'\033P'* ]] || ((escapes++))
done
check 'random intros succeed and never send image escapes without IMAGE_CAPABLE' '((escapes == 0))'

# --- mandelbash memo ---
memo_dir="$work/cache/dotfiles/fun_intro"
expected_mandel="$work/mandel.expected"
bash "$root/bin/mandelbash" >"$expected_mandel"
intro --pick=mandelbash >"$work/mandel.1"
intro --pick=mandelbash >"$work/mandel.2"
mapfile -t memo_files < <(find "$memo_dir" -type f)
check 'mandelbash output is the script'"'"'s output, first and memoized' \
	'cmp -s "$expected_mandel" "$work/mandel.1" && cmp -s "$expected_mandel" "$work/mandel.2"'
check 'the memo is one file keyed by the script hash, with no temporary leftovers' \
	'[[ ${#memo_files[@]} == 1 && "${memo_files[0]##*/}" =~ ^mandelbash\.[0-9a-f]{16}$ ]]'
printf 'MEMO-MARKER\n' >"${memo_files[0]}"
result=$(intro --pick=mandelbash)
check 'a memoized render is replayed without running the script' '[[ "$result" == MEMO-MARKER ]]'

printf '#!/bin/sh\nprintf "ok\\n"\n' >"$work/ok.sh"
printf '#!/bin/sh\nprintf "partial"\nexit 3\n' >"$work/bad.sh"
chmod +x "$work/ok.sh" "$work/bad.sh"
drive mandel "$work" >"$work/mandel.out"
cat >"$work/mandel.want" <<'WANT'
render 1
render 1
render 2
nil mandelbash failed with status 3
runs=3 files=2
WANT
printf 'real failure: nil mandelbash failed with status 3\nunwritable cache: ok\n' >>"$work/mandel.want"
check 'the memo renders once per script version and never stores a failed render' \
	'cmp -s "$work/mandel.want" "$work/mandel.out"' || diff "$work/mandel.want" "$work/mandel.out" >&2
check 'a failed real render leaves no cache file behind' '[[ ! -e "$work/bad-cache" || -z "$(find "$work/bad-cache" -type f)" ]]'

if ((fails == 0)); then
	printf 'All %s fun_intro checks passed.\n' "$tests"
else
	printf '%s of %s fun_intro checks failed.\n' "$fails" "$tests" >&2
fi
exit "$fails"
