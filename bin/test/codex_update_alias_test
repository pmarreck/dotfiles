#!/usr/bin/env bash

# Guards the Codex updater aliases and verifies that the updater targets the
# npm installation selected by PATH, not npm's possibly different global prefix.

set -u

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
aliases_file="$repo_root/.aliases"
updater="$repo_root/bin/update-codex"
failures=0

pass() {
	printf 'ok - %s\n' "$1"
}

fail() {
	printf 'not ok - %s\n' "$1" >&2
	failures=$((failures + 1))
}

upgrade_line="$(rg '^alias upgrade_codex=' "$aliases_file")"
update_line="$(rg '^alias update_codex=' "$aliases_file")"

if [[ "$upgrade_line" == *'update-codex'* ]]; then
	pass 'Codex updater delegates to the installation-aware wrapper'
else
	fail 'Codex updater must delegate to update-codex'
fi

if [[ "$update_line" == *'upgrade_codex'* ]]; then
	pass 'update_codex resolves to the same updater as upgrade_codex'
else
	fail 'update_codex must alias upgrade_codex so both names update identically'
fi

work="$(mktemp -d --tmpdir codex_update_alias_test.XXXXXX)"
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/active/bin" "$work/active/lib/node_modules/@openai/codex/bin" "$work/tools"
ln -s ../lib/node_modules/@openai/codex/bin/codex.js "$work/active/bin/codex"
cat >"$work/active/lib/node_modules/@openai/codex/bin/codex.js" <<'EOF'
#!/usr/bin/env bash
printf 'codex-cli fixture\n'
EOF
chmod +x "$work/active/lib/node_modules/@openai/codex/bin/codex.js"
cat >"$work/tools/npm" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" >'$work/npm-args'
EOF
chmod +x "$work/tools/npm"

if PATH="$work/active/bin:$work/tools:$PATH" "$updater" >/dev/null \
	&& grep -Fxq -- '--prefix' "$work/npm-args" \
	&& grep -Fxq -- "$work/active" "$work/npm-args" \
	&& grep -Fxq -- '@openai/codex@latest' "$work/npm-args"; then
	pass 'npm updater targets the Codex prefix selected by PATH'
else
	fail 'npm updater did not target the active Codex installation'
fi

exit "$failures"
