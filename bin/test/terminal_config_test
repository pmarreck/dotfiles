#!/usr/bin/env bash
# Checks which interactive hooks .bashrc loads for three kinds of terminal:
# a standard terminal and VS Code's integrated terminal load them (PS0 set,
# PROMPT_COMMAND normalized through bash-preexec); a VS Code agent shell
# (TERM_PROGRAM=vscode without __vsc_prompt_cmd) skips them.
#
# Each case runs a real login shell in a pane of a private tmux server. The
# probe commands are typed ahead (the pty queues them until bash reads
# input), and the last one signals `tmux wait-for`, so nothing depends on
# how long startup takes. Probe output is assembled at run time
# (PS0_$(...)), so the echoed command text cannot satisfy an assertion.
set -u

if ! command -v tmux >/dev/null 2>&1; then
	echo "terminal_config_test requires tmux" >&2
	exit 1
fi

socket="terminal_config_test_$$"
tm() { tmux -L "${socket}" "$@"; }
trap 'tm kill-server 2>/dev/null' EXIT

# Seconds to wait for a shell to finish its probes before failing.
probe_timeout=60

failures=0

# Starts `bash --login` with the given environment assignments in a fresh
# session, runs the probes, and prints the pane's probe results.
probe_shell() {
	local session="$1"
	shift
	local channel="${session}_done"
	tm new-session -d -s "${session}" -x 200 -y 50 env "$@" bash --login
	tm send-keys -t "${session}" 'echo "PS0_$([[ -n "${PS0:-}" ]] && echo PRESENT || echo MISSING)"' C-m
	tm send-keys -t "${session}" 'echo "PROMPT_$([[ "${PROMPT_COMMAND:-}" == *__bp_* ]] && echo NORMALIZED || echo RAW)"' C-m
	tm send-keys -t "${session}" "tmux -L ${socket} wait-for -S ${channel}" C-m
	if ! timeout "${probe_timeout}" tmux -L "${socket}" wait-for "${channel}"; then
		echo "TIMEOUT"
	fi
	tm capture-pane -t "${session}" -p -S - | grep -E '^(PS0|PROMPT)_[A-Z]+$'
	tm kill-session -t "${session}"
}

# Asserts one case's probe results equal the expected lines exactly.
check_case() {
	local name="$1" expected="$2"
	shift 2
	local got
	got="$(probe_shell "$@")"
	if [[ "${got}" == "${expected}" ]]; then
		echo "✓ ${name}"
	else
		printf '✗ %s\n  expected: %s\n  got:      %s\n' "${name}" "${expected//$'\n'/ }" "${got//$'\n'/ }" >&2
		failures=$((failures + 1))
	fi
}

loaded=$'PS0_PRESENT\nPROMPT_NORMALIZED'
skipped=$'PS0_MISSING\nPROMPT_RAW'

# A normal terminal (Terminal.app, iTerm, kitty): hooks load.
check_case "standard terminal loads hooks" "${loaded}" \
	sess_standard TERM=xterm-256color

# A VS Code agent or background task: no shell integration, hooks skipped.
check_case "VS Code agent shell skips hooks" "${skipped}" \
	sess_agent TERM=xterm-256color TERM_PROGRAM=vscode

# VS Code's integrated terminal: its shell integration's prompt command is
# present, so hooks load alongside it.
check_case "VS Code integrated terminal loads hooks" "${loaded}" \
	sess_integrated TERM=xterm-256color TERM_PROGRAM=vscode PROMPT_COMMAND=__vsc_prompt_cmd

if (( failures )); then
	echo "terminal_config_test: ${failures} case(s) failed" >&2
	exit 1
fi
echo "terminal_config_test: all passed"
