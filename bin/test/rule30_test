#!/usr/bin/env bash
set -u

PATH="$HOME/dotfiles/bin:$PATH"

tests=0
fails=0

# Count codepoints without depending on the caller's locale. awk's length() and
# `wc -m` both count BYTES under LC_ALL=C, so rule30's block glyphs measure as
# three times their width and the assertion fails on any C-locale host while
# passing on the author's. Every UTF-8 codepoint has exactly one lead byte, so
# deleting the continuation bytes (0x80-0xBF) and counting what remains is
# exact and needs no locale to be installed — C.UTF-8 is glibc-only, and these
# dotfiles run on macOS too.
utf8_len() {
	printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | LC_ALL=C wc -c | tr -d ' '
}

expect_eq() {
	local desc=$1 expected=$2 actual=$3
	((tests++))
	if [[ "$actual" == "$expected" ]]; then
		echo "✓ Test passed: $desc"
	else
		echo "✗ Test failed: $desc" >&2
		echo "  Expected: $(printf '%q' "$expected")" >&2
		echo "  Actual:   $(printf '%q' "$actual")" >&2
		((fails++))
	fi
}

output=$(WIDTH=7 LINES=3 rule30)

((tests++))
line_count=$(printf '%s\n' "$output" | wc -l)
if [[ "$line_count" -eq 3 ]]; then
	echo "✓ Test passed: WIDTH=7 LINES=3 produces exactly 3 lines"
else
	echo "✗ Test failed: expected 3 lines, got $line_count" >&2
	((fails++))
fi

first_bad_width_line() { # $1=output $2=required width; echoes line number or ""
	local out="$1" want="$2" n=0 line
	while IFS= read -r line; do
		n=$((n + 1))
		if [[ "$(utf8_len "$line")" -ne "$want" ]]; then
			printf '%s' "$n"
			return
		fi
	done <<<"$out"
}

((tests++))
bad_width_line=$(first_bad_width_line "$output" 7)
if [[ -z "$bad_width_line" ]]; then
	echo "✓ Test passed: every line is exactly 7 characters wide"
else
	echo "✗ Test failed: line $bad_width_line is not 7 characters wide" >&2
	((fails++))
fi

# Row width must not depend on the caller's locale. Bash slices ${s:i:1} and
# ${s::n} by CHARACTER under a UTF-8 locale but by BYTE under LC_ALL=C, so an
# implementation that indexes a string containing the three-byte █ chops it
# into invalid fragments and emits short rows on any C-locale host — a Nix
# sandbox, a cron job, a CI runner. Run explicitly under C rather than trusting
# whatever locale the suite happens to inherit.
((tests++))
c_locale_bad=$(first_bad_width_line "$(LC_ALL=C WIDTH=7 LINES=3 rule30)" 7)
if [[ -z "$c_locale_bad" ]]; then
	echo "✓ Test passed: rows stay 7 characters wide under LC_ALL=C"
else
	echo "✗ Test failed: under LC_ALL=C, line $c_locale_bad is not 7 characters wide" >&2
	((fails++))
fi

((tests++))
stray_chars=$(printf '%s\n' "$output" | tr -d ' █\n')
if [[ -z "$stray_chars" ]]; then
	echo "✓ Test passed: output contains only space and █ characters"
else
	echo "✗ Test failed: found stray characters: $(printf '%q' "$stray_chars")" >&2
	((fails++))
fi

repeat_output=$(WIDTH=7 LINES=3 rule30)
expect_eq "deterministic: same WIDTH/LINES produce identical output" "$output" "$repeat_output"

help_output=$(rule30 --help)
((tests++))
if [[ "$help_output" == *"Usage:"* ]]; then
	echo "✓ Test passed: --help shows usage"
else
	echo "✗ Test failed: --help did not show usage" >&2
	((fails++))
fi

about_output=$(rule30 --about)
((tests++))
if [[ -n "$about_output" ]]; then
	echo "✓ Test passed: --about shows a description"
else
	echo "✗ Test failed: --about produced no output" >&2
	((fails++))
fi

if [[ $fails -eq 0 ]]; then
	echo "All $tests tests passed"
else
	echo "$fails of $tests tests failed" >&2
fi

exit "$fails"
