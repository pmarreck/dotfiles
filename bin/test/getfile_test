#!/usr/bin/env bash
# Tests for getfile, including --unzip (resumable download, extract, trash archive)
# shellcheck disable=SC2016 # Mock scripts intentionally expand in their child processes.
# shellcheck disable=SC2329 # *_ok predicates are invoked indirectly through check.

tests=0
fails=0

tmpdir=$(mktemp -d --tmpdir getfile_test.XXXXXX)
trap 'rm -rf "$tmpdir"' EXIT

# Deterministic downloader adapters. Each records its argv, then serves
# fixture://NAME from $GETFILE_FIXTURE_DIR to the -O/-o path (or ./NAME).
# fixture://fail/NAME writes a partial file and exits non-zero.
fixture_dir="$tmpdir/download-fixtures"
wget_bin="$tmpdir/wget-bin"
curl_bin="$tmpdir/curl-bin"
mkdir -p "$fixture_dir" "$wget_bin" "$curl_bin"
mock_downloader='#!/usr/bin/env bash
printf "%s\n" "$*" >> "${DOWNLOADER_LOG:-/dev/null}"
out=""
prev=""
for arg in "$@"; do
	case "$prev" in -O|-o) out="$arg" ;; esac
	prev="$arg"
done
url="${*: -1}"
file="${url#fixture://}"
case "$file" in
	fail/*)
		printf "partial" > "${out:-./${file#fail/}}"
		exit 4
		;;
	missing/*)
		: > "${out:-./${file#missing/}}"
		exit 8
		;;
esac
file="${file%%\?*}"
cp "$GETFILE_FIXTURE_DIR/$file" "${out:-./$file}"'
printf '%s\n' "$mock_downloader" > "$wget_bin/wget"
printf '%s\n' "$mock_downloader" > "$curl_bin/curl"
notrash_bin="$tmpdir/notrash-bin"
mkdir -p "$notrash_bin"
cp "$wget_bin/wget" "$notrash_bin/wget"
# Trash adapter: records what was trashed and moves it aside, never into the real Trash.
mock_trash='#!/usr/bin/env bash
for f in "$@"; do
	printf "%s\n" "$f" >> "${TRASH_LOG:?}"
	mv -- "$f" "${TRASH_DIR:?}/"
done'
printf '%s\n' "$mock_trash" > "$wget_bin/rm-safe"
printf '%s\n' "$mock_trash" > "$curl_bin/rm-safe"
chmod +x "$wget_bin/wget" "$wget_bin/rm-safe" "$curl_bin/curl" "$curl_bin/rm-safe" "$notrash_bin/wget"
# Each case runs with PATH set to one of these dirs alone, so the host's real
# wget, curl and rm-safe (which would use the real Trash) are never reachable.
for bin in "$wget_bin" "$curl_bin" "$notrash_bin"; do
	for tool in bash bsdtar cp mv rm; do
		ln -s "$(type -P "$tool")" "$bin/$tool"
	done
done

echo "hello from getfile test" > "$tmpdir/testfile.txt"
(cd "$tmpdir" && bsdtar --format zip -cf "$fixture_dir/test.zip" testfile.txt)
echo "file_a" > "$tmpdir/a.txt"
echo "file_b" > "$tmpdir/b.txt"
(cd "$tmpdir" &&
	bsdtar --format zip -cf "$fixture_dir/a.zip" a.txt &&
	bsdtar --format zip -cf "$fixture_dir/b.zip" b.txt)
printf 'this is not an archive' > "$fixture_dir/corrupt.zip"

# run_case NAME PATH_DIR ARGS... : runs getfile in a fresh dir $tmpdir/NAME,
# capturing status/stderr into case_status/case_err.
run_case() {
	local name="$1" bin="$2"
	shift 2
	case_dir="$tmpdir/$name"
	mkdir -p "$case_dir" "$case_dir.trash"
	: > "$case_dir.trash.log"
	: > "$case_dir.dl.log"
	case_err=$(cd "$case_dir" && PATH="$bin" GETFILE_FIXTURE_DIR="$fixture_dir" \
		DOWNLOADER_LOG="$case_dir.dl.log" TRASH_LOG="$case_dir.trash.log" TRASH_DIR="$case_dir.trash" \
		"$HOME/dotfiles/bin/getfile" "$@" 2>&1 >/dev/null)
	case_status=$?
}

check() {
	local description="$1"
	shift
	((tests++))
	if "$@"; then
		echo "✓ $description"
	else
		echo "✗ $description" >&2
		echo "  status: $case_status; stderr: $case_err" >&2
		echo "  downloader: $(<"$case_dir.dl.log"); trashed: $(<"$case_dir.trash.log")" >&2
		((fails++))
	fi
}

# --unzip: resumable download to a named file, extract in cwd, trash the archive.
run_case unzip_wget "$wget_bin" --unzip "fixture://test.zip"
unzip_wget_ok() {
	[ "$case_status" -eq 0 ] &&
		grep -q "hello from getfile test" "$case_dir/testfile.txt" &&
		[ ! -e "$case_dir/test.zip" ] &&
		[ "$(<"$case_dir.trash.log")" = "test.zip" ] &&
		[[ " $(<"$case_dir.dl.log") " == *" -c "* ]] &&
		[[ " $(<"$case_dir.dl.log") " == *" -O test.zip "* ]]
}
check "--unzip resumes via wget -c, extracts to cwd and trashes the archive" unzip_wget_ok

# --unzip without wget uses curl's resume.
run_case unzip_curl "$curl_bin" --unzip "fixture://test.zip"
unzip_curl_ok() {
	[ "$case_status" -eq 0 ] &&
		grep -q "hello from getfile test" "$case_dir/testfile.txt" &&
		[ "$(<"$case_dir.trash.log")" = "test.zip" ] &&
		[[ " $(<"$case_dir.dl.log") " == *" -C - "* ]] &&
		[[ " $(<"$case_dir.dl.log") " == *" -o test.zip "* ]]
}
check "--unzip falls back to curl -C - when wget is unavailable" unzip_curl_ok

# A query string is not part of the saved archive name.
run_case unzip_query "$wget_bin" --unzip "fixture://test.zip?token=abc"
unzip_query_ok() {
	[ "$case_status" -eq 0 ] &&
		[ -f "$case_dir/testfile.txt" ] &&
		[ "$(<"$case_dir.trash.log")" = "test.zip" ]
}
check "--unzip strips the query string from the archive filename" unzip_query_ok

# Multiple archives are each downloaded, extracted and trashed.
run_case unzip_multi "$wget_bin" --unzip "fixture://a.zip" "fixture://b.zip"
unzip_multi_ok() {
	[ "$case_status" -eq 0 ] &&
		[ -f "$case_dir/a.txt" ] && [ -f "$case_dir/b.txt" ] &&
		[ "$(<"$case_dir.trash.log")" = $'a.zip\nb.zip' ]
}
check "--unzip handles multiple URLs" unzip_multi_ok

# A failed extraction keeps the archive, keeps going, and fails the run.
run_case unzip_corrupt "$wget_bin" --unzip "fixture://corrupt.zip" "fixture://a.zip"
unzip_corrupt_ok() {
	[ "$case_status" -ne 0 ] &&
		[ -f "$case_dir/corrupt.zip" ] &&
		[ -f "$case_dir/a.txt" ] &&
		[ "$(<"$case_dir.trash.log")" = "a.zip" ] &&
		[[ "$case_err" == *"getfile: failed to extract corrupt.zip; archive kept"* ]]
}
check "--unzip keeps an archive that fails to extract and exits non-zero" unzip_corrupt_ok

# A failed download keeps the partial file for a later resume and skips extraction.
run_case unzip_dlfail "$wget_bin" --unzip "fixture://fail/test.zip"
unzip_dlfail_ok() {
	[ "$case_status" -ne 0 ] &&
		[ "$(<"$case_dir/test.zip")" = "partial" ] &&
		[ ! -s "$case_dir.trash.log" ] &&
		[[ "$case_err" == *"getfile: download of test.zip incomplete; rerun to resume"* ]]
}
check "--unzip keeps a partial download for resume and skips extraction" unzip_dlfail_ok

# A server error (wget -O leaves an empty file on a 404) removes only that
# empty file getfile created, and does not promise a resume.
run_case unzip_404 "$wget_bin" --unzip "fixture://missing/test.zip"
unzip_404_ok() {
	[ "$case_status" -ne 0 ] &&
		[ ! -e "$case_dir/test.zip" ] &&
		[[ "$case_err" == *"getfile: download of test.zip failed"* ]] &&
		[[ "$case_err" != *"resume"* ]]
}
check "--unzip removes the empty file a failed request leaves behind" unzip_404_ok

# A pre-existing empty file is the user's, so it is never removed.
mkdir -p "$tmpdir/unzip_404_existing"
: > "$tmpdir/unzip_404_existing/test.zip"
run_case unzip_404_existing "$wget_bin" --unzip "fixture://missing/test.zip"
unzip_404_existing_ok() {
	[ "$case_status" -ne 0 ] && [ -e "$case_dir/test.zip" ]
}
check "--unzip never removes an empty archive file that existed beforehand" unzip_404_existing_ok

# A URL with no filename component cannot be named, so it is rejected.
run_case unzip_noname "$wget_bin" --unzip "fixture://dir/"
unzip_noname_ok() {
	[ "$case_status" -ne 0 ] &&
		[ ! -s "$case_dir.dl.log" ] &&
		[[ "$case_err" == *"getfile: cannot derive an archive filename from fixture://dir/"* ]]
}
check "--unzip rejects a URL without a filename" unzip_noname_ok

# Without rm-safe, the archive is left in place rather than hard-deleted.
run_case unzip_notrash "$notrash_bin" --unzip "fixture://test.zip"
unzip_notrash_ok() {
	[ "$case_status" -eq 0 ] &&
		[ -f "$case_dir/testfile.txt" ] &&
		[ -f "$case_dir/test.zip" ] &&
		[[ "$case_err" == *"getfile: rm-safe unavailable; kept test.zip"* ]]
}
check "--unzip keeps the archive when rm-safe is unavailable" unzip_notrash_ok

# Plain mode: curl fallback resumes too.
echo "normal content" > "$fixture_dir/normalfile.txt"
run_case plain_wget "$wget_bin" "fixture://normalfile.txt"
plain_wget_ok() {
	[ "$case_status" -eq 0 ] &&
		grep -q "normal content" "$case_dir/normalfile.txt" &&
		[[ " $(<"$case_dir.dl.log") " == *" -c "* ]]
}
check "Normal download resumes via wget -c" plain_wget_ok

run_case plain_curl "$curl_bin" "fixture://normalfile.txt"
plain_curl_ok() {
	[ "$case_status" -eq 0 ] &&
		[[ " $(<"$case_dir.dl.log") " == *" -C - "* ]]
}
check "Normal download falls back to curl -C -" plain_curl_ok

((tests++))
if getfile --help 2>&1 | grep -q -- "--unzip"; then
	echo "✓ --help mentions --unzip"
else
	echo "✗ --help should mention --unzip" >&2
	((fails++))
fi

# Regression: bash arrays cannot be exported, so child scripts never inherit
# GREP_QUIET. The old guard `(( ${#GREP_QUIET[@]} ))` itself tripped `set -u`
# with "unbound variable" before its fallback could run.
((tests++))
err=$(env -u GREP_QUIET getfile --help 2>&1 >/dev/null)
if [ -z "$err" ]; then
	echo "✓ Runs cleanly with GREP_QUIET unset"
else
	echo "✗ Errored with GREP_QUIET unset: $err" >&2
	((fails++))
fi

if [ "$fails" -eq 0 ]; then
	echo "All $tests tests passed"
else
	echo "$fails of $tests tests failed" >&2
fi

exit "$fails"
