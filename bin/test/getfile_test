#!/usr/bin/env bash
# Tests for getfile, including --unzip (resumable download, extract, trash archive)
# shellcheck disable=SC2016 # Mock scripts intentionally expand in their child processes.
# shellcheck disable=SC2329 # *_ok predicates are invoked indirectly through check.

tests=0
fails=0

tmpdir=$(mktemp -d --tmpdir getfile_test.XXXXXX)
trap 'rm -rf "$tmpdir"' EXIT

# Deterministic downloader adapters. Each records its argv, then serves
# fixture://NAME from $GETFILE_FIXTURE_DIR to the -O/-o path (or ./NAME).
# fixture://fail/NAME writes a partial file and exits non-zero.
fixture_dir="$tmpdir/download-fixtures"
mkdir -p "$fixture_dir"
mock_downloader='printf "%s\n" "$*" >> "${DOWNLOADER_LOG:-/dev/null}"
out=""
prev=""
for arg in "$@"; do
	case "$prev" in -O|-o) out="$arg" ;; esac
	prev="$arg"
done
url="${*: -1}"
file="${url#fixture://}"
case "$file" in
	fail/*)
		printf "partial" > "${out:-./${file#fail/}}"
		exit 4
		;;
	missing/*)
		: > "${out:-./${file#missing/}}"
		exit 8
		;;
esac
file="${file%%\?*}"
cp "$GETFILE_FIXTURE_DIR/$file" "${out:-./$file}"'
# Trash adapter: records what was trashed and moves it aside, never into the real Trash.
mock_trash='for f in "$@"; do
	printf "%s\n" "$f" >> "${TRASH_LOG:?}"
	mv -- "$f" "${TRASH_DIR:?}/"
done'

# write_mock PATH BODY : the shebang names this bash directly, because the Linux
# Nix sandbox has no /usr/bin/env and patchShebangs never sees runtime mocks.
write_mock() {
	printf '#!%s\n%s\n' "$BASH" "$2" > "$1"
	chmod +x "$1"
}

# link_tool DIR NAME [HOST_PATH] : expose one host tool inside a hermetic PATH dir.
link_tool() {
	ln -s "${3:-$(type -P "$2")}" "$1/$2"
}

# getfile extracts with GNU tar (named gtar on macOS, tar on Linux) and Info-ZIP
# unzip; every --unzip case below depends on them, so their absence fails the run.
gnu_tar=""
for candidate in gtar tar; do
	candidate_path=$(type -P "$candidate") || continue
	if "$candidate_path" --version 2>/dev/null | grep -q 'GNU tar'; then
		gnu_tar="$candidate_path"
		break
	fi
done
if [ -z "$gnu_tar" ] || ! type -P unzip gzip zip >/dev/null; then
	echo "✗ GNU tar (as gtar or tar), unzip, zip and gzip are required to run these tests" >&2
	exit 1
fi

# Each case runs with PATH set to one of these dirs alone, so the host's real
# wget, curl and rm-safe (which would use the real Trash) are never reachable.
# wget_bin has the Linux layout (GNU tar as tar); macos_bin has the macOS layout,
# where tar is bsdtar (a decoy here) and GNU tar is gtar.
wget_bin="$tmpdir/wget-bin"
curl_bin="$tmpdir/curl-bin"
notrash_bin="$tmpdir/notrash-bin"
macos_bin="$tmpdir/macos-bin"
for bin in "$wget_bin" "$curl_bin" "$notrash_bin" "$macos_bin"; do
	mkdir -p "$bin"
	for tool in bash cp mv rm unzip gzip; do
		link_tool "$bin" "$tool"
	done
done
for bin in "$wget_bin" "$curl_bin" "$notrash_bin"; do
	link_tool "$bin" tar "$gnu_tar"
done
link_tool "$macos_bin" gtar "$gnu_tar"
write_mock "$macos_bin/tar" 'echo "decoy non-GNU tar invoked" >&2; exit 99'
write_mock "$wget_bin/wget" "$mock_downloader"
write_mock "$curl_bin/curl" "$mock_downloader"
write_mock "$notrash_bin/wget" "$mock_downloader"
write_mock "$macos_bin/wget" "$mock_downloader"
for bin in "$wget_bin" "$curl_bin" "$macos_bin"; do
	write_mock "$bin/rm-safe" "$mock_trash"
done

echo "hello from getfile test" > "$tmpdir/testfile.txt"
(cd "$tmpdir" && zip -q "$fixture_dir/test.zip" testfile.txt)
echo "file_a" > "$tmpdir/a.txt"
echo "file_b" > "$tmpdir/b.txt"
(cd "$tmpdir" &&
	zip -q "$fixture_dir/a.zip" a.txt &&
	zip -q "$fixture_dir/b.zip" b.txt)
printf 'this is not an archive' > "$fixture_dir/corrupt.zip"
# tree.zip lists "sub/", "sub/f.txt", "top.txt"; tree.tgz lists the same with "./" prefixes.
mkdir -p "$tmpdir/tree/sub"
echo "new f" > "$tmpdir/tree/sub/f.txt"
echo "new top" > "$tmpdir/tree/top.txt"
(cd "$tmpdir/tree" &&
	zip -qr "$fixture_dir/tree.zip" sub top.txt &&
	"$gnu_tar" -czf "$fixture_dir/tree.tgz" .)

# run_case NAME PATH_DIR ARGS... : runs getfile in a fresh dir $tmpdir/NAME,
# capturing status/stderr into case_status/case_err.
run_case() {
	local name="$1" bin="$2"
	shift 2
	case_dir="$tmpdir/$name"
	mkdir -p "$case_dir" "$case_dir.trash"
	: > "$case_dir.trash.log"
	: > "$case_dir.dl.log"
	case_err=$(cd "$case_dir" && PATH="$bin" GETFILE_FIXTURE_DIR="$fixture_dir" \
		DOWNLOADER_LOG="$case_dir.dl.log" TRASH_LOG="$case_dir.trash.log" TRASH_DIR="$case_dir.trash" \
		"$HOME/dotfiles/bin/getfile" "$@" 2>&1 >/dev/null)
	case_status=$?
}

check() {
	local description="$1"
	shift
	((tests++))
	if "$@"; then
		echo "✓ $description"
	else
		echo "✗ $description" >&2
		echo "  status: $case_status; stderr: $case_err" >&2
		echo "  downloader: $(<"$case_dir.dl.log"); trashed: $(<"$case_dir.trash.log")" >&2
		((fails++))
	fi
}

# --unzip: resumable download to a named file, extract in cwd, trash the archive.
run_case unzip_wget "$wget_bin" --unzip "fixture://test.zip"
unzip_wget_ok() {
	[ "$case_status" -eq 0 ] &&
		grep -q "hello from getfile test" "$case_dir/testfile.txt" &&
		[ ! -e "$case_dir/test.zip" ] &&
		[ "$(<"$case_dir.trash.log")" = "test.zip" ] &&
		[[ " $(<"$case_dir.dl.log") " == *" -c "* ]] &&
		[[ " $(<"$case_dir.dl.log") " == *" -O test.zip "* ]]
}
check "--unzip resumes via wget -c, extracts to cwd and trashes the archive" unzip_wget_ok

# Tarballs go to GNU tar; on macOS that is gtar, never the bsdtar named tar.
for layout in wget_bin macos_bin; do
	run_case "tgz_$layout" "${!layout}" --unzip "fixture://tree.tgz"
	tgz_ok() {
		[ "$case_status" -eq 0 ] &&
			[ "$(<"$case_dir/top.txt")" = "new top" ] &&
			[ "$(<"$case_dir/sub/f.txt")" = "new f" ] &&
			[ "$(<"$case_dir.trash.log")" = "tree.tgz" ] &&
			[[ "$case_err" != *decoy* ]]
	}
	check "--unzip extracts a .tgz with GNU tar ($layout layout)" tgz_ok
done
# --unzip without wget uses curl's resume.
run_case unzip_curl "$curl_bin" --unzip "fixture://test.zip"
unzip_curl_ok() {
	[ "$case_status" -eq 0 ] &&
		grep -q "hello from getfile test" "$case_dir/testfile.txt" &&
		[ "$(<"$case_dir.trash.log")" = "test.zip" ] &&
		[[ " $(<"$case_dir.dl.log") " == *" -C - "* ]] &&
		[[ " $(<"$case_dir.dl.log") " == *" -o test.zip "* ]]
}
check "--unzip falls back to curl -C - when wget is unavailable" unzip_curl_ok

# A query string is not part of the saved archive name.
run_case unzip_query "$wget_bin" --unzip "fixture://test.zip?token=abc"
unzip_query_ok() {
	[ "$case_status" -eq 0 ] &&
		[ -f "$case_dir/testfile.txt" ] &&
		[ "$(<"$case_dir.trash.log")" = "test.zip" ]
}
check "--unzip strips the query string from the archive filename" unzip_query_ok

# Multiple archives are each downloaded, extracted and trashed.
run_case unzip_multi "$wget_bin" --unzip "fixture://a.zip" "fixture://b.zip"
unzip_multi_ok() {
	[ "$case_status" -eq 0 ] &&
		[ -f "$case_dir/a.txt" ] && [ -f "$case_dir/b.txt" ] &&
		[ "$(<"$case_dir.trash.log")" = $'a.zip\nb.zip' ]
}
check "--unzip handles multiple URLs" unzip_multi_ok

# A failed extraction keeps the archive, keeps going, and fails the run.
run_case unzip_corrupt "$wget_bin" --unzip "fixture://corrupt.zip" "fixture://a.zip"
unzip_corrupt_ok() {
	[ "$case_status" -ne 0 ] &&
		[ -f "$case_dir/corrupt.zip" ] &&
		[ -f "$case_dir/a.txt" ] &&
		[ "$(<"$case_dir.trash.log")" = "a.zip" ] &&
		[[ "$case_err" == *"getfile: failed to extract corrupt.zip; archive kept"* ]]
}
check "--unzip keeps an archive that fails to extract and exits non-zero" unzip_corrupt_ok

# A failed download keeps the partial file for a later resume and skips extraction.
run_case unzip_dlfail "$wget_bin" --unzip "fixture://fail/test.zip"
unzip_dlfail_ok() {
	[ "$case_status" -ne 0 ] &&
		[ "$(<"$case_dir/test.zip")" = "partial" ] &&
		[ ! -s "$case_dir.trash.log" ] &&
		[[ "$case_err" == *"getfile: download of test.zip incomplete; rerun to resume"* ]]
}
check "--unzip keeps a partial download for resume and skips extraction" unzip_dlfail_ok

# A server error (wget -O leaves an empty file on a 404) removes only that
# empty file getfile created, and does not promise a resume.
run_case unzip_404 "$wget_bin" --unzip "fixture://missing/test.zip"
unzip_404_ok() {
	[ "$case_status" -ne 0 ] &&
		[ ! -e "$case_dir/test.zip" ] &&
		[[ "$case_err" == *"getfile: download of test.zip failed"* ]] &&
		[[ "$case_err" != *"resume"* ]]
}
check "--unzip removes the empty file a failed request leaves behind" unzip_404_ok

# A pre-existing empty file is the user's, so it is never removed.
mkdir -p "$tmpdir/unzip_404_existing"
: > "$tmpdir/unzip_404_existing/test.zip"
run_case unzip_404_existing "$wget_bin" --unzip "fixture://missing/test.zip"
unzip_404_existing_ok() {
	[ "$case_status" -ne 0 ] && [ -e "$case_dir/test.zip" ]
}
check "--unzip never removes an empty archive file that existed beforehand" unzip_404_existing_ok

# A URL with no filename component cannot be named, so it is rejected.
run_case unzip_noname "$wget_bin" --unzip "fixture://dir/"
unzip_noname_ok() {
	[ "$case_status" -ne 0 ] &&
		[ ! -s "$case_dir.dl.log" ] &&
		[[ "$case_err" == *"getfile: cannot derive an archive filename from fixture://dir/"* ]]
}
check "--unzip rejects a URL without a filename" unzip_noname_ok

# Without rm-safe, the archive is left in place rather than hard-deleted.
run_case unzip_notrash "$notrash_bin" --unzip "fixture://test.zip"
unzip_notrash_ok() {
	[ "$case_status" -eq 0 ] &&
		[ -f "$case_dir/testfile.txt" ] &&
		[ -f "$case_dir/test.zip" ] &&
		[[ "$case_err" == *"getfile: rm-safe unavailable; kept test.zip"* ]]
}
check "--unzip keeps the archive when rm-safe is unavailable" unzip_notrash_ok

# seed_case NAME : pre-populates $tmpdir/NAME with an old top.txt.
seed_case() {
	mkdir -p "$tmpdir/$1"
	echo "old top" > "$tmpdir/$1/top.txt"
}

# An existing file blocks the whole archive: nothing is written, the archive is kept.
for fixture in tree.zip tree.tgz; do
	seed_case "conflict_${fixture%%.*}_${fixture##*.}"
	run_case "conflict_${fixture%%.*}_${fixture##*.}" "$wget_bin" --unzip "fixture://$fixture"
	conflict_ok() {
		[ "$case_status" -ne 0 ] &&
			[ "$(<"$case_dir/top.txt")" = "old top" ] &&
			[ ! -e "$case_dir/sub" ] &&
			[ -f "$case_dir/$fixture" ] &&
			[ ! -s "$case_dir.trash.log" ] &&
			[[ "$case_err" == *"top.txt"* ]] &&
			[[ "$case_err" == *"--overwrite"* ]]
	}
	check "--unzip refuses to extract $fixture over an existing file and writes nothing" conflict_ok
done

# Each overwrite spelling replaces existing files and trashes the archive.
for spec in --overwrite:tree.zip --yes:tree.zip -y:tree.zip --overwrite:tree.tgz; do
	flag="${spec%%:*}"
	fixture="${spec#*:}"
	seed_case "overwrite${flag}_$fixture"
	run_case "overwrite${flag}_$fixture" "$wget_bin" --unzip "$flag" "fixture://$fixture"
	overwrite_ok() {
		[ "$case_status" -eq 0 ] &&
			[ "$(<"$case_dir/top.txt")" = "new top" ] &&
			[ "$(<"$case_dir/sub/f.txt")" = "new f" ] &&
			[ "$(<"$case_dir.trash.log")" = "$fixture" ]
	}
	check "--unzip $flag overwrites existing files from $fixture" overwrite_ok
done

# Conflict classifier over a set of pre-existing paths, for both listing
# formats (unzip -Z1 and tar -tf): an existing directory where the archive has
# a directory is fine; a file there, or a symlink anywhere the archive writes,
# is a conflict.
for fixture in tree.zip tree.tgz; do
	tag="${fixture//./_}"
	mkdir -p "$tmpdir/dir_ok_$tag/sub"
	run_case "dir_ok_$tag" "$wget_bin" --unzip "fixture://$fixture"
	dir_ok_ok() {
		[ "$case_status" -eq 0 ] && [ "$(<"$case_dir/sub/f.txt")" = "new f" ]
	}
	check "--unzip merges $fixture into an existing directory it also contains" dir_ok_ok

	mkdir -p "$tmpdir/file_for_dir_$tag"
	echo "not a dir" > "$tmpdir/file_for_dir_$tag/sub"
	run_case "file_for_dir_$tag" "$wget_bin" --unzip "fixture://$fixture"
	file_for_dir_ok() {
		[ "$case_status" -ne 0 ] && [ "$(<"$case_dir/sub")" = "not a dir" ] && [ ! -e "$case_dir/top.txt" ] &&
			[[ "$case_err" == *"would overwrite"* ]]
	}
	check "--unzip treats a file where $fixture has a directory as a conflict" file_for_dir_ok

	mkdir -p "$tmpdir/symlink_conflict_$tag"
	ln -s "$tmpdir/nowhere" "$tmpdir/symlink_conflict_$tag/top.txt"
	run_case "symlink_conflict_$tag" "$wget_bin" --unzip "fixture://$fixture"
	symlink_conflict_ok() {
		[ "$case_status" -ne 0 ] && [ -L "$case_dir/top.txt" ] && [ ! -e "$case_dir/sub" ] &&
			[[ "$case_err" == *"would overwrite"* ]]
	}
	check "--unzip treats a dangling symlink at a $fixture path as a conflict" symlink_conflict_ok
done

# Plain mode: curl fallback resumes too.
echo "normal content" > "$fixture_dir/normalfile.txt"
run_case plain_wget "$wget_bin" "fixture://normalfile.txt"
plain_wget_ok() {
	[ "$case_status" -eq 0 ] &&
		grep -q "normal content" "$case_dir/normalfile.txt" &&
		[[ " $(<"$case_dir.dl.log") " == *" -c "* ]]
}
check "Normal download resumes via wget -c" plain_wget_ok

run_case plain_curl "$curl_bin" "fixture://normalfile.txt"
plain_curl_ok() {
	[ "$case_status" -eq 0 ] &&
		[[ " $(<"$case_dir.dl.log") " == *" -C - "* ]]
}
check "Normal download falls back to curl -C -" plain_curl_ok

((tests++))
if getfile --help 2>&1 | grep -q -- "--unzip"; then
	echo "✓ --help mentions --unzip"
else
	echo "✗ --help should mention --unzip" >&2
	((fails++))
fi

# Regression: bash arrays cannot be exported, so child scripts never inherit
# GREP_QUIET. The old guard `(( ${#GREP_QUIET[@]} ))` itself tripped `set -u`
# with "unbound variable" before its fallback could run.
((tests++))
err=$(env -u GREP_QUIET getfile --help 2>&1 >/dev/null)
if [ -z "$err" ]; then
	echo "✓ Runs cleanly with GREP_QUIET unset"
else
	echo "✗ Errored with GREP_QUIET unset: $err" >&2
	((fails++))
fi

if [ "$fails" -eq 0 ]; then
	echo "All $tests tests passed"
else
	echo "$fails of $tests tests failed" >&2
fi

exit "$fails"
