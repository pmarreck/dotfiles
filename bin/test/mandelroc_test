#!/usr/bin/env bash
# mandelroc is mandelbash ported to Roc and run through jumpscript, which
# compiles it once and reuses the cached native binary. The Bash original is
# the oracle: the output must match it byte for byte.
set -u

bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
test_count=0
fail_count=0
pass() { echo "✓ $1"; ((test_count++)); }
fail() { echo "✗ $1" >&2; ((test_count++)); ((fail_count++)); }

if ! command -v jumpscript >/dev/null 2>&1; then
	fail "jumpscript is not on PATH; mandelroc needs it to compile and run"
	echo "mandelroc_test: ${fail_count}/${test_count} failed" >&2
	exit 1
fi
roc_bin="$(command -v roc 2>/dev/null || :)"
if [[ ! -x "${roc_bin}" ]]; then
	fail "roc is not on PATH; mandelroc needs it to compile"
	echo "mandelroc_test: ${fail_count}/${test_count} failed" >&2
	exit 1
fi

cache="$(mktemp -d)"
trap 'rm -rf "${cache}"' EXIT
bash_bin="${BASH:-$(command -v bash)}"
adapter_bin="${cache}/adapter-bin"
root_log="${cache}/root-requests"
mkdir -p "${adapter_bin}"
{
	printf '#!%s\n' "${bash_bin}"
	cat <<'ADAPTER'
if (( $# < 5 )) || [[ "$1" != build || "$2" != --offline || "$3" != --out-link ]]; then
	printf 'unexpected nix adapter invocation:' >&2
	printf ' <%s>' "$@" >&2
	printf '\n' >&2
	exit 64
fi
shift 4
for store_path in "$@"; do
	if [[ "$store_path" != /nix/store/* || ! -e "$store_path" ]]; then
		printf 'invalid store reference: %s\n' "$store_path" >&2
		exit 65
	fi
done
ADAPTER
	printf 'printf "root-request\\n" >> %q\n' "${root_log}"
} >"${adapter_bin}/nix"
chmod +x "${adapter_bin}/nix"

# mandelbash tees into /tmp/m<pid> and never removes it; exec keeps the PID
# known so the leftover can be cleaned up.
expected="$(bash -c 'echo $$; exec "$1"' _ "${bin_dir}/mandelbash"; echo x)"
orig_pid="${expected%%$'\n'*}"
rm -f "/tmp/m${orig_pid}"
expected="${expected#*$'\n'}"

cold="$(PATH="${adapter_bin}:$PATH" JUMPSCRIPT_CACHE="${cache}" JUMPSCRIPT_ROC="${roc_bin}" "${bin_dir}/mandelroc" 2>"${cache}/cold.err"; echo x)"
if [[ "${cold}" == "${expected}" ]]; then
	pass "cold run matches mandelbash byte for byte"
else
	fail "cold run differs from mandelbash ($(wc -c <<<"${cold}") vs $(wc -c <<<"${expected}") bytes); stderr: $(<"${cache}/cold.err")"
fi

artifact="$(find "${cache}/Roc" -type f -path '*/bin/mandelroc' 2>/dev/null)"
if [[ -n "${artifact}" ]]; then
	pass "jumpscript cached a native binary"
	before="$(ls -li "${artifact}")"
	warm="$(PATH="${adapter_bin}:$PATH" JUMPSCRIPT_CACHE="${cache}" JUMPSCRIPT_ROC="${roc_bin}" "${bin_dir}/mandelroc" 2>&1; echo x)"
	if [[ "${warm}" == "${expected}" ]]; then
		pass "warm run matches mandelbash"
	else
		fail "warm run differs from mandelbash"
	fi
	if [[ "$(ls -li "${artifact}")" == "${before}" ]]; then
		pass "warm run reused the cached binary"
	else
		fail "warm run rebuilt the binary"
	fi
	if [[ "$(wc -l <"${root_log}")" -eq 1 ]]; then
		pass "warm run did not repeat GC rooting"
	else
		fail "warm run repeated GC rooting"
	fi
else
	fail "no cached native binary under ${cache}/Roc"
fi

if (( fail_count )); then
	echo "mandelroc_test: ${fail_count}/${test_count} failed" >&2
	exit 1
fi
