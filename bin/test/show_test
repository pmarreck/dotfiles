#!/usr/bin/env bash

tests=0
fails=0

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PATH="$repo_dir/bin:$PATH"

show_script="$repo_dir/bin/src/show.bash"
completion_script="$repo_dir/completions/show_completion.bash"

# defined_helpers supplies var_defined, which show calls but which is not on
# PATH as an executable. Without it every `show` invocation here emitted
# "var_defined: command not found" and silently skipped its variable branch, so
# the tests ran against a shell less capable than the real one.
source "$repo_dir/bin/src/defined_helpers.sh"
# Exported so the `bash -c` subshells below inherit them too; they source only
# show.bash, and would otherwise reintroduce the same missing-helper noise out
# of sight, inside captured output that is printed only when a test fails.
export -f var_defined in_bash
source "$show_script"

# Markdown's explicit extension must outrank file(1)'s content scan. Executable
# documentation containing fenced shell examples can otherwise look like a script.
markdown_tmp_dir="$(mktemp --tmpdir -d show_markdown.XXXXXX)"
cat > "$markdown_tmp_dir/zig-build-pattern.md" <<'EOF'
# Zig + Nix Unified Build Pattern

```bash
#!/usr/bin/env bash
run nix build
```
EOF
cat > "$markdown_tmp_dir/deploy-notes.md" <<'EOF'
# Deployment Notes

    #!/bin/sh
    exec deploy "$@"
EOF
printf '# Versioned guide\n' > "$markdown_tmp_dir/guide.v2.md"
printf '# Uppercase suffix\n' > "$markdown_tmp_dir/README.MD"
printf '# Long suffix\n' > "$markdown_tmp_dir/notes.markdown"
cat > "$markdown_tmp_dir/build" <<'EOF'
#!/usr/bin/env bash
printf 'build\n'
EOF
cat > "$markdown_tmp_dir/deploy" <<'EOF'
#!/bin/sh
printf 'deploy\n'
EOF
chmod +x "$markdown_tmp_dir/zig-build-pattern.md" \
	"$markdown_tmp_dir/deploy-notes.md" "$markdown_tmp_dir/guide.v2.md" \
	"$markdown_tmp_dir/README.MD" "$markdown_tmp_dir/notes.markdown" \
	"$markdown_tmp_dir/build" "$markdown_tmp_dir/deploy"

((tests++))
echo "Testing: language detection classifies Markdown and extensionless shell files as a set..."
language_fails=()
for language_case in \
	"zig-build-pattern.md|md" \
	"deploy-notes.md|md" \
	"guide.v2.md|md" \
	"README.MD|md" \
	"notes.markdown|md" \
	"build|bash" \
	"deploy|sh"
do
	IFS='|' read -r language_file expected_language <<< "$language_case"
	actual_language=$(determine_language_from_source \
		"$markdown_tmp_dir/$language_file" 2>"$markdown_tmp_dir/stderr")
	if [[ "$actual_language" != "$expected_language" ]]; then
		language_fails+=("$language_file=$actual_language (expected $expected_language)")
	fi
done
if ((${#language_fails[@]} == 0)); then
	echo "[PASS] Markdown extensions outrank shell-like content without weakening extensionless scripts"
else
	echo "[FAIL] language classifier errors: ${language_fails[*]}" >&2
	((fails++))
fi
rm -rf "$markdown_tmp_dir"

# Completion suite: ensure shell completion script loads cleanly in supported shells
if command -v zsh >/dev/null 2>&1; then
	((tests++))
	echo "Testing: show completion script can be sourced by zsh without errors..."
	output=$(zsh -lc ". '$completion_script'" 2>&1)
	status=$?
	if [[ $status -eq 0 ]] && [[ -z "$output" ]]; then
		echo "[PASS] sourcing show completion in zsh exits cleanly"
	else
		echo "[FAIL] sourcing show completion in zsh produced errors" >&2
		[[ $status -ne 0 ]] && echo "  Exit status: $status" >&2
		[[ -n "$output" ]] && echo "  Output:" >&2 && printf '%s\n' "$output" >&2
		((fails++))
	fi
else
	echo "[SKIP] zsh not available; skipping completion guard"
fi

((tests++))
echo "Testing: show completion script in bash POSIX mode..."
output=$(POSIXLY_CORRECT=1 bash -lc ". '$completion_script'" 2>&1)
status=$?
if [[ $status -eq 0 ]] && [[ -z "$output" ]]; then
	echo "[PASS] sourcing show completion under POSIXLY_CORRECT is silent"
else
	echo "[FAIL] sourcing show completion under POSIXLY_CORRECT produced errors" >&2
	[[ $status -ne 0 ]] && echo "  Exit status: $status" >&2
	[[ -n "$output" ]] && echo "  Output:" >&2 && printf '%s\n' "$output" >&2
	((fails++))
fi

# WAT detection suite: verify wasmrun scripts map to WAT highlighting
((tests++))
echo "Testing: determine_language_from_source returns wat for wasmrun shebang..."
wat_stderr=$(mktemp --tmpdir)
output=$(PATH="$repo_dir/bin:$PATH" bash -lc 'source "'"$show_script"'"; determine_language_from_source "'"$repo_dir/bin/ns"'"' 2>"$wat_stderr")
exit_code=$?
if [[ $exit_code -eq 0 ]] && [[ "$output" == "wat" ]]; then
	echo "[PASS] wasmrun shebang classified as wat"
else
	echo "[FAIL] wasmrun detection output: exit=$exit_code, value='${output}'" >&2
	echo "--- stderr ---" >&2
	cat "$wat_stderr" >&2
	echo "--------------" >&2
	((fails++))
fi
rm -f "$wat_stderr"

((tests++))
echo "Testing: show uses lisp highlighting for WAT files via bat..."
wat_tmp_dir="$(mktemp --tmpdir -d show_wat.XXXXXX)"
bat_log="$wat_tmp_dir/bat_args"
cat >"$wat_tmp_dir/bat" <<EOF
#!/usr/bin/env bash
echo "\$@" >"$bat_log"
cat "\${@: -1}"
EOF
chmod +x "$wat_tmp_dir/bat"

show_stderr="$wat_tmp_dir/show_wat_stderr"
if PATH="$wat_tmp_dir:$repo_dir/bin:$PATH" bash -c 'source "'"$show_script"'"; show "'"$repo_dir/bin/ns"'"' >"$wat_tmp_dir/show_output" 2>"$show_stderr"; then
	if grep -q "\-l lisp" "$bat_log"; then
		echo "[PASS] show invoked bat with lisp highlighting for WAT file"
	else
		echo "[FAIL] bat invocation missing lisp highlight flag" >&2
		cat "$bat_log" >&2
		((fails++))
	fi
else
	echo "[FAIL] show command failed when displaying WAT file" >&2
	cat "$show_stderr" >&2
	((fails++))
fi

rm -rf "$wat_tmp_dir"

# Node.js detection suite: ensure node-based scripts get JavaScript highlighting
((tests++))
echo "Testing: determine_language_from_source classifies node shebang as JavaScript..."
node_tmp_dir="$(mktemp --tmpdir -d show_node.XXXXXX)"
node_script="$node_tmp_dir/demo-node"
cat >"$node_script" <<'EOF'
#!/usr/bin/env node
console.log("demo");
EOF
chmod +x "$node_script"
node_lang_output="$(determine_language_from_source "$node_script" 2>"$node_tmp_dir/node_determine_stderr" || echo "exit-$?")"
if [[ "$node_lang_output" == "js" ]]; then
	echo "[PASS] determine_language_from_source returned 'js' for node shebang"
else
	echo "[FAIL] determine_language_from_source expected 'js', got '$node_lang_output'" >&2
	echo "--- stderr ---" >&2
	cat "$node_tmp_dir/node_determine_stderr" >&2
	echo "--------------" >&2
	((fails++))
fi

((tests++))
echo "Testing: show uses JavaScript highlighting for node scripts..."
node_bat_log="$node_tmp_dir/bat_args"
cat >"$node_tmp_dir/bat" <<EOF
#!/usr/bin/env bash
echo "\$@" >"$node_bat_log"
cat "\${@: -1}"
EOF
chmod +x "$node_tmp_dir/bat"

node_show_output="$node_tmp_dir/show_output"
node_show_stderr="$node_tmp_dir/show_stderr"
if PATH="$node_tmp_dir:$PATH" bash -c 'source "'"$show_script"'"; show "'"$node_script"'"' >"$node_show_output" 2>"$node_show_stderr"; then
	if grep -q '\-l js' "$node_bat_log"; then
		echo "[PASS] show invoked bat with JavaScript highlighting for node script"
	else
		echo "[FAIL] bat invocation missing '-l js'" >&2
		cat "$node_bat_log" >&2
		((fails++))
	fi
else
	echo "[FAIL] show command failed for node script" >&2
	cat "$node_show_stderr" >&2
	((fails++))
fi

rm -rf "$node_tmp_dir"

# ── Local paths must outrank the URL interpretation ──────────────────────────
# `show README.md` used to launch a web browser: is_web_url matched the string
# because ".md" is Moldova's ccTLD, and the regex never asked the filesystem.
# The same trap swallows ".sh" (Saint Helena), ".pl" (Poland), ".ai" (Anguilla),
# ".io", ".it" — a large share of the filenames anyone would ever actually type.
#
# The routing decision is exercised as a classifier over SETS in BOTH
# directions: the identical string must reach the file branch when a path of
# that name exists and the browser when it does not. A "fix" that merely
# stopped recognizing bare domains would sail through the specificity set and
# get caught by the sensitivity set.

((tests++))
echo "Testing: the URL-vs-path routing decision is its own callable function..."
if declare -F should_open_as_web_url >/dev/null; then
	echo "[PASS] should_open_as_web_url is defined"
else
	echo "[FAIL] should_open_as_web_url is undefined; routing is not unit-testable" >&2
	((fails++))
fi

# Strings that are at once plausible filenames and syntactically valid domains.
# Every extension here is a real ccTLD, which is precisely why the string alone
# cannot settle the question.
url_shaped_filenames=(README.md notes.md test.sh script.pl photo.ai data.io CHANGELOG.md)
# Genuine schemeless URLs. Nothing of these names exists on disk.
bare_domains=(example.com www.example.com github.com/user/repo sub.domain.co.uk)
# An explicit scheme is an unambiguous declaration of intent and always wins.
scheme_urls=(https://example.com http://example.com https://example.com/a/b)

((tests++))
echo "Testing: an existing path is never routed to the browser..."
misrouted=()
for candidate in "${url_shaped_filenames[@]}"; do
	should_open_as_web_url "$candidate" exists; rc=$?
	[ "$rc" -eq 0 ] && misrouted+=("$candidate")
	[ "$rc" -gt 1 ] && misrouted+=("$candidate(rc=$rc)")
done
if ((${#misrouted[@]} == 0)); then
	echo "[PASS] all ${#url_shaped_filenames[@]} url-shaped filenames stayed local when present on disk"
else
	echo "[FAIL] would have opened a browser for existing paths: ${misrouted[*]}" >&2
	((fails++))
fi

((tests++))
echo "Testing: the same strings ARE urls when no such path exists..."
lost=()
for candidate in "${url_shaped_filenames[@]}" "${bare_domains[@]}"; do
	should_open_as_web_url "$candidate" absent; rc=$?
	[ "$rc" -eq 0 ] || lost+=("$candidate(rc=$rc)")
done
if ((${#lost[@]} == 0)); then
	echo "[PASS] every domain-shaped string still resolves as a url when absent from disk"
else
	echo "[FAIL] no longer recognized as urls: ${lost[*]}" >&2
	((fails++))
fi

((tests++))
echo "Testing: an explicit http(s):// scheme outranks even an existing path..."
shadowed=()
for candidate in "${scheme_urls[@]}"; do
	should_open_as_web_url "$candidate" exists; rc=$?
	[ "$rc" -eq 0 ] || shadowed+=("$candidate(rc=$rc)")
done
if ((${#shadowed[@]} == 0)); then
	echo "[PASS] scheme-qualified urls are unaffected by the filesystem"
else
	echo "[FAIL] a local path suppressed an explicit url: ${shadowed[*]}" >&2
	((fails++))
fi

# ── End to end: the predicate above is worthless if show ignores it ───────────
route_dir="$(mktemp --tmpdir -d show_route.XXXXXX)"
route_bin="$route_dir/bin"
mkdir -p "$route_bin"
export BROWSER_LOG="$route_dir/browser.log" RENDER_LOG="$route_dir/render.log"

# Every browser show knows how to launch, faked. Any one of them firing on a
# local file is the bug. $BASH rather than /usr/bin/env: these are written at
# run time, so no shebang patching ever sees them.
for _b in clx reader links browsh; do
	{
		printf '#!%s\n' "$BASH"
		printf 'printf "%%s %%s\\n" %q "$*" >> "$BROWSER_LOG"\n' "$_b"
	} > "$route_bin/$_b"
	chmod +x "$route_bin/$_b"
done
# glow is how show renders markdown: record the call, then emit the content.
{
	printf '#!%s\n' "$BASH"
	printf 'printf "glow %%s\\n" "$*" >> "$RENDER_LOG"\n'
	printf 'cat "$@"\n'
} > "$route_bin/glow"
chmod +x "$route_bin/glow"

cat > "$route_dir/README.md" <<'EOF'
# The canary

```bash
#!/usr/bin/env bash
printf 'the-canary-line\n'
```
EOF
chmod +x "$route_dir/README.md"

((tests++))
echo "Testing: show README.md renders the file and launches no browser..."
: > "$BROWSER_LOG"
route_out=$(cd "$route_dir" && PATH="$route_bin:$repo_dir/bin:$PATH" \
	bash -c 'source "'"$show_script"'"; show README.md' 2>"$route_dir/stderr")
if [ ! -s "$BROWSER_LOG" ] \
	&& printf '%s' "$route_out" | grep -q 'the-canary-line' \
	&& grep -q 'Markdown document' "$route_dir/stderr" \
	&& ! grep -qi 'bash.*file' "$route_dir/stderr"; then
	echo "[PASS] show README.md rendered the local file, no browser launched"
else
	echo "[FAIL] show README.md was misrouted" >&2
	echo "  browsers launched: $(tr '\n' ' ' < "$BROWSER_LOG")" >&2
	echo "  stdout: $route_out" >&2
	((fails++))
fi

((tests++))
echo "Testing: show <bare domain> still opens a browser when no such file exists..."
: > "$BROWSER_LOG"
(cd "$route_dir" && PATH="$route_bin:$repo_dir/bin:$PATH" \
	bash -c 'source "'"$show_script"'"; show example.com' >/dev/null 2>&1)
if [ -s "$BROWSER_LOG" ]; then
	echo "[PASS] a bare domain with no local file still reaches the browser"
else
	echo "[FAIL] bare domains no longer open a browser; the url path is dead" >&2
	((fails++))
fi

# ── A url that was handled is not an "undefined" name ────────────────────────
# After opening the browser, show fell through to the type lookup, found that
# "example.com" is not a function/alias/builtin/file, warned that it was
# undefined and returned 1. Every one of those is wrong: the word was resolved,
# and by the loudest possible means — a browser.

((tests++))
echo "Testing: a handled url is not then reported as undefined..."
: > "$BROWSER_LOG"
url_out=$(cd "$route_dir" && PATH="$route_bin:$repo_dir/bin:$PATH" \
	bash -c 'source "'"$show_script"'"; show example.com' 2>&1)
url_rc=$?
if [ "$url_rc" -eq 0 ] && ! printf '%s' "$url_out" | grep -q "'example.com' is undefined"; then
	echo "[PASS] a handled url exits 0 and is not called undefined"
else
	echo "[FAIL] a handled url was reported undefined and/or failed" >&2
	echo "  exit: $url_rc" >&2
	echo "  output: $url_out" >&2
	((fails++))
fi

# The obvious wrong fix is an early `return 0` from the url branch, which would
# silently swallow every argument after the url. `cd` is used as the trailing
# probe because it resolves through `type -t` alone, with no dependency on the
# var_defined helper that is not on PATH here.
((tests++))
echo "Testing: arguments after a url are still processed..."
: > "$BROWSER_LOG"
multi_out=$(cd "$route_dir" && PATH="$route_bin:$repo_dir/bin:$PATH" \
	bash -c 'source "'"$show_script"'"; show example.com cd' 2>&1)
multi_rc=$?
if [ "$multi_rc" -eq 0 ] && printf '%s' "$multi_out" | grep -q "'cd' is a builtin" \
	&& [ -s "$BROWSER_LOG" ]; then
	echo "[PASS] show <url> <name> handles both the url and the trailing name"
else
	echo "[FAIL] arguments following a url were dropped" >&2
	echo "  exit: $multi_rc" >&2
	echo "  browsers launched: $(tr '\n' ' ' < "$BROWSER_LOG")" >&2
	echo "  output: $multi_out" >&2
	((fails++))
fi
rm -rf "$route_dir"
if (( fails == 0 )); then
	echo "show_test PASSED: all $tests tests passed"
else
	echo "show_test FAILED: $fails of $tests tests failed" >&2
fi

exit $fails
