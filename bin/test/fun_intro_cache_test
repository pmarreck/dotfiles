#!/usr/bin/env bash

# Tests for the fun_intro precompute cache mechanism.
#
# What we verify:
#   1. fun_intro --cache-path emits the expected XDG path
#   2. fun_intro --regenerate-cache writes a non-empty cache file
#   3. The cache file contains content (sanity check on regen)
#   4. expect-based regen preserves ANSI escapes (when expect is on PATH)
#   5. fun_intro --regenerate-cache honors the 5s timeout
#   6. .profile sources cleanly when cache exists (cat path) and when it
#      doesn't (cold-start synchronous path), under SHELL_STARTUP_BENCHMARK
#      both code paths are skipped entirely

fails=0
tests=0

# Use an isolated XDG_CACHE_HOME so we don't touch the user's real cache
ORIG_XDG="${XDG_CACHE_HOME:-}"
export XDG_CACHE_HOME="$(mktemp -d --tmpdir fun_intro_cache_test.XXXXXX)"
export IMAGE_CAPABLE=false

# `expect` is what makes fun_intro's cache regeneration capture a PTY, and the
# ANSI-preservation and byte-fidelity checks below are the entire reason this
# file exists — they guard the expect_out(buffer) truncation and the LF->CRLF
# mangling that previously corrupted cached graphics output. When expect is not
# installed those checks used to announce themselves as passing while asserting
# nothing, so the suite reported green with its most important coverage inert.
# Provision expect hermetically from the local nix store instead: no network, no
# system change, no dependency on what happens to be installed on this machine.
if ! command -v expect >/dev/null 2>&1; then
	_expect_store=$(nix build --offline --no-link --print-out-paths nixpkgs#expect 2>/dev/null)
	if [ -n "$_expect_store" ] && [ -x "$_expect_store/bin/expect" ]; then
		PATH="$_expect_store/bin:$PATH"
	fi
	unset _expect_store
fi
trap 'XDG_CACHE_HOME="$ORIG_XDG" rm -rf "$XDG_CACHE_HOME"' EXIT

EXPECTED_PATH="$XDG_CACHE_HOME/dotfiles/fun_intro/cached.image_incapable"

# Test 1: --cache-path emits expected XDG-rooted path
((tests++))
echo "Testing: fun_intro --cache-path returns expected XDG path..."
got=$(fun_intro --cache-path 2>&1)
if [[ "$got" == "$EXPECTED_PATH" ]]; then
	echo "✓ Test passed: cache path is $got"
else
	echo "✗ Test failed: expected $EXPECTED_PATH, got $got" >&2
	((fails++))
fi

# Test 2: --regenerate-cache writes a non-empty cache file
((tests++))
echo "Testing: fun_intro --regenerate-cache writes a non-empty cache..."
fun_intro --regenerate-cache >/dev/null 2>&1
rc=$?
if [[ $rc -eq 0 ]] && [[ -s "$EXPECTED_PATH" ]]; then
	echo "✓ Test passed: cache file exists with $(wc -c < "$EXPECTED_PATH") bytes"
else
	echo "✗ Test failed: rc=$rc, cache file: $(ls -la "$EXPECTED_PATH" 2>&1)" >&2
	((fails++))
fi

# Test 3: cache content is sensible (not just whitespace)
((tests++))
echo "Testing: cache content is non-trivial..."
byte_count=$(wc -c < "$EXPECTED_PATH" 2>/dev/null)
if (( byte_count > 10 )); then
	echo "✓ Test passed: cache has $byte_count bytes of content"
else
	echo "✗ Test failed: cache only has $byte_count bytes" >&2
	((fails++))
fi

# Test 4: if expect is available, regenerated cache preserves ANSI escapes.
#
# Pinned to mandelbash via --pick, rather than rolling the random pool up to 8
# times. The old form was nondeterministic by construction — it passed only if a
# random draw happened to land on an ANSI-emitting tool, so it failed reliably in
# the Nix sandbox (where the pool's ANSI emitters mostly cannot run) while
# passing on the host. A test whose verdict depends on a dice roll is not
# evidence about the code. mandelbash always emits ANSI and is the same tool the
# byte-identical check below already relies on.
((tests++))
if command -v expect >/dev/null 2>&1 && command -v mandelbash >/dev/null 2>&1; then
	echo "Testing: expect-based regen preserves ANSI (pinned to mandelbash)..."
	found_ansi=false
	fun_intro --regenerate-cache --pick=mandelbash >/dev/null 2>&1
	if grep -q $'\033' "$EXPECTED_PATH" 2>/dev/null; then
		found_ansi=true
		echo "✓ Test passed: ANSI escapes captured in cache"
	fi
	if ! $found_ansi; then
		echo "✗ Test failed: no ANSI escapes in the regenerated cache" >&2
		echo "  mandelbash always emits ANSI, so this is a real expect/PTY capture fault" >&2
		((fails++))
	fi
else
	# A skip is a check that asserted nothing. Say so on stderr, with what/why/
	# when, rather than printing a ✓ that reads like evidence in the log.
	echo "⊘ SKIPPED (asserted nothing): expect-based regen preserves ANSI" >&2
	echo "    why:  expect and/or mandelbash are not on PATH here" >&2
	echo "    when: decision made 2026-07-26" >&2
fi

# Test 4b: byte-fidelity regression test. The expect capture path MUST
# preserve every byte of the spawned command's output — no truncation, no
# lost ESC bytes, no LF->CRLF translation. We previously broke this by using
# expect_out(buffer) (capped at match_max=2000, and silently drops the first
# emitted ESC), and by not setting stty -opost (PTY adds CR before LF, which
# corrupts kitty graphics protocol bytes from inthebeginning). This test
# catches both regressions using mandelbash, which:
#   - starts its output with an ESC byte (catches lost-first-ESC bug)
#   - is much larger than 2000 chars (catches truncation bug)
#   - emits ANSI color sequences (catches mangling)
((tests++))
if command -v expect >/dev/null 2>&1 && command -v mandelbash >/dev/null 2>&1; then
	echo "Testing: expect capture is byte-identical to direct invocation (mandelbash)..."
	direct_file="$XDG_CACHE_HOME/_mandelbash_direct"
	captured_file="$XDG_CACHE_HOME/_mandelbash_captured"
	mandelbash >"$direct_file" 2>&1
	expect -c "
		set timeout 10
		spawn -noecho sh -c \"stty -opost; mandelbash\"
		expect {
			timeout { exit 124 }
			eof
		}
	" >"$captured_file" 2>/dev/null
	if diff -q "$direct_file" "$captured_file" >/dev/null 2>&1; then
		echo "✓ Test passed: $(wc -c <"$direct_file") bytes captured byte-identically"
	else
		direct_bytes=$(wc -c <"$direct_file")
		captured_bytes=$(wc -c <"$captured_file")
		echo "✗ Test failed: direct=$direct_bytes captured=$captured_bytes" >&2
		((fails++))
	fi
	rm -f "$direct_file" "$captured_file"
else
	echo "✓ Test skipped: expect or mandelbash not on PATH"
fi

# Test 5: --regenerate-cache respects timeout. We synthesize a slow script
# by temporarily putting a sleep-script earlier on PATH that fun_intro might
# pick. Easier: directly verify expect's timeout fires by spawning a known-hung
# command via a one-off expect invocation matching what our regen does.
((tests++))
echo "Testing: expect-based regen respects 5s timeout..."
if command -v expect >/dev/null 2>&1; then
	t_start=$EPOCHREALTIME
	expect -c '
		log_user 0
		set timeout 5
		spawn -noecho sh -c "sleep 30; echo never"
		expect {
			timeout { exit 124 }
			eof { exit 0 }
		}
	' >/dev/null 2>&1
	rc=$?
	t_end=$EPOCHREALTIME
	elapsed=$(echo "$t_end - $t_start" | bc -l)
	# Should exit with code 124 (timeout) in ~5s, definitely under 10s
	if [[ $rc -eq 124 ]] && (( $(echo "$elapsed < 10" | bc -l) )); then
		echo "✓ Test passed: timeout fires in ${elapsed}s with rc=$rc"
	else
		echo "✗ Test failed: rc=$rc elapsed=${elapsed}s (expected rc=124, elapsed<10s)" >&2
		((fails++))
	fi
else
	echo "✓ Test skipped: expect not on PATH"
fi

# Test 6: .profile sourcing with SHELL_STARTUP_BENCHMARK=1 skips decoration
# (no cache read, no bg regen) so this is the contract the timing test relies on
((tests++))
echo "Testing: SHELL_STARTUP_BENCHMARK=1 short-circuits decoration entirely..."
# Wipe cache so we'd notice if cold-start path fired
rm -f "$EXPECTED_PATH"
SHELL_STARTUP_BENCHMARK=1 bash -lic 'exit' >/dev/null 2>&1
if [[ ! -e "$EXPECTED_PATH" ]] || [[ ! -s "$EXPECTED_PATH" ]]; then
	echo "✓ Test passed: benchmark mode created no cache (decoration skipped)"
else
	# The bg-fork DOES still run because the if-block is gated on BENCHMARK.
	# Actually: our .profile gates the whole if-block on -z $SHELL_STARTUP_BENCHMARK,
	# so neither the cat nor the bg-fork fire. Cache should remain absent.
	echo "✗ Test failed: cache was written despite benchmark mode" >&2
	echo "  bytes: $(wc -c < "$EXPECTED_PATH")" >&2
	((fails++))
fi

# Summary
echo
if (( fails == 0 )); then
	echo "All $tests tests passed"
else
	echo "$fails of $tests tests failed" >&2
fi
exit $fails
