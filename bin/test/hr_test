#!/usr/bin/env bash

set -uo pipefail

fails=0
tests=0
tmp_dir=$(mktemp -d --tmpdir hr_test.XXXXXX)
trap 'rm -rf "$tmp_dir"' EXIT

# Count codepoints without depending on the caller's locale. `wc -m` and awk's
# length() both count BYTES under LC_ALL=C, so hr's five box-drawing glyphs
# measure as fifteen and the width assertions fail on any C-locale host while
# passing on the author's. Every UTF-8 codepoint has exactly one lead byte, so
# deleting the continuation bytes (0x80-0xBF) and counting what remains is
# exact and needs no locale to be installed — C.UTF-8 is glibc-only, and these
# dotfiles run on macOS too.
utf8_len() {
	printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | LC_ALL=C wc -c | tr -d ' '
}

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
hr_cmd=${HR_BIN:-"$script_dir/../hr"}
if [[ ! -x "$hr_cmd" ]]; then
	echo "hr_test: unable to locate hr executable at $hr_cmd" >&2
	exit 1
fi

((tests++))
echo "Testing: hr --help shows usage..."
if "$hr_cmd" --help >"$tmp_dir/help" 2>&1; then
	if grep -q "Usage: hr" "$tmp_dir/help"; then
		echo "✓ Test passed: help text present"
	else
		echo "✗ Test failed: help text missing" >&2
		((fails++))
	fi
else
	echo "✗ Test failed: hr --help exited non-zero" >&2
	((fails++))
fi

((tests++))
echo "Testing: hr honors HR_WIDTH for output length..."
output=$(HR_WIDTH=5 "$hr_cmd")
strip=$(printf '%s' "$output" | tr -d '\n')
count=$(utf8_len "$strip")
if [[ "$count" == "5" ]]; then
	if [[ "$strip" == "─────" ]]; then
		echo "✓ Test passed: width and fill match"
	else
		echo "✗ Test failed: output does not match expected line" >&2
		((fails++))
	fi
else
	echo "✗ Test failed: expected length 5, got $count" >&2
	((fails++))
fi

((tests++))
echo "Testing: hr detects a deterministic PTY width..."
pty_line=$(
	HR_CMD="$hr_cmd" expect <<'EXPECT'
set timeout 5
log_user 0
spawn -noecho sh -c {unset HR_WIDTH COLUMNS; stty cols 37; exec "$HR_CMD"}
expect {
	eof {}
	timeout {
		puts stderr "hr_test: timed out waiting for PTY output"
		exit 124
	}
}
set child_status [wait]
puts -nonewline $expect_out(buffer)
exit [lindex $child_status 3]
EXPECT
)
pty_status=$?
pty_strip=$(printf '%s' "$pty_line" | tr -d '\r\n')
pty_count=$(utf8_len "$pty_strip")
pty_non_rule=${pty_strip//─/}
if [[ "$pty_status" -eq 0 && "$pty_count" == "37" && -z "$pty_non_rule" ]]; then
	echo "✓ Test passed: terminal width respected"
else
	echo "✗ Test failed: expected 37 rule glyphs, got status $pty_status and width $pty_count" >&2
	((fails++))
fi

echo "All $tests tests completed"
exit $fails
