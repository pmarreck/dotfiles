#!/usr/bin/env bash
# shellcheck disable=SC2329,SC2016
# Hermetic CLI tests: fake only the Herdr process boundary, exercise real files/argv.
set -u
# Assertion callbacks are indirect; jq owns its $variables.
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/erect-herdr-test.XXXXXX")"
trap 'rm -rf -- "$tmp"' EXIT
export EAS_FIXTURE="$tmp" EAS_PROJECT="$tmp/a project"
export ERECT_STATE_DIR="$tmp/state" HERDR_ENV=1
export ERECT_HERDR="$root/bin/test/fixtures/erect-agent-stack/herdr"
mkdir -p "$EAS_PROJECT"
tool="$root/bin/erect-agent-stack"
fails=0
check() { if ! "$@" > "$tmp/check.out" 2> "$tmp/check.err"; then printf 'FAIL: %s\n' "$*" >&2; fails=$((fails+1)); fi; }
reset_fixture() {
 printf '{"result":{"agents":[]}}\n' > "$tmp/agents.json"
 printf '{"result":{"workspaces":[]}}\n' > "$tmp/workspaces.json"
 jq -n --arg cwd "$EAS_PROJECT" '{result:{panes:[{pane_id:"wOLD:p9",workspace_id:"wOLD",cwd:$cwd}]}}' > "$tmp/panes.json"
 printf '{"result":{"process_info":{"shell_pid":10,"foreground_process_group_id":10,"foreground_processes":[{"pid":10,"name":"bash"}]}}}\n' > "$tmp/process.json"
 : > "$tmp/calls"
}
run() { "$tool" "$@" > "$tmp/out" 2> "$tmp/err"; status=$?; }
calls_are_readonly() { jq -se 'all(.[]; .[1] == "list" or .[1] == "get" or .[1] == "process-info")' "$tmp/calls" >/dev/null; }
called() { jq -se --arg cmd "$1" 'any(.[]; (.[0:2]|join(" ")) == $cmd)' "$tmp/calls" >/dev/null; }
reset_fixture
run --help
check test "$status" = 0
check grep -q Herdr "$tmp/out"
run --about
check test "$status" = 0
run
check test "$status" = 64
run --agent
check test "$status" = 64
run --bogus "$EAS_PROJECT"
check test "$status" = 64
run "$tmp/missing"
check test "$status" = 66
HERDR_ENV='' run --fresh "$EAS_PROJECT"
check test "$status" = 78
check test ! -s "$tmp/calls"

# First adoption must not silently abandon an older, unrecorded conversation.
run --no-attach "$EAS_PROJECT"
check test "$status" = 69
check calls_are_readonly
check grep -q 'no saved' "$tmp/err"
rmdir "$ERECT_STATE_DIR" 2>/dev/null || :

run --dry-run --fresh --agent codex "$EAS_PROJECT"
check test "$status" = 0
check calls_are_readonly
check test ! -e "$ERECT_STATE_DIR"
check grep -q 'codex' "$tmp/out"
check grep -q 'dry-run' "$tmp/out"

reset_fixture
run --fresh --agent codex --no-attach "$EAS_PROJECT"
check test "$status" = 0
check called 'workspace create'
check called 'agent start'
check jq -se 'any(.[]; .[0:2]==["workspace","create"] and index("--no-focus")!=null)' "$tmp/calls"
check jq -se 'any(.[]; .[0:2]==["agent","start"] and index("wNEW:p7")!=null and index("--dangerously-bypass-approvals-and-sandbox")!=null)' "$tmp/calls"
check grep -q created "$tmp/out"
check test -d "$ERECT_STATE_DIR"

# Auto-resume reads the saved exact identity rather than switching to Claude.
reset_fixture
run --no-attach "$EAS_PROJECT"
check test "$status" = 0
check jq -se 'any(.[]; .[0:2]==["agent","start"] and index("codex")!=null and index("resume")!=null and index("native-session-123")!=null)' "$tmp/calls"

# Existing live agent is not restarted, even when --fresh is supplied.
reset_fixture
jq -n --arg cwd "$EAS_PROJECT" '{result:{agents:[{agent:"grok",agent_status:"working",cwd:$cwd,pane_id:"wLIVE:p3",workspace_id:"wLIVE",agent_session:{kind:"id",value:"grok-id"}}]}}' > "$tmp/agents.json"
run --fresh --agent claude --no-attach "$EAS_PROJECT"
check test "$status" = 0
check calls_are_readonly
check grep -q joined-running "$tmp/out"

# A detected client at a trust/login dialog is alive, but not a ready stack.
jq '.result.agents[0].agent_status="blocked"' "$tmp/agents.json" > "$tmp/blocked.json"
mv "$tmp/blocked.json" "$tmp/agents.json"
: > "$tmp/calls"
run --no-attach "$EAS_PROJECT"
check test "$status" = 69
check calls_are_readonly
check grep -q blocked "$tmp/err"

# Existing shell workspace is retained.
reset_fixture
printf '{"result":{"workspaces":[{"workspace_id":"wOLD","label":"a-project"}]}}\n' > "$tmp/workspaces.json"
run --fresh --agent claude --no-attach "$EAS_PROJECT"
check test "$status" = 0
check jq -se 'all(.[]; .[0:2]!=["workspace","create"])' "$tmp/calls"
check jq -se 'any(.[]; .[0:2]==["agent","start"] and index("wOLD:p9")!=null)' "$tmp/calls"
check grep -q joined-launched "$tmp/out"

# An editor in an agentless pane must not receive a shell command.
printf '{"result":{"process_info":{"shell_pid":10,"foreground_process_group_id":22,"foreground_processes":[{"pid":22,"name":"vim"}]}}}\n' > "$tmp/process.json"
: > "$tmp/calls"
run --fresh --agent claude "$EAS_PROJECT"
check test "$status" = 69
check calls_are_readonly

# Ambiguous live projects are not resolved by focus or sidebar order.
reset_fixture
jq -n --arg cwd "$EAS_PROJECT" '{result:{agents:[{agent:"claude",cwd:$cwd,pane_id:"w1:p1"},{agent:"codex",cwd:$cwd,pane_id:"w2:p1"}]}}' > "$tmp/agents.json"
run "$EAS_PROJECT"
check test "$status" = 69
check calls_are_readonly

# Malformed discovery cannot be interpreted as an empty fleet.
reset_fixture
printf '{}\n' > "$tmp/agents.json"
run --fresh "$EAS_PROJECT"
check test "$status" = 69
check calls_are_readonly

# A start timeout sends exactly one start and no speculative resume/fresh/ping.
reset_fixture
EAS_FAIL_START=1 run --fresh "$EAS_PROJECT"
check test "$status" = 69
check jq -se '[.[]|select(.[0:2]==["agent","start"])]|length==1' "$tmp/calls"
check jq -se 'all(.[]; .[0:2]!=["agent","prompt"] and .[0:2]!=["pane","run"])' "$tmp/calls"

# Explicit resume selection and full permissions for all supported backends.
for backend in claude codex grok gemini; do
 reset_fixture
 run --agent "$backend" --resume exact-id --no-attach "$EAS_PROJECT"
 check test "$status" = 0
 check jq -se --arg kind "$backend" 'any(.[]; .[0:2]==["agent","start"] and index($kind)!=null and index("exact-id")!=null)' "$tmp/calls"
done

reset_fixture
run --fresh --checker "$EAS_PROJECT"
check test "$status" = 0
check jq -se 'any(.[]; .[0:2]==["workspace","create"] and index("MFIC_ROLE=checker")!=null)' "$tmp/calls"
reset_fixture
run --continue --agent claude "$EAS_PROJECT"
check test "$status" = 0
check jq -se 'any(.[]; .[0:2]==["agent","start"] and index("--continue")!=null)' "$tmp/calls"

# Sourcing remains supported, and no terminal input is ever sent by the launcher.
reset_fixture
EAS_WRONG_ID=different run --resume intended --agent codex "$EAS_PROJECT"
check test "$status" = 69
check grep -q 'identity' "$tmp/err"

reset_fixture
printf '{"result":{"agents":[{}]}}\n' > "$tmp/agents.json"
run --fresh "$EAS_PROJECT"
check test "$status" = 69
check calls_are_readonly

bash -c 'source "$1"; erect-agent-stack --help' _ "$tool" > "$tmp/sourced" 2> "$tmp/source.err"
check test "$?" = 0
check grep -q Herdr "$tmp/sourced"
if [ "$fails" = 0 ]; then printf 'erect-agent-stack Herdr tests passed\n'; fi
exit "$fails"
