#!/usr/bin/env luajit

local source_path = debug.getinfo(1, "S").source:sub(2)
local script_dir = source_path:match("^(.*)/[^/]+$") or "."
package.path = script_dir .. "/src/?.lua;" .. package.path

local random = require("secure_random")
local utf8_text = require("utf8_text")

local DEFAULT_CHARSET = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ0123456789"

local function help()
	io.write([[Usage: randompass <length>
Generate random text from the sane alphanumeric character set.
Set PWCHARSET to replace the character set and RANDOM_SOURCE to replace
/dev/random. PWCHARSET is interpreted as UTF-8 code points.
]])
end

if #arg == 0 then
	help()
	os.exit(1)
end

if arg[1] == "--help" then
	help()
	os.exit(0)
end

local length_text = arg[1]
if not length_text:match("^%d+$") then
	io.stderr:write("Error: length must be a non-negative integer.\n")
	os.exit(1)
end
local length = tonumber(length_text)

local charset = os.getenv("PWCHARSET")
if not charset or charset == "" then
	charset = DEFAULT_CHARSET
end
local characters, charset_error = utf8_text.codepoints(charset)
if not characters then
	io.stderr:write("Error: PWCHARSET contains ", charset_error, ".\n")
	os.exit(1)
end
if #characters == 0 then
	io.stderr:write("Error: PWCHARSET must contain at least one character.\n")
	os.exit(1)
end

local random_path = os.getenv("RANDOM_SOURCE")
if not random_path or random_path == "" then
	random_path = "/dev/random"
end
local read_four, random_file_or_error = random.open_reader(random_path)
if not read_four then
	io.stderr:write("Error: ", random_file_or_error, ".\n")
	os.exit(1)
end
local random_file = random_file_or_error

local result = {}
for index = 1, length do
	local selected, sample_error = random.sample_index(read_four, #characters)
	if not selected then
		random_file:close()
		io.stderr:write("Error: ", sample_error, ".\n")
		os.exit(1)
	end
	result[index] = characters[selected]
end
random_file:close()

io.write(table.concat(result), "\n")
