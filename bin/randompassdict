#!/usr/bin/env luajit

local ffi = require("ffi")
local source_path = debug.getinfo(1, "S").source:sub(2)
local script_dir = source_path:match("^(.*)/[^/]+$") or "."
package.path = script_dir .. "/src/?.lua;" .. package.path

local core = require("randompassdict_core")
local random = require("secure_random")
local utf8_text = require("utf8_text")

local function help(stream)
	stream:write([[Usage: randompassdict [OPTIONS] NUM_WORDS [WORD_LENGTH]

Generate a space-delimited passphrase by uniformly sampling dictionary words
with replacement. WORD_LENGTH accepts an exact N or an inclusive M-N or M..N
range and defaults to 4-14. Selection reads directly from /dev/urandom and
fails closed if secure selection is unavailable. Duplicate and
whitespace-bearing dictionary entries do not add entropy.

Options:
	-h, --help          Show this help
	--about             Show version and platform information
	--no-proper-nouns   Exclude words matching ASCII ^[A-Z][a-z]
	--american          Use the American SCOWL corpus
	--british           Use the British SCOWL corpus

The later of --american and --british wins. Without either option, a native
locale whose territory is US selects American spellings; all other locales
select British spellings.
]])
end

local arguments = {}
for index = 1, #arg do
	arguments[index] = arg[index]
end
local options, parse_error = core.parse_args(arguments)
if not options then
	if #arguments == 0 then
		help(io.stderr)
	else
		io.stderr:write("Error: ", parse_error, ".\n")
	end
	os.exit(2)
end

if options.mode == "help" then
	help(io.stdout)
	os.exit(0)
elseif options.mode == "about" then
	io.write(string.format(
		"randompassdict 2.0.0 - cryptographic dictionary-passphrase generator (%s/%s)\n",
		ffi.os, ffi.arch))
	os.exit(0)
end

if not options.variant then
	-- Only the character locale carries the territory signal we need. Changing
	-- every locale category would also localize numeric formatting as a side
	-- effect, even though this command's UI is intentionally not localized.
	options.variant = core.variant_for_locale(os.setlocale("", "ctype"))
end

local dictionary_path = os.getenv("WORDLIST_FILEPATH")
if not dictionary_path or dictionary_path == "" then
	if options.variant == "american" then
		dictionary_path = script_dir .. "/data/dictionary-american.txt"
	else
		dictionary_path = script_dir .. "/data/dictionary.txt"
	end
end

local dictionary, dictionary_error = io.open(dictionary_path, "rb")
if not dictionary then
	io.stderr:write("Error: cannot open dictionary ", dictionary_path, ": ",
		dictionary_error, ".\n")
	os.exit(1)
end
local pool, filter_error = core.filter_dictionary(
	dictionary,
	options.minimum,
	options.maximum,
	options.no_proper_nouns,
	utf8_text
)
dictionary:close()
if not pool then
	io.stderr:write("Error: ", filter_error, ".\n")
	os.exit(1)
end
if #pool == 0 then
	io.stderr:write("Error: dictionary contains no usable words in the requested length range.\n")
	os.exit(1)
end

local dictionary_only = os.getenv("JUST_OUTPUT_DICTIONARY")
if dictionary_only and dictionary_only ~= "" then
	for _, word in ipairs(pool) do
		io.write(word, "\n")
	end
	os.exit(0)
end

local read_four, random_file_or_error = random.open_reader("/dev/urandom")
if not read_four then
	io.stderr:write("Error: ", random_file_or_error, ".\n")
	os.exit(1)
end
local random_file = random_file_or_error
local selected = {}
for index = 1, options.count do
	local pool_index, sample_error = random.sample_index(read_four, #pool)
	if not pool_index then
		random_file:close()
		io.stderr:write("Error: cryptographically secure word selection failed: ",
			sample_error, ".\n")
		os.exit(1)
	end
	selected[index] = pool[pool_index]
end
random_file:close()

io.write(table.concat(selected, " "), "\n")

local combinations = core.integer_power(#pool, options.count)
local grouped_combinations = core.group_integer(combinations)
local entropy_bits = options.count * math.log(#pool) / math.log(2)
io.stderr:write("\n")
io.stderr:write(string.format(
	"%d available words in the %s dictionary suit the requested length range [%d-%d].\n",
	#pool, options.variant, options.minimum, options.maximum))
if options.no_proper_nouns then
	io.stderr:write("Proper nouns matching ASCII ^[A-Z][a-z] were excluded.\n")
end
io.stderr:write(string.format(
	"%s possible combinations (%.3f bits of entropy); one-guess success odds are 1 in %s.\n",
	grouped_combinations, entropy_bits, grouped_combinations))
