#!/usr/bin/env luajit
-- Additional qualification for the host-only suites excluded from the Nix check.
local function q(s) return "'"..s:gsub("'","'\\''").."'" end
local function run(s)
	local p=assert(io.popen('('..s..') 2>/dev/null; printf "\\0%s" "$?"','r'))
	local data=p:read('*a'); p:close(); local body,status=data:match('^(.*)%z(%d+)$')
	if status=='0' then return body:gsub('[\r\n]+$','') end
end
local function refuse(s) io.stderr:write('Host test evidence: '..s..'\n'); os.exit(1) end
local action=arg[1]
if not ((action=='--key' or action=='--verify' or action=='--invalidate') and #arg==3)
	and not (action=='--record' and #arg==4) then
	refuse('usage: dotfiles-host-evidence --key|--verify|--invalidate ROOT REV; --record ROOT REV EXPECTED_KEY')
end
local root=run('git -C '..q(arg[2])..' rev-parse --show-toplevel')
if not root then refuse('not a Git checkout') end
local sha=run('git -C '..q(root)..' rev-parse --verify --end-of-options '..q(arg[3]..'^{commit}'))
if not sha then refuse('invalid revision') end
local osname=({Linux='linux',OSX='darwin'})[jit.os]
local arch=({x64='x86_64',arm64='aarch64'})[jit.arch]
if not osname or not arch then refuse('unsupported Nix host platform') end
local function tool_identity(name,version_argument)
	local path=run('command -v '..q(name))
	if not path then refuse('cannot find required host runtime: '..name) end
	local resolved=run('readlink -f '..q(path)) or run('realpath '..q(path)) or path
	local version=run(q(path)..' '..version_argument..' 2>&1 | head -n 1')
	if not version or version=='' then refuse('cannot identify host runtime version: '..name) end
	return table.concat({name,path,resolved,version},'|')
end
local runtimes=table.concat({
	tool_identity('bash','--version'),
	tool_identity('nix','--version'),
	tool_identity('git','--version'),
	tool_identity('luajit','-v'),
},'\n')
local kernel=run('uname -a'); if not kernel then refuse('cannot identify host kernel') end
local profile=run('readlink -f /run/current-system') or ''
local identity=table.concat({'host-tests-v4',root,sha,osname,arch,runtimes,kernel,profile},'\n')
local key=run('printf %s '..q(identity)..' | git hash-object --stdin'); if not key then refuse('cannot hash test identity') end
if action=='--key' then print(key); os.exit(0) end
local directory=(os.getenv('XDG_STATE_HOME') or (assert(os.getenv('HOME'))..'/.local/state'))..'/dotfiles-host-evidence'
local receipt=directory..'/'..key
local function read_receipt()
	local f=io.open(receipt,'rb'); local data=f and f:read('*a'); if f then f:close() end
	return data
end
local function require_clean()
	local status=run('git -C '..q(root)..' status --porcelain --untracked-files=normal')
	if status==nil then refuse('cannot inspect checkout cleanliness') end
	if status~='' then refuse('checkout is dirty; committed host evidence is forbidden') end
end
local function write_receipt(value)
	if not run('mkdir -p '..q(directory)) then refuse('cannot create evidence directory') end
	local temp=run('mktemp '..q(directory..'/.receipt.XXXXXXXX'))
	if not temp then refuse('cannot allocate evidence receipt') end
	local f=io.open(temp,'wb')
	if not f or not f:write(value) or not f:close() then os.remove(temp); refuse('cannot write evidence receipt') end
	if not os.rename(temp,receipt) then os.remove(temp); refuse('cannot publish evidence receipt') end
end
if action=='--verify' then
	if read_receipt()~='valid-pass\n' then
		refuse('missing matching supplemental host result for '..sha..'. No tests were run. In the clean checkout of that revision, run ./test explicitly.')
	end
	io.stderr:write('Host test evidence: matching supplemental result for '..sha..'.\n')
	os.exit(0)
end
require_clean()
if action=='--invalidate' then
	write_receipt('pending\n')
	os.exit(0)
end
if arg[4]~=key then refuse('runtime or commit identity changed during testing') end
if read_receipt()~='pending\n' then refuse('no invalidated receipt exists for this test run') end
write_receipt('valid-pass\n')
io.stderr:write('Host test evidence: recorded supplemental result for '..sha..'.\n')
