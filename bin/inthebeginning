#!/usr/bin/env luajit
-- inthebeginning: show the pre-rendered "In the beginning" image over Kitty or Sixel graphics.
local root = (arg[0]:match("^(.*)/[^/]+$") or ".") .. "/.."
package.path = root .. "/lib/?.lua;" .. package.path
os.exit(require("fun_intro.cli").pick_command("inthebeginning", arg, root))
