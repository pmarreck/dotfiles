#!/usr/bin/env luajit
-- fun_intro: print one random decoration, as interactive shells do at startup.
-- Run with --help for options.
local root = (arg[0]:match("^(.*)/[^/]+$") or ".") .. "/.."
package.path = root .. "/lib/?.lua;" .. package.path
os.exit(require("fun_intro.cli").fun_intro(arg, root))
