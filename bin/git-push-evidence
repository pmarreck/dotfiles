#!/usr/bin/env luajit
-- Query completed Nix checks for immutable pushed tips. Only --prepare builds.
local function quote(s) return "'"..s:gsub("'", "'\\''").."'" end
local function capture(command)
	local p=assert(io.popen('('..command..') 2>&1; printf "\\0%s" "$?"','r'))
	local data=p:read('*a'); p:close()
	local body,status=data:match('^(.*)%z(%d+)$'); return body,tonumber(status)
end
local function trim(s) return (s or ''):gsub('[\r\n]+$','') end
local function git(args) return capture('git '..args) end
local function fail(s) io.stderr:write('Push evidence: '..s..'\n'); os.exit(1) end
if arg[1]=='--help' or arg[1]=='-h' then
	print([[git-push-evidence [--check REV | --prepare REV | --evidence-commit REV]
Default: inspect git pre-push ref updates on stdin; never run tests.
--check: query already-realized checks for REV (also never runs tests).
--prepare: explicitly build the required checks for immutable REV.
--evidence-commit: print the commit whose evidence covers REV: REV itself, or the last code commit
when every commit since it changes only documentation (Markdown and similar). Such a tip reuses
that commit's evidence, and the push says so.
Checks: git config --add pushEvidence.check checks.SYSTEM.NAME;
otherwise committed .push-checks, then checks from .mechatron-prime/targets.
No declaration or no successful cached outputs means refusal.
A third-party fork's clone may name its upstream (git config pushEvidence.fork URL),
and a repository with no code to build may give the reason (git config pushEvidence.noCode REASON):
a pushed tip with no flake.nix is then exempt, and the exemption is printed.]])
	os.exit(0)
end
local prepare=arg[1]=='--prepare'
if #arg>0 and not ((prepare or arg[1]=='--check' or arg[1]=='--evidence-commit') and #arg==2) then fail('invalid arguments; use --help') end
local revisions={}
if #arg>0 then revisions[1]=arg[2]
else
	for line in io.lines() do
		local localref,sha,remoteref,remote=line:match('^(%S+) (%x+) (%S+) (%x+)$')
		if not localref or (#sha~=40 and #sha~=64) or #remote~=#sha then fail('malformed Git pre-push input') end
		if not sha:match('^0+$') and sha~=remote then revisions[#revisions+1]=sha end
	end
end
if #revisions==0 then os.exit(0) end
local root,rc=git('rev-parse --show-toplevel'); if rc~=0 then fail('a working repository is required') end
root=trim(root)
local url='git+file://'..root:gsub('[^%w/_.~-]',function(c) return string.format('%%%02X',c:byte()) end)
local configured,status=git('config --get-all pushEvidence.check')
if status~=0 and status~=1 then fail('cannot read required-check configuration') end
-- A third-party fork sets its own upstream's standard (SCS 2026-11-13): its clone names the upstream it forks, and a
-- tip with no flake.nix is then exempt. A tip with a flake keeps the full rule even when marked.
local fork,forkrc=git('config --get pushEvidence.fork'); fork=trim(fork)
if forkrc~=0 and forkrc~=1 then fail('cannot read pushEvidence.fork') end
if forkrc~=0 or fork=='' then fork=nil end
-- A repository with no code to build or test, such as notes, names the reason in pushEvidence.noCode (owner
-- 2026-11-27). As for a fork, only a tip with no flake.nix is exempt, and every push prints the reason.
local nocode,ncrc=git('config --get pushEvidence.noCode'); nocode=trim(nocode)
if ncrc~=0 and ncrc~=1 then fail('cannot read pushEvidence.noCode') end
if ncrc~=0 or nocode=='' then nocode=nil end
local exemption=(fork and ('a fork of '..fork)) or (nocode and ('a repository with no code ('..nocode..')'))
local host_os=({Linux='linux',OSX='darwin'})[jit.os]
local host_arch=({x64='x86_64',arm64='aarch64'})[jit.arch]
local host_prefix=host_os and host_arch and ('checks.'..host_arch..'-'..host_os..'.')
local function blob(sha,path)
	local kind,krc=git('ls-tree '..quote(sha)..' -- '..quote(path))
	if krc~=0 then fail('cannot inspect committed '..path) end
	if kind=='' then return nil end
	if not kind:match('^100%d+ blob ') then fail(path..' must be a regular committed file') end
	local data,drc=git('show '..quote(sha..':'..path)); if drc~=0 then fail('cannot read committed '..path) end
	return data
end
-- The no-code exemption is checked, not trusted: every file in the pushed tree must be an ordinary file of a
-- documentation or data type. Anything else, including a type not listed here, keeps the full rule.
local notes_extensions={md=true,markdown=true,txt=true,rst=true,adoc=true,org=true,json=true,yaml=true,yml=true,
	csv=true,tsv=true,png=true,jpg=true,jpeg=true,gif=true,svg=true,webp=true,pdf=true}
local notes_names={['.gitignore']=true,['.gitattributes']=true,['.dirtree-state']=true,LICENSE=true,COPYING=true,
	NOTICE=true,AUTHORS=true}
local function not_notes(sha)
	local listing,lrc=git('ls-tree -r -z --full-tree '..quote(sha)); if lrc~=0 then fail('cannot list '..sha) end
	local found={}
	for entry in listing:gmatch('([^%z]+)') do
		local mode,path=entry:match('^(%d+) %a+ %x+\t(.*)$')
		local name=path and path:match('([^/]+)$') or entry
		local extension=name:match('%.([^.]+)$')
		local listed=notes_names[name] or (extension and notes_extensions[extension:lower()])
		if mode~='100644' or not listed then found[#found+1]=path or entry end
	end
	return found
end
-- Documentation does not change what the checks build or test, so a tip whose commits since the last code change
-- touch only documentation reuses that commit's evidence (owner 2026-11-27). CI still tests the pushed tip. A .txt
-- file is documentation unless its path names tests, fixtures, data or examples, where tests read such files; a
-- rename is a deletion plus an addition.
local doc_extensions={md=true,markdown=true,mdx=true,rst=true,adoc=true,asciidoc=true,org=true}
local doc_names={README=true,CHANGELOG=true,CONTRIBUTING=true,LICENSE=true,COPYING=true,NOTICE=true,AUTHORS=true}
local function is_documentation(path)
	local name=path:match('([^/]+)$'); local extension=name:match('%.([^.]+)$')
	if not extension then return doc_names[name:upper()]==true end
	extension=extension:lower()
	if extension=='txt' then
		local lower=path:lower()
		for _,word in ipairs({'test','fixture','data','example'}) do
			if lower:find(word,1,true) then return false end
		end
		return true
	end
	return doc_extensions[extension]==true
end
local function documentation_only(parent,commit)
	local changed,crc=git('diff --no-renames --name-only -z '..quote(parent)..' '..quote(commit)..' --')
	if crc~=0 then fail('cannot compare '..commit..' with its parent') end
	for path in changed:gmatch('([^%z]+)') do
		if not is_documentation(path) then return false end
	end
	return true
end
-- The most recent first-parent ancestor (or the commit itself) whose own change is not documentation-only.
local function evidence_commit(sha)
	local current=sha
	for _=1,200 do
		local parent,prc=git('rev-parse --verify --quiet '..quote(current..'^1'))
		if prc~=0 then break end
		parent=trim(parent)
		if not documentation_only(parent,current) then break end
		current=parent
	end
	return current
end
if arg[1]=='--evidence-commit' then
	local sha,src=git('rev-parse --verify --end-of-options '..quote(arg[2]..'^{commit}'))
	if src~=0 then fail('revision does not resolve to a commit: '..arg[2]) end
	print(evidence_commit(trim(sha))); os.exit(0)
end
local installables,seen,exempt={},{},0
for _,revision in ipairs(revisions) do
	local sha,src=git('rev-parse --verify --end-of-options '..quote(revision..'^{commit}'))
	if src~=0 then fail('revision does not resolve to a commit: '..revision) end
	sha=trim(sha)
	if not seen[sha] and exemption and not blob(sha,'flake.nix') then
		if nocode and not fork then
			local found=not_notes(sha)
			if #found>0 then
				local shown={}
				for k=1,math.min(#found,5) do shown[k]=found[k] end
				fail('pushEvidence.noCode is set, but '..sha..' holds '..#found..' file(s) that are not notes or data, such as '..
					table.concat(shown,', ')..'; a repository with code needs a flake.nix with checks, not this exemption')
			end
		end
		seen[sha]=true; exempt=exempt+1
	elseif not seen[sha] then
		seen[sha]=true
		local base=evidence_commit(sha)
		if base~=sha then
			io.stderr:write('Push evidence: '..sha:sub(1,12)..' changes only documentation since '..base:sub(1,12)..
				"; verifying that commit's checks. CI still tests the pushed commit.\n")
			sha=base
		end
		if not blob(sha,'flake.nix') then fail(sha..' has no flake.nix; declare reproducible test checks first') end
		local declaration,manifest
		if status==0 then declaration=configured
		else
			declaration=blob(sha,'.push-checks')
			if not declaration then declaration=blob(sha,'.mechatron-prime/targets'); manifest=true end
		end
		local count,attributes=0,{}
		for line in (declaration or ''):gmatch('[^\r\n]+') do
			local attribute=line:gsub('#.*$',''):match('^%s*(.-)%s*$')
			if attribute~='' and (not manifest or (host_prefix and attribute:sub(1,#host_prefix)==host_prefix)) then
				if not attribute:match('^checks%.[%w_-]+%.[%w_.-]+$') or attribute:find('..',1,true) then
					fail('required attributes must be checks.SYSTEM.NAME, not package outputs or commands')
				end
				if not attributes[attribute] then
					attributes[attribute]=true; count=count+1
					installables[#installables+1]=url..'?allRefs=1&rev='..sha..'#'..attribute
				end
			end
		end
		if count==0 then fail('no required checks declared for '..sha..'; add committed .push-checks or configure pushEvidence.check') end
	end
end
if exempt>0 then
	io.stderr:write('Push evidence: exempt as '..exemption..'; no checks verified for '..exempt..' commit tip(s).\n')
	if nocode and not fork then
		io.stderr:write('Push evidence: ---------------------------------------------------------------------\n'..
			'Push evidence: NO TESTS WERE VERIFIED FOR THIS PUSH. This exemption is only for repositories\n'..
			'Push evidence: that hold notes and data, and it was granted because every pushed file is one.\n'..
			'Push evidence: If this repository should hold code, stop: remove pushEvidence.noCode and add a\n'..
			'Push evidence: flake.nix with checks. Never add code here to get around a failing check.\n'..
			'Push evidence: ---------------------------------------------------------------------\n')
	end
	if #installables==0 then os.exit(0) end
end
local args={}
for _,i in ipairs(installables) do args[#args+1]=quote(i) end
local operation=prepare and 'build --no-link --print-out-paths' or 'path-info --offline'
local command='nix '..operation..' --no-update-lock-file --no-write-lock-file --option allow-import-from-derivation false '..table.concat(args,' ')
if not prepare then
	local limit,lrc=git('config --get pushEvidence.timeoutSeconds'); limit=trim(limit)
	if lrc==1 then limit='10' elseif lrc~=0 or not limit:match('^[1-9]%d*$') or tonumber(limit)>120 then fail('pushEvidence.timeoutSeconds must be 1..120') end
	local timer,trc=capture('command -v timeout || command -v gtimeout')
	if trc~=0 then fail('GNU timeout is required for bounded verification') end
	command=quote(trim(timer))..' --kill-after=2s '..limit..'s '..command
else
	io.stderr:write('Preparing required test evidence explicitly; this may build and run tests.\n')
end
local output,result=capture(command)
if result~=0 then
	io.stderr:write(output or '')
	if not prepare then
		fail('missing, stale or unavailable cached check output (status '..tostring(result)..'). No tests were run. Prepare explicitly with git-push-evidence --prepare REV, then retry. Do not weaken test coverage to obtain green.')
	end
	fail('test preparation failed; no successful evidence was granted')
end
-- Do not accept an empty successful adapter response as positive evidence.
if not output:match('/nix/store/[a-z0-9]+%-[^\r\n]+') then fail('Nix returned no successful check output') end
io.stderr:write('Push evidence: verified '..#installables..' required check target(s) for the selected commit tip(s).\n')
