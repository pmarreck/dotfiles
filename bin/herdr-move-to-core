#!/usr/bin/env bash
# Move live coding agents from the Herdr TUI server to herdr-core (hc), one pane at a time.
#
# A running process cannot change terminal owners, so each agent is exited at a verified
# empty prompt and resumed under hc by its exact native session ID. The new terminal gets
# --no-parent so it outlives whatever started it. Every step is logged before it acts, and
# any doubt (a draft, a working agent, conflicting session evidence, an exit that does not
# happen) stops that pane without killing anything.
set -u

HERDR=${MOVE_HERDR:-herdr}
HC=${MOVE_HC:-hc}
HERDR_APP=${MOVE_HERDR_APP:-herdr-app}
LLMSEND_SCRIPTS=${LLMSEND_SCRIPTS:-$HOME/Code/llmsend/skills/llmsend/scripts}
LOG=${MOVE_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-migration/log.jsonl}
EXIT_TIMEOUT=${MOVE_EXIT_TIMEOUT:-30}
POLL=${MOVE_POLL:-0.5}

usage() {
	cat <<'EOF'
Usage: herdr-move-to-core [--app] [--dry-run] [--session ID] [--name NAME] PANE_ID...
       herdr-move-to-core --app [--dry-run] --workspace WORKSPACE_ID...

Moves each Herdr TUI pane's agent (claude, codex, grok or agy) into herdr-core:
exits it at a verified empty prompt, then resumes the same native conversation with
`hc run --bg --no-parent`. Panes are handled in order; a refusal skips that pane.

  --app         Recreate the pane's whole Herdr workspace as a Herdr app space with
                the same name and tabs: the agent's tab resumes the agent, every other
                tab is a shell in its folder. Needs an open Herdr window.
  --workspace W With --app: recreate a workspace that has no live agent as a space.
  --wait SECS   Wait up to SECS for a busy agent to become idle at an empty prompt
                instead of refusing it.
  --stop-background
                When Claude asks whether to stop its background work on exit, log the
                listed jobs and choose "Exit and stop tasks". Without it, the dialog is
                canceled and that agent is left running.
  --handoff     Allow the pane running this command (an agent moving itself). Start
                it detached, e.g. `setsid -f herdr-move-to-core --handoff --wait 900
                PANE`, then end the turn: it acts once the agent is idle.

  --dry-run     Inspect and print the plan; type nothing, start nothing.
  --session ID  The native session ID, for one pane whose ID has no stronger
                evidence (Codex records none). Conflicting evidence still refuses.
  --name NAME   The herdr-core terminal name, for one pane (default: the Herdr
                agent name, else the project directory's basename).

Exit status: 0 when every pane moved (or would, with --dry-run), 1 when any pane
was refused or failed, 2 for usage errors. Log: $XDG_STATE_HOME/herdr-migration/log.jsonl
EOF
}

say() { printf 'herdr-move-to-core: %s\n' "$*" >&2; }

log_event() { # JSON object on stdin-free args: jq expression args
	mkdir -p "${LOG%/*}" && chmod 700 "${LOG%/*}" 2>/dev/null
	jq -cn --arg when "$(date -Iseconds)" "$@" '$ARGS.named + {when: $when}' >>"$LOG"
	chmod 600 "$LOG" 2>/dev/null
}

# The process start time from /proc, so a reused PID is never mistaken for the agent.
start_identity() { [[ -r /proc/$1/stat ]] && awk '{sub(/^.*\) /, ""); print $20}' "/proc/$1/stat"; }

alive() { [[ $(start_identity "$1") == "$2" && -n $2 ]]; }

# Wall-clock deadlines, so a wait lasts as long as asked however long each poll takes.
now() { if [[ -n ${EPOCHREALTIME:-} ]]; then printf '%s\n' "${EPOCHREALTIME/,/.}"; else date +%s; fi; }
deadline() { awk -v n="$(now)" -v s="$1" 'BEGIN { printf "%.6f\n", n + s }'; }
past() { awk -v n="$(now)" -v d="$1" 'BEGIN { exit !(n >= d) }'; }

exit_command() {
	case $1 in
		codex) echo /quit ;;
		claude | grok | agy) echo /exit ;;
	esac
}

# The session file or lock each backend holds open names its conversation exactly.
fd_session() { # backend pid
	local link id=''
	for link in /proc/"$2"/fd/*; do
		link=$(readlink "$link" 2>/dev/null) || continue
		case $1:$link in
			grok:"$HOME"/.grok/sessions/*/events.jsonl) id=${link%/events.jsonl}; id=${id##*/} ;;
			agy:"$HOME"/.gemini/antigravity-cli/presence/*.lock) id=${link##*/}; id=${id%.lock} ;;
			claude:"$HOME"/.claude/projects/*.jsonl) id=${link##*/}; id=${id%.jsonl} ;;
			codex:"$HOME"/.codex/sessions/*rollout-*.jsonl) id=${link%.jsonl}; id=${id: -36} ;;
			*) continue ;;
		esac
		printf '%s\n' "$id"
	done | sort -u
}

# The session ID written in the original command line, if any (weakest evidence).
argv_session() { # backend argv...
	local backend=$1; shift
	local -a a=("$@")
	local i
	for ((i = 1; i < ${#a[@]}; i++)); do
		case $backend:${a[i]} in
			claude:--resume | claude:-r | grok:--resume | grok:-r | agy:--conversation | agy:--resume | agy:-r)
				[[ ${a[i + 1]:-} && ${a[i + 1]} != -* ]] && { echo "${a[i + 1]}"; return; } ;;
			agy:--conversation=* | agy:--resume=* | claude:--resume=* | grok:--resume=*) echo "${a[i]#*=}"; return ;;
			codex:resume) [[ ${a[i + 1]:-} && ${a[i + 1]} != -* ]] && { echo "${a[i + 1]}"; return; } ;;
		esac
	done
}

# The original command line without its session selection, plus an exact resume of ID.
resume_argv() { # backend id argv...
	local backend=$1 id=$2; shift 2
	local -a a=("$@") out=("$1")
	local i takes_value
	for ((i = 1; i < ${#a[@]}; i++)); do
		takes_value=0
		case $backend:${a[i]} in
			claude:-c | claude:--continue | claude:--fork-session | grok:-c | grok:--continue | grok:--fork-session | agy:-c | agy:--continue) continue ;;
			claude:--resume | claude:-r | grok:--resume | grok:-r | agy:--conversation | agy:--resume | agy:-r) takes_value=1 ;;
			claude:--session-id) i=$((i + 1)); continue ;;
			agy:--conversation=* | agy:--resume=* | claude:--resume=* | grok:--resume=*) continue ;;
			codex:resume) takes_value=1 ;;
			codex:--last) continue ;;
		esac
		if ((takes_value)); then
			[[ ${a[i + 1]:-} && ${a[i + 1]} != -* ]] && i=$((i + 1))
			continue
		fi
		out+=("${a[i]}")
	done
	case $backend in
		claude | grok) out+=(--resume "$id") ;;
		agy) out+=("--conversation=$id") ;;
		codex) out=("${out[0]}" resume "$id" "${out[@]:1}") ;;
	esac
	printf '%s\0' "${out[@]}"
}

# llmsend's tested composer reader: empty, draft or unknown, from an ANSI screen.
composer() { # backend; screen on stdin (so the program comes from a file descriptor)
	luajit <(printf '%s' "package.path = arg[1] .. '/?.lua;' .. package.path
local c = require('herdr_wake').composer(arg[2], io.read('*a'))
io.write(c.kind, '\t', ((c.text or ''):gsub('[\t\n]', ' ')), '\n')") "$LLMSEND_SCRIPTS" "$1"
}

screen() { "$HERDR" pane read "$1" --source visible --ansi 2>/dev/null; }

hc_name() {
	local n
	n=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9_-' '-')
	printf '%s' "${n:0:32}"
}

# The workspace's tabs in order, each with its first pane's folder: [{tab, label, cwd}].
workspace_tabs() { # workspace
	local tabs panes
	tabs=$("$HERDR" tab list --workspace "$1" 2>/dev/null) || return 1
	panes=$("$HERDR" pane list --workspace "$1" 2>/dev/null) || return 1
	jq -c --argjson panes "$panes" '[.result.tabs[] | . as $t | {tab: .tab_id, label: (.label // ""),
		cwd: ([$panes.result.panes[] | select(.tab_id == $t.tab_id) | (.cwd // .foreground_cwd)][0] // "")}]' <<<"$tabs"
}

workspace_label() {
	"$HERDR" workspace list 2>/dev/null | jq -r --arg w "$1" '.result.workspaces[] | select(.workspace_id == $w) | .label // ""'
}

space_exists() {
	"$HERDR_APP" ls 2>/dev/null | jq -e --arg n "$1" '[.spaces[]? | select(.name == $n)] | length > 0' >/dev/null
}

# Recreate a Herdr TUI workspace as a Herdr app space with its name and tabs, in order.
# The tab AGENT_TAB starts ARGV (the resumed agent); every other tab is a shell in its
# folder. Prints the agent's terminal address (empty without one).
recreate_space() { # name tabs-json agent-tab argv...
	local name=$1 tabs=$2 agent_tab=$3; shift 3
	local -a argv=("$@")
	local count i tab label cwd args resp space='' terminal='' agent_terminal=''
	count=$(jq length <<<"$tabs")
	for ((i = 0; i < count; i++)); do
		tab=$(jq -r ".[$i].tab" <<<"$tabs"); label=$(jq -r ".[$i].label" <<<"$tabs"); cwd=$(jq -r ".[$i].cwd" <<<"$tabs")
		[[ -d $cwd ]] || cwd=$HOME
		if [[ $tab == "$agent_tab" ]]; then
			args=$(jq -cn --arg tab "$label" --arg folder "$cwd" --args '{tab:$tab, folder:$folder, argv:$ARGS.positional, focus:false}' -- "${argv[@]}")
		else
			args=$(jq -cn --arg tab "$label" --arg folder "$cwd" '{tab:$tab, folder:$folder, focus:false}')
		fi
		if [[ -z $space ]]; then
			resp=$("$HERDR_APP" do space.new "$(jq -c --arg s "$name" '{name:$s} + .' <<<"$args")" 2>&1)
			space=$(jq -r '.space // empty' <<<"$resp" 2>/dev/null)
			[[ -n $space ]] || { say "space.new failed for '$name': $resp"; return 1; }
		else
			resp=$("$HERDR_APP" do tab.new "$(jq -c --arg s "$space" '{space:$s, name:.tab} + (. | del(.tab))' <<<"$args")" 2>&1)
		fi
		terminal=$(jq -r '.terminal // empty' <<<"$resp" 2>/dev/null)
		[[ -n $terminal ]] || { say "could not create tab '$label' in space '$name': $resp"; return 1; }
		[[ $tab == "$agent_tab" ]] && agent_terminal=$terminal
	done
	printf '%s\n' "$agent_terminal"
}

# An agentless workspace becomes a space of shells, so open work keeps its place.
move_workspace() { # workspace
	local w=$1 label tabs
	"$HERDR" agent list 2>/dev/null | jq -e --arg w "$w" '[.result.agents[] | select(.workspace_id == $w)] | length == 0' >/dev/null ||
		{ say "$w: workspace has a live agent; move its pane instead"; return 1; }
	label=$(workspace_label "$w")
	[[ -n $label ]] || { say "$w: no such workspace"; return 1; }
	tabs=$(workspace_tabs "$w") && [[ $(jq length <<<"$tabs") -gt 0 ]] || { say "$w: cannot read its tabs"; return 1; }
	space_exists "$label" && { say "$w: a space named '$label' already exists; skipped"; return 1; }
	jq -cn --arg w "$w" --arg name "$label" --argjson tabs "$tabs" '{workspace:$w, space:$name, tabs:$tabs}'
	((DRY_RUN)) && return 0
	recreate_space "$label" "$tabs" '' >/dev/null || return 1
	log_event --arg step space-created --arg workspace "$w" --arg space "$label" --argjson tabs "$tabs"
	printf 'recreated workspace %s as space %s\n' "$w" "$label"
}

move_one() { # pane
	local pane=$1 agents entry backend status cwd hname recorded pid start
	local -a argv=() fds=() newargv=()
	agents=$("$HERDR" agent list 2>/dev/null) || { say "$pane: cannot list Herdr agents"; return 1; }
	entry=$(jq -c --arg p "$pane" '.result.agents[] | select(.pane_id == $p)' <<<"$agents")
	[[ -n $entry ]] || { say "$pane: no agent in that pane"; return 1; }
	[[ $pane != "${HERDR_PANE_ID:-}" ]] || ((HANDOFF)) || { say "$pane: refusing to move the pane running this command"; return 1; }
	backend=$(jq -r '.agent // ""' <<<"$entry")
	status=$(jq -r '.agent_status // ""' <<<"$entry")
	cwd=$(jq -r '.cwd // ""' <<<"$entry")
	hname=$(jq -r '.name // ""' <<<"$entry")
	recorded=$(jq -r --arg b "$backend" 'if .agent_session.agent == $b then .agent_session.value // "" else "" end' <<<"$entry")
	[[ -n $(exit_command "$backend") ]] || { say "$pane: unsupported backend '$backend'"; return 1; }
	[[ $status == idle || $status == done ]] || [[ $WAIT != 0 ]] || { say "$pane: agent is $status, not idle; skipped"; return 1; }
	[[ -d $cwd ]] || { say "$pane: working directory '$cwd' is missing"; return 1; }

	local info procs
	info=$("$HERDR" pane process-info --pane "$pane" 2>/dev/null) || { say "$pane: no process information"; return 1; }
	procs=$(jq -c --arg b "$backend" '[.result.process_info.foreground_processes[] | select((.argv[0] // "") | split("/") | last == $b)]' <<<"$info")
	[[ $(jq length <<<"$procs") == 1 ]] || { say "$pane: expected exactly one '$backend' process"; return 1; }
	pid=$(jq -r '.[0].pid' <<<"$procs")
	mapfile -t argv < <(jq -r '.[0].argv[]' <<<"$procs")
	start=$(start_identity "$pid")
	[[ -n $start ]] || { say "$pane: process $pid is not readable"; return 1; }

	# Session evidence, strongest first: the open session file, Herdr's record, then argv.
	mapfile -t fds < <(fd_session "$backend" "$pid")
	((${#fds[@]} <= 1)) || { say "$pane: the process holds several sessions open (${fds[*]}); skipped"; return 1; }
	local strong=${fds[0]:-} from=fd
	if [[ -n $recorded ]]; then
		if [[ -z $strong ]]; then strong=$recorded from=herdr
		elif [[ $strong != "$recorded" ]]; then say "$pane: open session $strong but Herdr recorded $recorded; skipped"; return 1; fi
	fi
	local weak session
	weak=$(argv_session "$backend" "${argv[@]}")
	if [[ -n $strong ]]; then
		[[ -z $SESSION_OVERRIDE || $SESSION_OVERRIDE == "$strong" ]] || { say "$pane: --session $SESSION_OVERRIDE conflicts with $from evidence $strong"; return 1; }
		session=$strong
	elif [[ -n $SESSION_OVERRIDE ]]; then session=$SESSION_OVERRIDE from=override
	elif [[ -n $weak ]]; then session=$weak from=argv
	else say "$pane: no exact session ID for this $backend agent; pass --session ID"; return 1; fi
	[[ $session =~ ^[A-Za-z0-9_-]+$ ]] || { say "$pane: invalid session ID '$session'"; return 1; }

	local wid wlabel='' tabs='[]' agent_tab
	wid=$(jq -r '.workspace_id // ""' <<<"$entry")
	agent_tab=$(jq -r '.tab_id // ""' <<<"$entry")
	if ((APP_MODE)); then
		wlabel=$(workspace_label "$wid")
		[[ -n $wlabel ]] || { say "$pane: cannot find its workspace '$wid'"; return 1; }
		tabs=$(workspace_tabs "$wid") || { say "$pane: cannot read the workspace's tabs"; return 1; }
		jq -e --arg t "$agent_tab" 'any(.[]; .tab == $t)' <<<"$tabs" >/dev/null || { say "$pane: its tab is not in the workspace"; return 1; }
		space_exists "$wlabel" && { say "$pane: a space named '$wlabel' already exists; skipped"; return 1; }
	fi

	local name live
	name=$(hc_name "${NAME_OVERRIDE:-${hname:-${cwd##*/}}}")
	live=$("$HC" ls --json 2>/dev/null) || { say "herdr-core is not answering (hc ls)"; return 1; }
	if jq -e --arg s "$session" '[(.terminals // .)[]? | select(.labels.session == $s)] | length > 0' <<<"$live" >/dev/null; then
		say "$pane: session $session already runs under herdr-core; skipped"; return 1
	fi
	if ((!APP_MODE)) && jq -e --arg n "$name" '[(.terminals // .)[]? | select(.name == $n)] | length > 0' <<<"$live" >/dev/null; then
		say "$pane: herdr-core already has a terminal named '$name'; pass --name"; return 1
	fi
	mapfile -d '' -t newargv < <(resume_argv "$backend" "$session" "${argv[@]}")

	local plan
	plan=$(jq -cn --arg pane "$pane" --arg backend "$backend" --arg session "$session" --arg from "$from" \
		--arg weak "$weak" --arg cwd "$cwd" --arg name "$name" --argjson pid "$pid" --arg start "$start" \
		--arg space "$wlabel" --argjson tabs "$tabs" \
		--args '{pane:$pane, backend:$backend, session:$session, evidence:$from, argv_session:$weak,
			cwd:$cwd, name:$name, pid:$pid, start:$start, new_argv:$ARGS.positional}
			+ (if $space != "" then {space:$space, tabs:$tabs} else {} end)' -- "${newargv[@]}")
	printf '%s\n' "$plan"
	((DRY_RUN)) && return 0

	# With --wait, poll until the agent is idle at an empty prompt (a self-handoff waits for
	# its own turn to end); the checks below then confirm it again before typing.
	local first second verdict
	if [[ $WAIT != 0 ]]; then
		local idle_by
		idle_by=$(deadline "$WAIT")
		while :; do
			status=$("$HERDR" agent list 2>/dev/null | jq -r --arg p "$pane" '.result.agents[] | select(.pane_id == $p) | .agent_status')
			if [[ $status == idle || $status == done ]]; then
				first=$(screen "$pane"); sleep "$POLL"; second=$(screen "$pane")
				verdict=$(composer "$backend" <<<"$second")
				[[ -n $first && $first == "$second" && ${verdict%%$'\t'*} == empty ]] && break
			fi
			if past "$idle_by"; then
				say "$pane: agent did not become idle at an empty prompt within ${WAIT}s; skipped"; return 1
			fi
			sleep "$POLL"
		done
	fi
	# Two identical ANSI snapshots with an empty composer, then type the exit command.
	first=$(screen "$pane"); sleep "$POLL"; second=$(screen "$pane")
	verdict=$(composer "$backend" <<<"$second")
	[[ -n $first && $first == "$second" && ${verdict%%$'\t'*} == empty ]] || {
		say "$pane: prompt is not a stable empty composer (${verdict%%$'\t'*}); skipped"; return 1; }
	status=$("$HERDR" agent list 2>/dev/null | jq -r --arg p "$pane" '.result.agents[] | select(.pane_id == $p) | .agent_status')
	[[ $status == idle || $status == done ]] || { say "$pane: agent became $status; skipped"; return 1; }
	local cmd
	cmd=$(exit_command "$backend")
	log_event --arg step exiting --argjson plan "$plan" --argjson argv "$(jq -cn '$ARGS.positional' --args -- "${argv[@]}")"
	"$HERDR" pane send-text "$pane" "$cmd" >/dev/null || { say "$pane: could not type the exit command"; return 1; }
	local i typed=''
	for ((i = 0; i < 6; i++)); do
		sleep "$POLL"
		typed=$(screen "$pane" | composer "$backend")
		[[ $typed == "draft"$'\t'"$cmd" ]] && break
	done
	if [[ $typed != "draft"$'\t'"$cmd" ]]; then
		log_event --arg step aborted --arg pane "$pane" --arg reason "typed command not confirmed: $typed"
		say "$pane: typed '$cmd' but the composer shows '$typed'; left for you to inspect"; return 1
	fi
	"$HERDR" pane send-keys "$pane" enter >/dev/null || { say "$pane: could not press enter"; return 1; }
	local exit_by answered=0 shown jobs
	exit_by=$(deadline "$EXIT_TIMEOUT")
	while alive "$pid" "$start"; do
		# Claude asks before stopping background work; answer only its known dialog.
		shown=$("$HERDR" pane read "$pane" --source visible 2>/dev/null)
		if ((!answered)) && grep -q 'Background work is running' <<<"$shown" && grep -q '❯ 1\. Exit and stop tasks' <<<"$shown"; then
			jobs=$(sed -n '/will stop when you exit:/,/1\. Exit and stop tasks/p' <<<"$shown" | sed '1d;$d' | sed 's/^ *//' | grep -v '^$')
			if ((STOP_BACKGROUND)); then
				log_event --arg step stop-background --arg pane "$pane" --argjson pid "$pid" --arg jobs "$jobs"
				"$HERDR" pane send-keys "$pane" enter >/dev/null; answered=1
			else
				"$HERDR" pane send-keys "$pane" esc >/dev/null
				log_event --arg step background-kept --arg pane "$pane" --arg jobs "$jobs"
				say "$pane: $backend has background work running ($(tr '\n' ';' <<<"$jobs")); left running. Rerun with --stop-background to stop it."
				return 1
			fi
		fi
		if past "$exit_by"; then
			log_event --arg step exit-timeout --arg pane "$pane" --argjson pid "$pid"
			say "$pane: $backend (pid $pid) did not exit within ${EXIT_TIMEOUT}s; nothing started"; return 1
		fi
		sleep "$POLL"
	done
	log_event --arg step exited --arg pane "$pane" --argjson pid "$pid"

	local started address
	if ((APP_MODE)); then
		# The app starts the agent in its space; labels then identify it to scripts.
		address=$(recreate_space "$wlabel" "$tabs" "$agent_tab" "${newargv[@]}") && [[ -n $address ]] || {
			log_event --arg step start-failed --arg pane "$pane" --arg output "space $wlabel"
			say "$pane: could not recreate space '$wlabel'; the agent is not running, resume: ${newargv[*]}"; return 1; }
		"$HC" label "$address" "project=${cwd##*/}" "backend=$backend" "session=$session" migrated-from=herdr-tui >/dev/null ||
			say "$pane: started $address but could not label it"
		name=$wlabel
	else
		started=$("$HC" run --json --bg --no-parent --name "$name" --cwd "$cwd" --label "project=${cwd##*/}" \
			--label "backend=$backend" --label "session=$session" --label migrated-from=herdr-tui -- "${newargv[@]}" 2>&1)
		address=$(jq -r '.address // empty' <<<"$started" 2>/dev/null)
		if [[ -z $address ]]; then
			log_event --arg step start-failed --arg pane "$pane" --arg output "$started"
			say "$pane: hc run failed: $started"; return 1
		fi
	fi
	log_event --arg step started --arg pane "$pane" --arg address "$address" --arg name "$name" --arg session "$session"
	printf 'moved %s (%s %s) to herdr-core %s as %s\n' "$pane" "$backend" "$session" "$address" "$name"
}

DRY_RUN=0 APP_MODE=0 HANDOFF=0 WAIT=0 STOP_BACKGROUND=0 SESSION_OVERRIDE='' NAME_OVERRIDE=''
panes=() workspaces=()
while (($#)); do
	case $1 in
		--dry-run) DRY_RUN=1 ;;
		--app) APP_MODE=1 ;;
		--handoff) HANDOFF=1 ;;
		--stop-background) STOP_BACKGROUND=1 ;;
		--wait) WAIT=${2:-}; shift; [[ $WAIT =~ ^[0-9]+([.][0-9]+)?$ ]] || { say "--wait needs seconds"; exit 2; } ;;
		--workspace) workspaces+=("${2:-}"); shift ;;
		--session) SESSION_OVERRIDE=${2:-}; shift ;;
		--name) NAME_OVERRIDE=${2:-}; shift ;;
		-h | --help) usage; exit 0 ;;
		-*) say "unknown option $1"; usage >&2; exit 2 ;;
		*) panes+=("$1") ;;
	esac
	shift
done
((${#panes[@]} + ${#workspaces[@]})) || { usage >&2; exit 2; }
((${#workspaces[@]} == 0 || APP_MODE)) || { say "--workspace needs --app"; exit 2; }
if [[ -n $SESSION_OVERRIDE$NAME_OVERRIDE ]] && ((${#panes[@]} > 1)); then
	say "--session and --name apply to one pane at a time"; exit 2
fi
failed=0
for pane in "${panes[@]}"; do move_one "$pane" || failed=1; done
for w in "${workspaces[@]}"; do move_workspace "$w" || failed=1; done
exit "$failed"
