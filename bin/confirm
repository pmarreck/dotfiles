#!/usr/bin/env bash

_confirm_help() {
	cat <<'EOF'
Usage: confirm
       confirm -- COMMAND [ARG...]

Buffer all stdin, display it for review, and emit it only after explicit
approval. The prompt is "Pass the complete buffered input? [y/N]"; only y or
yes approves. Denial, an empty response, EOF, interruption, and empty input
emit zero stdout bytes.

Examples:
  printf '%s\n' 'some code' | confirm | ssh user@host
  confirm -- curl --fail --show-error --silent URL | bash

Use pipefail when the pipeline's exit status matters. Command mode also
observes the producer's status and refuses any partial output from a failed
producer. A plain byte-stream pipeline cannot communicate that status.
EOF
}

# A subshell contains traps and file descriptors when the file is sourced.
confirm() (
	local tmpfile="" response="" producer_status=0 producer_mode=0

	case "${1:-}" in
		-h|--help)
			_confirm_help
			return 0
			;;
		--about)
			printf 'confirm - buffer piped input and release it only after explicit approval\n'
			return 0
			;;
		--)
			shift
			[ "$#" -gt 0 ] || {
				printf 'confirm: -- requires a producer command\n' >&2
				return 64
			}
			producer_mode=1
			;;
		'') ;;
		*)
			printf 'confirm: unexpected argument: %s\n' "$1" >&2
			return 64
			;;
	esac
	tmpfile="$(mktemp "${TMPDIR:-/tmp}/confirm.XXXXXX")" || {
		printf 'confirm: cannot create temporary buffer\n' >&2
		return 74
	}
	trap 'rm -f -- "$tmpfile"' EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM

	if [ "$producer_mode" = 1 ]; then
		"$@" > "$tmpfile"
		producer_status=$?
		if [ "$producer_status" != 0 ]; then
			printf 'confirm: producer failed with status %s; buffered output refused\n' "$producer_status" >&2
			return "$producer_status"
		fi
	else
		if ! cat > "$tmpfile"; then
			printf 'confirm: could not buffer complete input\n' >&2
			return 74
		fi
	fi
	if [ ! -s "$tmpfile" ]; then
		printf 'confirm: empty input; nothing can be approved\n' >&2
		return 65
	fi
	if ! cat -- "$tmpfile" >&2; then
		printf 'confirm: could not display buffered input\n' >&2
		return 74
	fi
	printf '\n' >&2

	if ! exec 3<> /dev/tty; then
		printf 'confirm: no controlling terminal for approval\n' >&2
		return 69
	fi
	printf 'Pass the complete buffered input? [y/N] ' >&3
	if ! IFS= read -r response <&3; then
		printf 'confirm: approval input ended; cancelled\n' >&2
		return 1
	fi
	case "$response" in
		[yY]|[yY][eE][sS])
			if ! cat -- "$tmpfile"; then
				printf 'confirm: could not emit approved input\n' >&2
				return 74
			fi
			;;
		*)
			printf 'confirm: cancelled\n' >&2
			return 1
			;;
	esac
)

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	confirm "$@"
fi
